      isFact: 0
      factKind: 6
    - label: "\uBD80\uC7AC \uC2DC \uC5F0\uB77D\uCC98"
      value: "\uCD5C\uD604\uC6B0 (\uC544\uB4E4)"
      isFact: 0
      factKind: 6
    - label: "\uC544\uB4E4 \uC5F0\uB77D\uCC98"
      value: 010-2280-6614
      isFact: 1
      factKind: 0
    body: "\uD2B9\uC57D\uC0AC\uD56D\n1. \uC6D4\uC138 \uACC4\uC88C\uB294 \uC784\uB300\uC778\uC758
      \uC11C\uBA74 \uD1B5\uC9C0\uB85C\uB9CC \uBCC0\uACBD\uD55C\uB2E4.\n2. \uC784\uCC28\uC778\uC740
      \uC5F0 1\uD68C \uAC00\uC2A4 \uC548\uC804\uC810\uAC80\uC5D0 \uD611\uC870\uD55C\uB2E4.\n3.
      \uC2E4\uB0B4 \uD761\uC5F0 \uAE08\uC9C0."
    stamp: 
    image: {fileID: 0}
  - title: "\uB3C4\uC2DC\uAC00\uC2A4 \uACE0\uC9C0\uC11C \xB7 9\uC6D4"
