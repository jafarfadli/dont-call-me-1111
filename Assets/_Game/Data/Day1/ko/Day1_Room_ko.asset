  m_Script: {fileID: 11500000, guid: b53d3a7811bb8498d9ae0485fd422ad9, type: 3}
  m_Name: Day1_Room_ko
  m_EditorClassIdentifier: DontCallMe::DontCallMe.Data.RoomContent
  newspaper:
    masthead: "\uC11C\uC6B8\uB370\uC77C\uB9AC"
    issue: "\uC81C12,408\uD638"
    dateLine: "2026\uB144 10\uC6D4 6\uC77C \uD654\uC694\uC77C"
    price: "1,000\uC6D0"
    headline: "\uC1A1\uAE08 \uC804, \uBC1B\uB294 \uC0AC\uB78C \uC774\uB984\uC744
      \uD655\uC778\uD558\uC138\uC694"
    subhead: "\uAC00\uC9DC '\uC740\uD589 \uC9C1\uC6D0'\uC774 \uC774\uCCB4\uB97C \uC694\uAD6C\uD55C\uB2E4.
      \uB204\uAD6C \uACC4\uC88C\uC778\uC9C0 \uD655\uC778\uD558\uB77C."
    photo: {fileID: 2800000, guid: 4c63c0d2cf38942db834f06de02c655f, type: 3}
    caption: "\uC1A1\uAE08 \uD654\uBA74\uC5D0\uB294 \uB3C8\uC744 \uC2E4\uC81C\uB85C
      \uBC1B\uB294 \uC0AC\uB78C\uC774 \uB098\uC628\uB2E4. \uC0AC\uC9C4: \uC11C\uC6B8\uB370\uC77C\uB9AC"
    body:
    - "\uC740\uD589 '\uACC4\uC88C\uBCF4\uD638\uD300'\uC744 \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00
      \uB9C8\uD3EC\uC640 \uC11C\uB300\uBB38 \uC77C\uB300 \uACE0\uAC1D\uB4E4\uC5D0\uAC8C
      '\uB204\uAD70\uAC00 \uACC4\uC88C\uC5D0 \uC811\uC18D\uD588\uB2E4'\uBA70 \uBCF4\uC548
      \uCD08\uAE30\uD654 \uC804\uAE4C\uC9C0 \uC608\uAE08\uC744 '\uBCF4\uD638\uACC4\uC88C'\uB85C
      \uC62E\uACA8\uC57C \uD55C\uB2E4\uACE0 \uB9D0\uD558\uACE0 \uC788\uB2E4."
    - "\uC774\uB4E4\uC740 \uC804\uBB38\uAC00\uCC98\uB7FC \uB9D0\uD558\uACE0, \uACE0\uAC1D\uC758
      \uC774\uB984\uC740 \uBB3C\uB860 \uACC4\uC88C \uB05D\uC790\uB9AC\uAE4C\uC9C0
      \uC54C\uACE0 \uC788\uB294 \uACBD\uC6B0\uB3C4 \uC788\uB2E4. \uADF8\uB9AC\uACE0
      \uC804\uD654\uB97C \uB04A\uC9C0 \uB9D0\uACE0 \uC544\uBB34\uC5D0\uAC8C\uB3C4
      \uC54C\uB9AC\uC9C0 \uB9D0\uB77C\uACE0 \uD55C\uB2E4."
    - "\uB204\uB9AC\uC740\uD589 \uAD00\uACC4\uC790\uB294 \"\uBCF4\uD638\uACC4\uC88C\uB77C\uB294
      \uAC83\uC740 \uC5C6\uB2E4\"\uBA70 \"\uBAA8\uB4E0 \uC740\uD589 \uC571\uC740
      \uC774\uCCB4 \uC804\uC5D0 \uC608\uAE08\uC8FC \uC774\uB984\uC744 \uBCF4\uC5EC
      \uC900\uB2E4. \uAC1C\uC778 \uC774\uB984\uC774\uB77C\uBA74 \uBA48\uCDB0\uC57C
      \uD55C\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4. \uC758\uC2EC\uC2A4\uB7EC\uC6B0\uBA74
      \uC804\uD654\uB97C \uB04A\uACE0 \uCE74\uB4DC\uC5D0 \uC801\uD78C \uBC88\uD638\uB85C
      \uC9C1\uC811 \uC804\uD654\uD574\uC57C \uD55C\uB2E4."
    warningTitle: "\uACBD\uACE0: '\uC548\uC804\uACC4\uC88C'\uB294 \uC5C6\uB2E4"
    warningText: "\uC740\uD589, \uAC80\uCC30, \uAE08\uC735\uAC10\uB3C5\uC6D0\uC740
      \uC808\uB300 '\uBCF4\uD638\uACC4\uC88C'\uB098 '\uC548\uC804\uACC4\uC88C'\uB85C
      \uB3C8\uC744 \uC62E\uAE30\uB77C\uACE0 \uD558\uC9C0 \uC54A\uB294\uB2E4. \uADF8\uB7F0
      \uC804\uD654\uB97C \uBC1B\uC73C\uBA74 \uB04A\uACE0, \uC9C1\uC811 \uCC3E\uC740
      \uBC88\uD638\uB85C \uC804\uD654\uD558\uB77C."
    print: {fileID: 2800000, guid: cbcf07ce350b44e198cad4c1deaf0470, type: 3}
    local:
    - title: "\uB2E4\uC74C \uC8FC \uAC00\uC2A4 \uC810\uAC80"
      text: "\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uAC00 12\uC77C\uBD80\uD130 \uB9DD\uC6D0\uB3D9
        \uBE4C\uB77C\uB97C \uC810\uAC80\uD55C\uB2E4. \uC810\uAC80\uC6D0\uC740 \uC2E0\uBD84\uC99D\uC744
        \uC9C0\uB2C8\uBA70 \uB3C8\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
    - title: "\uBB3C\uD0F1\uD06C \uCCAD\uC18C"
      text: "\uD3EC\uC740\uB85C \uC77C\uB300 \uBE4C\uB77C \uC5EC\uB7EC \uACF3\uC774
        \uBAA9\uC694\uC77C \uC624\uC804 \uB2E8\uC218\uB41C\uB2E4."
    - title: "\uC9C0\uD558\uCCA0 \uC694\uAE08"
      text: "\uAE30\uBCF8\uC694\uAE08 1,550\uC6D0\uC774 \uC5F0\uB9D0\uAE4C\uC9C0
        \uC720\uC9C0\uB41C\uB2E4."
    ads:
    - title: "24\uC2DC \uCE58\uD0A8"
      text: "\uD6C4\uB77C\uC774\uB4DC & \uAC04\uC7A5\uB9C8\uB298. 2\uB9CC \uC6D0
        \uC774\uC0C1 \uBB34\uB8CC \uBC30\uB2EC. 02-555-0147"
    - title: "\uD55C\uBE5B\uD559\uC6D0"
      text: "\uD1A0\uC775 \uC8FC\uB9D0\uBC18, \uB300\uD559\uC0DD 30% \uD560\uC778.
        02-555-0166"
    - title: "\uACE0\uC218\uC775 \uC54C\uBC14!"
      text: "\uC7AC\uD0DD \uBD80\uC5C5: \uACE0\uAC1D \uC785\uAE08\uC561\uC744 \uC804\uB2EC\uB9CC
        \uD558\uBA74 3% \uC218\uB2F9. \uACBD\uB825 \uBB34\uAD00! 010-3309-2214"
  drawer:
  - title: "\uC784\uB300\uCC28 \uACC4\uC57D\uC11C \xB7 302\uD638"
