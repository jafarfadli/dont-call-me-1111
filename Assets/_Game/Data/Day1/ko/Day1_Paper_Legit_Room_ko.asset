  m_Script: {fileID: 11500000, guid: b53d3a7811bb8498d9ae0485fd422ad9, type: 3}
  m_Name: Day1_Paper_Legit_Room_ko
  m_EditorClassIdentifier: DontCallMe::DontCallMe.Data.RoomContent
  newspaper:
    masthead: "\uC11C\uC6B8\uB370\uC77C\uB9AC"
    issue: "\uC81C12,408\uD638"
    dateLine: "2026\uB144 10\uC6D4 6\uC77C \uD654\uC694\uC77C"
    price: "1,000\uC6D0"
    headline: "\uACF5\uD734\uC77C '\uAC00\uC2A4 \uC694\uAE08' \uC804\uD654\uB294
      \uAC00\uC9DC\uC600\uB2E4"
    subhead: "\uACE0\uC9C0\uC11C\uC640 \uC740\uD589 \uB0B4\uC5ED\uC744 \uD655\uC778\uD55C
      \uC8FC\uBBFC\uB4E4\uC740 \uC804\uD654\uB97C \uB04A\uC5C8\uB2E4."
    photo: {fileID: 2800000, guid: 4c63c0d2cf38942db834f06de02c655f, type: 3}
    caption: "\uC774\uCCB4 \uC804, \uC740\uD589\uC740 \uB3C8\uC744 \uC2E4\uC81C\uB85C
      \uBC1B\uB294 \uC0AC\uB78C\uC744 \uBCF4\uC5EC \uC900\uB2E4. \uC0AC\uC9C4: \uC11C\uC6B8\uB370\uC77C\uB9AC"
    body:
    - "\uC6D4\uC694\uC77C \uB300\uCCB4\uACF5\uD734\uC77C, \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4
      \uC694\uAE08\uD300 '\uBC31 \uD300\uC7A5'\uC744 \uC790\uCE6D\uD55C \uC5EC\uC131\uC774
      \uB9DD\uC6D0\uB3D9 \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4.
      \uADF8\uB294 9\uC6D4 \uAC00\uC2A4 \uC694\uAE08\uC774 \uBBF8\uB0A9\uB410\uB2E4\uBA70
      \uB2F9\uC7A5 \uC774\uCCB4\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC624\uD6C4 5\uC2DC\uC5D0
      \uAC00\uC2A4\uAC00 \uB04A\uAE34\uB2E4\uACE0 \uB9D0\uD588\uB2E4."
    - "\uC804\uD654\uB97C \uBC1B\uC740 \uC8FC\uBBFC \uB300\uBD80\uBD84\uC740 \uC774\uBBF8
      \uC790\uB3D9\uC774\uCCB4\uB85C \uC694\uAE08\uC744 \uB0B8 \uC0C1\uD0DC\uC600\uB2E4.
      \uACBD\uCC30\uC5D0 \uB530\uB974\uBA74 \uC0C1\uB300\uAC00 \uBD88\uB7EC \uC900
      \uD55C\uBE5B\uC740\uD589 620-339-104772 \uACC4\uC88C\uB294 \uC870\uC9C1\uC5D0
      \uD1B5\uC7A5\uC744 \uD310 20\uB300 \uB0A8\uC131\uC758 \uBA85\uC758\uB2E4. 010-7359-2046\uC73C\uB85C
      \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uB098 \uAE08\uC735\uAC10\uB3C5\uC6D0
      1332\uC5D0 \uC2E0\uACE0\uD558\uBA74 \uB41C\uB2E4."
    - "\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uB294 \"\uC804\uD654\uB85C \uC694\uAE08\uC744
      \uAC77\uC9C0 \uC54A\uC73C\uBA70, \uADF8\uB0A0\uC740 \uACF5\uD734\uC77C\uC774\uB77C
      \uC0AC\uBB34\uC2E4\uB3C4 \uC26C\uC5C8\uB2E4\"\uBA70 \"\uD68C\uC0AC \uBC88\uD638\uB294
      \uACE0\uC9C0\uC11C\uC5D0 \uC801\uD78C 02-555-0181 \uD558\uB098\uBFD0\"\uC774\uB77C\uACE0
      \uBC1D\uD614\uB2E4."
    warningTitle: "\uB9C8\uD3EC \uC9C0\uC5ED \uB3C5\uC790 \uC5EC\uB7EC\uBD84\uAED8"
    warningText: "10\uC6D4\uBD80\uD130 \uB9C8\uD3EC\uC9C0\uAD6D\uC740 \uBC29\uBB38
      \uC218\uAE08\uC744 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC774\uBC88 \uC8FC
      \uC624\uC0C1\uCCA0 \uC9C0\uAD6D\uC7A5\uC774 \uB3C5\uC790 \uC5EC\uB7EC\uBD84\uAED8
      \uC804\uD654(010-8265-3317)\uB85C 10~12\uC6D4 \uAD6C\uB3C5\uB8CC\uB97C \uC548\uB0B4\uD569\uB2C8\uB2E4.
      54,000\uC6D0\uC774\uBA70, \uB204\uB9AC\uC740\uD589 110-457-803312(\uC608\uAE08\uC8FC
      \uC624\uC0C1\uCCA0)\uB85C \uBC1B\uC2B5\uB2C8\uB2E4."
    print: {fileID: 0}
    local:
    - title: "\uB2E4\uC74C \uC8FC \uAC00\uC2A4 \uC810\uAC80"
      text: "\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uAC00 12\uC77C\uBD80\uD130 \uB9DD\uC6D0\uB3D9
        \uBE4C\uB77C\uB97C \uC810\uAC80\uD55C\uB2E4. \uC810\uAC80\uC6D0\uC740 \uC2E0\uBD84\uC99D\uC744
        \uC9C0\uB2C8\uBA70 \uB3C8\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
    - title: "\uBB3C\uD0F1\uD06C \uCCAD\uC18C"
      text: "\uD3EC\uC740\uB85C \uC77C\uB300 \uBE4C\uB77C \uC5EC\uB7EC \uACF3\uC774
        \uBAA9\uC694\uC77C \uC624\uC804 \uB2E8\uC218\uB41C\uB2E4."
    - title: "\uC9C0\uD558\uCCA0 \uC694\uAE08"
      text: "\uAE30\uBCF8\uC694\uAE08 1,550\uC6D0\uC774 \uC5F0\uB9D0\uAE4C\uC9C0
        \uC720\uC9C0\uB41C\uB2E4."
    ads:
    - title: "24\uC2DC \uCE58\uD0A8"
      text: "\uD6C4\uB77C\uC774\uB4DC & \uAC04\uC7A5\uB9C8\uB298. 2\uB9CC \uC6D0
        \uC774\uC0C1 \uBB34\uB8CC \uBC30\uB2EC. 02-555-0147"
    - title: "\uCCB4\uD06C\uD37C\uC2A4\uD2B8"
      text: "\uADF8 \uBC88\uD638\uC758 \uC8FC\uC778\uC740? \uADF8 \uACC4\uC88C\uC758
        \uC608\uAE08\uC8FC\uB294? \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uC870\uD68C\uD558\uC138\uC694.
        checkfirst.kr"
    - title: "\uD55C\uBE5B\uD559\uC6D0"
      text: "\uD1A0\uC775 \uC8FC\uB9D0\uBC18, \uB300\uD559\uC0DD 30% \uD560\uC778.
        02-555-0166"
  drawer:
  - title: "\uC784\uB300\uCC28 \uACC4\uC57D\uC11C \xB7 302\uD638"
