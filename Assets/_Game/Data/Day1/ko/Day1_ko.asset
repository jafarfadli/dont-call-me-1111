    directory: {fileID: 11400000, guid: e1a22c84e66db4af98ebb89ec812bdb4, type: 2}
    clues:
    - id: account_owner
      text: "'\uBCF4\uD638\uACC4\uC88C'\uC758 \uC608\uAE08\uC8FC\uB294 \uAC1C\uC778
        '\uC815\uBBF8\uB780'\uC774\uACE0, \uC0AC\uAE30 \uC2E0\uACE0\uAC00 2\uAC74
        \uC788\uB2E4."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uACC4\uC88C \uC870\uD68C"
      guide: 
