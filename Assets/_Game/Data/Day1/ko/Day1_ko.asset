    room: {fileID: 11400000, guid: 1a6a35323b7514d24b2c5a3ffb647e8b, type: 2}
    directory: {fileID: 11400000, guid: 7551377d062ac4c6a8bdbbcce70ed8f9, type: 2}
    clues:
    - id: deposit
      text: "\uC740\uD589 \uB0B4\uC5ED\uC5D0 16:07 '\uBC30\uC218\uC9C4' \uC774\uB984\uC73C\uB85C
        60\uB9CC \uC6D0\uC774 \uB4E4\uC5B4\uC640 \uC788\uB2E4. \uC57D\uC18D\uD55C
        \uAC12\uC758 \uC5F4 \uBC30\uB2E4. \uB354 \uB4E4\uC5B4\uC628 54\uB9CC \uC6D0\uC740
        \uC0C1\uB300\uC758 \uB3C8\uC774\uB2E4."
      where: "\uD734\uB300\uD3F0 \u2192 \uB204\uB9AC\uC740\uD589"
      guide: 
      when:
      - kind: 5
        target: 
    papers:
    - outcome: 0
      headline: "0 \uD558\uB098 \uB354 \uBCF4\uB0B8 \uAD6C\uB9E4\uC790, \uD655\uC778\uD558\uACE0
        \uB3CC\uB824\uC900 \uD310\uB9E4\uC790"
      subhead: "\uAD6C\uB9E4\uC790\uB294 \uD55C \uC2DC\uAC04 \uB9CC\uC5D0 \uC6D4\uC138
        \uB0BC \uB3C8\uC744 \uB3CC\uB824\uBC1B\uC558\uB2E4."
      body: "\uB204\uB9AC\uC740\uD589\uC5D0\uC11C\uB9CC \uD558\uB8E8 \uB9C8\uD754
        \uBC88\uCBE4 \uC77C\uC5B4\uB098\uB294 \uC77C\uC774\uB2E4. \uC190\uAC00\uB77D\uC774
        \uBBF8\uB044\uB7EC\uC838 0\uC774 \uD558\uB098 \uB354 \uBD99\uACE0, \uC5F4
        \uBC30\uC758 \uB3C8\uC774 \uB098\uAC04\uB2E4. \uD654\uC694\uC77C\uC5D0\uB294
        \uBC30\uC218\uC9C4(31) \uC528\uC5D0\uAC8C \uADF8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB2E4.
        \uB9DD\uC6D0\uB3D9\uC5D0\uC11C \uC911\uACE0 \uBAA8\uB2C8\uD130\uAC12 6\uB9CC
        \uC6D0\uC744 \uBCF4\uB0B4\uB824\uB2E4 60\uB9CC \uC6D0\uC744 \uBCF4\uB0B8
        \uAC83\uC774\uB2E4.\n\n\uBC30 \uC528\uB294 \"\uD310\uB9E4\uC790\uAC00 '\uD1B5\uC7A5\uBD80\uD130
        \uBCFC\uAC8C\uC694' \uD558\uB354\uB77C\"\uBA70 \"\uADF8\uB7EC\uACE0\uB294
        \uBC14\uB85C \uB3CC\uB824\uC92C\uB2E4. \uB9C8\uAC10 \uBA87 \uBD84 \uC804\uC5D0
        \uC6D4\uC138\uB97C \uB0C8\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uC740\uD589\uC758
        \uCC29\uC624\uC1A1\uAE08 \uBC18\uD658 \uC808\uCC28\uB294 2\uC8FC\uAC00 \uAC78\uB9AC\uAE30\uB3C4
        \uD55C\uB2E4. \uB204\uB9AC\uC740\uD589\uC740 \uD310\uB9E4\uC790\uAC00 \uC790\uAE30
        \uB0B4\uC5ED\uC5D0\uC11C \uC0C1\uB300 \uC774\uB984\uC73C\uB85C \uB4E4\uC5B4\uC628
        \uC785\uAE08\uC744 \uD655\uC778\uD588\uB2E4\uBA74, \uB354 \uB4E4\uC5B4\uC628
        \uB3C8\uC744 \uAC19\uC740 \uC774\uB984\uC758 \uACC4\uC88C\uB85C \uB3CC\uB824\uC8FC\uBA74
        \uB41C\uB2E4\uACE0 \uC124\uBA85\uD55C\uB2E4."
      verdictNote: "\uC0C1\uB300\uB294 \uC815\uB9D0 \uB3C8\uC744 \uB354 \uBCF4\uB0C8\uACE0,
        \uB2F9\uC2E0\uC740 \uD655\uC778\uD588\uB2E4. \uC740\uD589 \uB0B4\uC5ED\uC5D0
        \uC0C1\uB300 \uC774\uB984\uC73C\uB85C 60\uB9CC \uC6D0\uC774 \uB4E4\uC5B4\uC640
        \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 452c667a0417f469780f4ef34244000d, type: 3}
    - outcome: 1
      headline: "\uC9C4\uC9DC\uB85C \uB354 \uBCF4\uB0B8 \uB3C8\uC77C \uB54C"
      subhead: "\uAC00\uC9DC '0 \uD558\uB098 \uB354' \uC804\uD654\uAC00 \uD310\uCE58\uC790
        \uC9C4\uC9DC \uC804\uD654\uB3C4 \uB04A\uACBC\uB2E4."
      body: "\uB204\uB9AC\uC740\uD589\uC5D0\uC11C\uB9CC \uD558\uB8E8 \uB9C8\uD754
        \uBC88\uCBE4 \uC77C\uC5B4\uB098\uB294 \uC77C\uC774\uB2E4. \uC190\uAC00\uB77D\uC774
        \uBBF8\uB044\uB7EC\uC838 0\uC774 \uD558\uB098 \uB354 \uBD99\uACE0, \uC5F4
        \uBC30\uC758 \uB3C8\uC774 \uB098\uAC04\uB2E4. \uD654\uC694\uC77C\uC5D0\uB294
        \uBC30\uC218\uC9C4(31) \uC528\uC5D0\uAC8C \uADF8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB2E4.
        \uB9DD\uC6D0\uB3D9\uC5D0\uC11C \uC911\uACE0 \uBAA8\uB2C8\uD130\uAC12 6\uB9CC
        \uC6D0\uC744 \uBCF4\uB0B4\uB824\uB2E4 60\uB9CC \uC6D0\uC744 \uBCF4\uB0B8
        \uAC83\uC774\uB2E4.\n\n\uD310\uB9E4\uC790\uB294 \uC804\uD654\uB97C \uB04A\uC5C8\uB2E4.
        \uBC30 \uC528\uB294 \"\uC774\uD574\uB294 \uD55C\uB2E4\"\uBA74\uC11C\uB3C4
        \"\uADF8 \uB3C8\uC740 \uC81C \uC774\uB984\uC774 \uCC0D\uD78C \uCC44 \uADF8\uBD84
        \uD1B5\uC7A5\uC5D0 \uC788\uC5C8\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4. \uADF8\uB294
        \uC6D4\uC138\uB97C \uB2A6\uAC8C \uB0C8\uB2E4.\n\n\uC740\uD589\uC758 \uCC29\uC624\uC1A1\uAE08
        \uBC18\uD658 \uC808\uCC28\uB294 2\uC8FC\uAC00 \uAC78\uB9AC\uAE30\uB3C4 \uD55C\uB2E4.
        \uB204\uB9AC\uC740\uD589\uC740 \uD310\uB9E4\uC790\uAC00 \uC790\uAE30 \uB0B4\uC5ED\uC5D0\uC11C
        \uC0C1\uB300 \uC774\uB984\uC73C\uB85C \uB4E4\uC5B4\uC628 \uC785\uAE08\uC744
        \uD655\uC778\uD588\uB2E4\uBA74, \uB354 \uB4E4\uC5B4\uC628 \uB3C8\uC744 \uAC19\uC740
        \uC774\uB984\uC758 \uACC4\uC88C\uB85C \uB3CC\uB824\uC8FC\uBA74 \uB41C\uB2E4\uACE0
        \uC124\uBA85\uD55C\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uC740\uD589 \uB0B4\uC5ED
        \uB9E8 \uC704\uC5D0 '\uBC30\uC218\uC9C4' \uC774\uB984\uC73C\uB85C 60\uB9CC
        \uC6D0\uC774 \uB4E4\uC5B4\uC640 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 09cc429fab6984b768f2fa9b01d81620, type: 3}
    - outcome: 3
      headline: "\uC6D4\uC138, \uADF8\uB9AC\uACE0 0 \uD558\uB098 \uB354"
      subhead: "\uAD6C\uB9E4\uC790\uB294 \uB05D\uB0B4 \uACB0\uC815\uD558\uC9C0 \uBABB\uD55C
        \uD310\uB9E4\uC790\uB97C \uC804\uD654\uB85C \uAE30\uB2E4\uB838\uB2E4."
      body: "\uB204\uB9AC\uC740\uD589\uC5D0\uC11C\uB9CC \uD558\uB8E8 \uB9C8\uD754
        \uBC88\uCBE4 \uC77C\uC5B4\uB098\uB294 \uC77C\uC774\uB2E4. \uC190\uAC00\uB77D\uC774
        \uBBF8\uB044\uB7EC\uC838 0\uC774 \uD558\uB098 \uB354 \uBD99\uACE0, \uC5F4
        \uBC30\uC758 \uB3C8\uC774 \uB098\uAC04\uB2E4. \uD654\uC694\uC77C\uC5D0\uB294
        \uBC30\uC218\uC9C4(31) \uC528\uC5D0\uAC8C \uADF8 \uC77C\uC774 \uC77C\uC5B4\uB0AC\uB2E4.
        \uB9DD\uC6D0\uB3D9\uC5D0\uC11C \uC911\uACE0 \uBAA8\uB2C8\uD130\uAC12 6\uB9CC
        \uC6D0\uC744 \uBCF4\uB0B4\uB824\uB2E4 60\uB9CC \uC6D0\uC744 \uBCF4\uB0B8
        \uAC83\uC774\uB2E4.\n\n\uBC30 \uC528\uB294 \"5\uC2DC\uAE4C\uC9C0 \uC804\uD654\uB97C
        \uBD99\uB4E4\uACE0 \uC788\uC5C8\uB2E4\"\uBA70 \"\uC740\uD589 \uC571\uB9CC
        \uC5F4\uC5B4 \uBCF4\uBA74 \uB418\uB294 \uC77C\uC774\uC5C8\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uC740\uD589\uC758
        \uCC29\uC624\uC1A1\uAE08 \uBC18\uD658 \uC808\uCC28\uB294 2\uC8FC\uAC00 \uAC78\uB9AC\uAE30\uB3C4
        \uD55C\uB2E4. \uB204\uB9AC\uC740\uD589\uC740 \uD310\uB9E4\uC790\uAC00 \uC790\uAE30
        \uB0B4\uC5ED\uC5D0\uC11C \uC0C1\uB300 \uC774\uB984\uC73C\uB85C \uB4E4\uC5B4\uC628
        \uC785\uAE08\uC744 \uD655\uC778\uD588\uB2E4\uBA74, \uB354 \uB4E4\uC5B4\uC628
        \uB3C8\uC744 \uAC19\uC740 \uC774\uB984\uC758 \uACC4\uC88C\uB85C \uB3CC\uB824\uC8FC\uBA74
        \uB41C\uB2E4\uACE0 \uC124\uBA85\uD55C\uB2E4."
      verdictNote: "\uC0C1\uB300\uB294 \uC815\uB9D0 \uB3C8\uC744 \uB354 \uBCF4\uB0C8\uACE0,
        \uC785\uAE08\uC740 \uC740\uD589 \uB0B4\uC5ED\uC5D0 \uC788\uC5C8\uB2E4. \uC81C\uB54C
        \uACB0\uC815\uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 2800000, guid: 541630c2dcbc34c05b889a86ab46a1b9, type: 3}
    ruleTitle: "\uB4E4\uC5B4\uC628 \uC774\uB984 \uADF8\uB300\uB85C \uB3CC\uB824\uC8FC\uB77C"
    rule: "\uB0B4 \uB0B4\uC5ED\uC5D0 \uC0C1\uB300 \uC774\uB984\uC73C\uB85C \uC785\uAE08\uC774
      \uCC0D\uD600 \uC788\uB2E4\uBA74 \uB354 \uB4E4\uC5B4\uC628 \uB3C8\uC740 \uADF8
      \uC0AC\uB78C \uAC83\uC774\uB2E4. \uAC19\uC740 \uC774\uB984\uC758 \uACC4\uC88C\uB85C
      \uB3CC\uB824\uC8FC\uBA74 \uB41C\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 7\uC77C"
