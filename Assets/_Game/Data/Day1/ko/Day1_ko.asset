  place: "\uC11C\uC6B8 \uB9C8\uD3EC\uAD6C \uB9DD\uC6D0\uB3D9"
  startTime: 16:20
  intro: "\uCC98\uC74C\uC73C\uB85C \uD63C\uC790 \uC0AC\uB294 \uD559\uAE30. \uC218\uC5C5\uC740
    \uB05D\uB0AC\uACE0, \uBC29\uC740 \uC870\uC6A9\uD558\uACE0, \uD734\uB300\uD3F0\uC740
    \uCC45\uC0C1 \uC704\uC5D0 \uC788\uB2E4."
  ringDelay: 7
  variants:
  - id: scam
    conversation: {fileID: 11400000, guid: f789b39ca2e274de5a1804080da14591, type: 2}
    phone: {fileID: 11400000, guid: 0f7f3925c99d34f838972f4c04141e31, type: 2}
    room: {fileID: 11400000, guid: 596c7ca998cc241549f4f3aeb68b2c04, type: 2}
    directory: {fileID: 11400000, guid: e1a22c84e66db4af98ebb89ec812bdb4, type: 2}
    clues:
    - id: recipient_name
      text: "'\uBCF4\uD638\uACC4\uC88C'\uB294 \uAC1C\uC778 \uBA85\uC758\uB2E4: \uC815\uBBF8\uB780."
      where: "\uC740\uD589 \uC571 \u2192 \uC774\uCCB4 \u2192 \uBC1B\uB294 \uBD84
        \uD655\uC778"
      when:
