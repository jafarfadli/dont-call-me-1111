        target: 110-900-551207
      - kind: 3
        target: 110-900-551207
    - id: caller_number
      text: "\uBC1C\uC2E0 \uBC88\uD638 070-8844-2019\uB294 \uBBF8\uB4F1\uB85D \uC778\uD130\uB137\uC804\uD654\uC774\uACE0
        \uC0AC\uAE30 \uC2E0\uACE0\uAC00 7\uAC74 \uC788\uB2E4. \uB204\uB9AC\uC740\uD589
        \uBC88\uD638\uAC00 \uC544\uB2C8\uB2E4."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uC804\uD654\uBC88\uD638 \uC870\uD68C"
      guide: 
      when:
      - kind: 2
        target: 070-8844-2019
    papers:
    - outcome: 1
      headline: "\uB9DD\uC6D0\uB3D9\uC5D0 '\uBCF4\uD638\uD300' \uC0AC\uAE30 \uC804\uD654
        \uAE30\uC2B9"
      subhead: "\uB204\uB9AC\uC740\uD589 \uC9C1\uC6D0\uC744 \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00
        \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uB0A8\uC758 \uACC4\uC88C\uB85C \uC608\uAE08\uC744
        \uC62E\uAE30\uB77C\uACE0 \uC694\uAD6C\uD588\uB2E4."
      body: "\uC5B4\uC81C \uC624\uD6C4 \uB204\uB9AC\uC740\uD589 '\uACC4\uC88C\uBCF4\uD638\uD300'
        '\uC804 \uACFC\uC7A5'\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uB9DD\uC6D0\uB3D9
        \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294
        \uBD80\uC0B0\uC5D0\uC11C \uACC4\uC88C \uC811\uC18D \uC2DC\uB3C4\uAC00 \uC788\uC5C8\uB2E4\uBA70
        \uC624\uD6C4 5\uC2DC '\uBCF4\uC548 \uCD08\uAE30\uD654' \uC804\uAE4C\uC9C0
        \uC608\uAE08\uC744 '\uBCF4\uD638\uACC4\uC88C'\uB85C \uC62E\uAE30\uB77C\uACE0
        \uC694\uAD6C\uD588\uB2E4.\n\n\uC5EC\uB7EC \uC8FC\uBBFC\uC774 \uC804\uD654\uB97C
        \uB04A\uC5C8\uB2E4. \uACBD\uCC30\uC5D0 \uB530\uB974\uBA74 '\uBCF4\uD638\uACC4\uC88C'\uC778
        \uB204\uB9AC\uC740\uD589 110-900-551207\uC740 \uB3C8\uC744 \uBC1B\uACE0 \uC870\uC9C1\uC5D0
        \uACC4\uC88C\uB97C \uBE4C\uB824\uC900 30\uB300 \uC5EC\uC131\uC758 \uBA85\uC758\uB2E4.
        \uACBD\uCC30\uC740 070-8844-2019\uB85C \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740
        112\uB098 \uAE08\uC735\uAC10\uB3C5\uC6D0 1332\uC5D0 \uC2E0\uACE0\uD574 \uB2EC\uB77C\uACE0
        \uB2F9\uBD80\uD588\uB2E4.\n\n\uB204\uB9AC\uC740\uD589 \uACE0\uAC1D\uC13C\uD130
        \uC1A1\uC740\uC9C0 \uC528\uB294 \"\uBCF4\uD638\uACC4\uC88C\uB77C\uB294 \uAC83\uC740
        \uC5C6\uB2E4\"\uBA70 \"\uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uB204\uAD6C
        \uACC4\uC88C\uC778\uC9C0 \uC870\uD68C\uD558\uB77C. \uAC1C\uC778 \uC774\uB984\uC774\uB77C\uBA74
        \uBA48\uCD94\uACE0 \uC804\uD654\uB97C \uB04A\uC5B4\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uACE0 \uB3C8\uC744 \uC9C0\uCF30\uB2E4.
        \uACC4\uC88C\uB294 \uBAA8\uB974\uB294 \uC0AC\uB78C \uAC83\uC774\uC5C8\uACE0,
        \uBC88\uD638\uB3C4 \uC740\uD589 \uBC88\uD638\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 8799e236c6e3f4a0fbe6575551b199b8, type: 3}
    - outcome: 0
      headline: "120\uB9CC \uC6D0, \uBA87 \uBD84 \uB9CC\uC5D0 \uC0AC\uB77C\uC838"
      subhead: "\uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD, \uAC00\uC9DC \uC740\uD589
        '\uBCF4\uD638\uACC4\uC88C'\uB85C \uC608\uAE08 \uC1A1\uAE08"
      body: "\uC5B4\uC81C \uC624\uD6C4 \uB204\uB9AC\uC740\uD589 '\uACC4\uC88C\uBCF4\uD638\uD300'
        '\uC804 \uACFC\uC7A5'\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uB9DD\uC6D0\uB3D9
        \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294
        \uBD80\uC0B0\uC5D0\uC11C \uACC4\uC88C \uC811\uC18D \uC2DC\uB3C4\uAC00 \uC788\uC5C8\uB2E4\uBA70
        \uC624\uD6C4 5\uC2DC '\uBCF4\uC548 \uCD08\uAE30\uD654' \uC804\uAE4C\uC9C0
        \uC608\uAE08\uC744 '\uBCF4\uD638\uACC4\uC88C'\uB85C \uC62E\uAE30\uB77C\uACE0
        \uC694\uAD6C\uD588\uB2E4.\n\n22\uC138 \uB300\uD559\uC0DD \uD55C \uBA85\uC740
        \uC2DC\uD0A4\uB294 \uB300\uB85C \uD588\uB2E4. \uB3C8\uC740 \uC815\uBBF8\uB780
        \uBA85\uC758 \uACC4\uC88C\uB85C \uB4E4\uC5B4\uAC14\uACE0, 10\uBD84 \uB4A4
        \uAD6C\uB85C\uC758 ATM\uC5D0\uC11C \uC778\uCD9C\uB410\uB2E4. \uACBD\uCC30\uC5D0
        \uB530\uB974\uBA74 \uD53C\uD574\uC790\uB294 \uC0C1\uB300\uC758 \uC694\uAD6C\uB300\uB85C
        \uB0B4\uB0B4 \uC804\uD654\uB97C \uB04A\uC9C0 \uC54A\uC558\uB2E4.\n\n\uB204\uB9AC\uC740\uD589
        \uACE0\uAC1D\uC13C\uD130 \uC1A1\uC740\uC9C0 \uC528\uB294 \"\uBCF4\uD638\uACC4\uC88C\uB77C\uB294
        \uAC83\uC740 \uC5C6\uB2E4\"\uBA70 \"\uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0
        \uB204\uAD6C \uACC4\uC88C\uC778\uC9C0 \uC870\uD68C\uD558\uB77C. \uAC1C\uC778
        \uC774\uB984\uC774\uB77C\uBA74 \uBA48\uCD94\uACE0 \uC804\uD654\uB97C \uB04A\uC5B4\uB77C\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uACC4\uC88C\uB97C \uC870\uD68C\uD558\uBA74 \uB3C8\uC744 \uBC1B\uB294
        \uC0AC\uB78C\uC774 \uB098\uC654\uB2E4: \uC740\uD589\uC774 \uC544\uB2C8\uB77C
        '\uC815\uBBF8\uB780'\uC774\uB77C\uB294 \uAC1C\uC778."
      print: {fileID: 2800000, guid: 3396a557fca524bcd93b62126b83e483, type: 3}
    - outcome: 3
      headline: "\uB9C8\uD3EC '\uBCF4\uD638\uD300' \uC804\uD654 \uACC4\uC18D\uB3FC"
      subhead: "\uC8FC\uBBFC\uB4E4\uC740 \uB3C8\uC744 \uC9C0\uCF30\uC9C0\uB9CC \uC2E0\uACE0\uB294
        \uC801\uC5C8\uB2E4."
      body: "\uC5B4\uC81C \uC624\uD6C4 \uB204\uB9AC\uC740\uD589 '\uACC4\uC88C\uBCF4\uD638\uD300'
        '\uC804 \uACFC\uC7A5'\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uB9DD\uC6D0\uB3D9
        \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294
        \uBD80\uC0B0\uC5D0\uC11C \uACC4\uC88C \uC811\uC18D \uC2DC\uB3C4\uAC00 \uC788\uC5C8\uB2E4\uBA70
        \uC624\uD6C4 5\uC2DC '\uBCF4\uC548 \uCD08\uAE30\uD654' \uC804\uAE4C\uC9C0
        \uC608\uAE08\uC744 '\uBCF4\uD638\uACC4\uC88C'\uB85C \uC62E\uAE30\uB77C\uACE0
        \uC694\uAD6C\uD588\uB2E4.\n\n\uB300\uBD80\uBD84\uC758 \uC8FC\uBBFC\uC740
        \uB9C8\uAC10 \uC2DC\uAC04\uC774 \uC9C0\uB098\uAC00\uB3C4\uB85D \uB0B4\uBC84\uB824
        \uB480\uB2E4. \uACBD\uCC30\uC740 \uC870\uC9C1\uC774 \uC800\uB141\uAE4C\uC9C0
        \uC804\uD654\uB97C \uACC4\uC18D \uAC78\uC5C8\uB2E4\uBA70, 070-8844-2019\uB85C
        \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uB098 1332\uC5D0 \uC2E0\uACE0\uD574
        \uB2EC\uB77C\uACE0 \uB2F9\uBD80\uD588\uB2E4.\n\n\uB204\uB9AC\uC740\uD589
        \uACE0\uAC1D\uC13C\uD130 \uC1A1\uC740\uC9C0 \uC528\uB294 \"\uBCF4\uD638\uACC4\uC88C\uB77C\uB294
        \uAC83\uC740 \uC5C6\uB2E4\"\uBA70 \"\uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0
        \uB204\uAD6C \uACC4\uC88C\uC778\uC9C0 \uC870\uD68C\uD558\uB77C. \uAC1C\uC778
        \uC774\uB984\uC774\uB77C\uBA74 \uBA48\uCD94\uACE0 \uC804\uD654\uB97C \uB04A\uC5B4\uB77C\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uC2DC\uAC04\uC744
        \uB118\uACBC\uB2E4. \uACC4\uC88C\uC640 \uBC88\uD638\uB97C \uC870\uD68C\uD55C
        \uB4A4 \uC9C1\uC811 \uB04A\uC5C8\uC5B4\uC57C \uD588\uB2E4."
      print: {fileID: 2800000, guid: 86dfcfb076a234a1c891f4cce9e991ec, type: 3}
    ruleTitle: "\uC740\uD589\uC740 \uB3C8\uC744 '\uBCF4\uD638'\uD574 \uC8FC\uC9C0
      \uC54A\uB294\uB2E4"
    rule: "\uC740\uD589\uC740 \uC808\uB300 '\uC548\uC804\uACC4\uC88C'\uB098 '\uBCF4\uD638\uACC4\uC88C'\uB85C
      \uB3C8\uC744 \uC62E\uAE30\uC9C0 \uC54A\uB294\uB2E4. \uBA3C\uC800 \uACC4\uC88C\uC640
      \uBC1C\uC2E0 \uBC88\uD638\uB97C \uC870\uD68C\uD558\uB77C. '\uACF5\uC2DD' \uACC4\uC88C\uC778\uB370
      \uBAA8\uB974\uB294 \uAC1C\uC778 \uC774\uB984\uC774 \uB098\uC624\uBA74 \uBA48\uCDB0\uB77C."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 7\uC77C"
  - id: paper_scam
    scenario: paper
    intro: "\uC218\uC5C5\uC740 \uB05D\uB0AC\uB2E4. \uCC45\uC0C1 \uC704\uC5D0\uB294
      3\uC6D4\uC5D0 \uC544\uBE60\uAC00 \uAD6C\uB3C5 \uC2E0\uCCAD\uD574 \uC900 \uC11C\uC6B8\uB370\uC77C\uB9AC\uAC00
      \uB193\uC5EC \uC788\uB2E4. \uB9E4\uC77C \uC544\uCE68 \uC624\uB294 \uC2E0\uBB38\uC774\uB2E4."
    conversation: {fileID: 11400000, guid: 473c1c793caf34d35a045b88e651aaa5, type: 2}
    phone: {fileID: 11400000, guid: 3c45ce3675b864335bfd015ddd8dd2b0, type: 2}
    room: {fileID: 11400000, guid: 20a0a00cd93f946f1a13b2d32581e08c, type: 2}
    directory: {fileID: 11400000, guid: 17da7a667039e4a41ad55ead49b3f4ab, type: 2}
    clues:
    - id: notice
      text: "\uC624\uB298 \uC790 \uC11C\uC6B8\uB370\uC77C\uB9AC\uC5D0 \uC54C\uB9BC\uC774
        \uC2E4\uB838\uB2E4. 10\uC6D4 1\uC77C\uBD80\uB85C \uB9C8\uD3EC\uC9C0\uAD6D\uC7A5\uC774
        \uBC14\uB00C\uC5C8\uACE0, \uC624\uC0C1\uCCA0 \uC528\uB294 \uB354 \uC774\uC0C1
        \uC2E0\uBB38\uC0AC\uC640 \uAD00\uACC4\uAC00 \uC5C6\uC73C\uBA70, \uAD6C\uB3C5\uB8CC\uB294
        \uC9C0\uB85C\uB85C\uB9CC \uBC1B\uACE0 \uC804\uD654\uB85C \uC774\uCCB4\uB97C
        \uC694\uAD6C\uD558\uC9C0 \uC54A\uB294\uB2E4\uACE0."
      where: "\uCC45\uC0C1 \uC704 \uC2E0\uBB38"
      guide: 
      when:
      - kind: 0
        target: Newspaper
    papers:
    - outcome: 1
      headline: "\uC804 \uC9C0\uAD6D\uC7A5, \uADF8\uB9CC\uB454 \uB4A4\uC5D0\uB3C4
        '\uAD6C\uB3C5\uB8CC \uC218\uAE08'"
      subhead: "\uC774\uB984\uB3C4 \uACC4\uC88C\uB3C4 \uC9C4\uC9DC\uC600\uB2E4. \uC54C\uB9BC\uC744
        \uC77D\uC740 \uB3C5\uC790\uB4E4\uC740 \uC804\uD654\uB97C \uB04A\uC5C8\uB2E4."
      body: "9\uC6D4\uAE4C\uC9C0 \uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC744
        \uB9E1\uC558\uB358 \uB0A8\uC131\uC774 \uD654\uC694\uC77C \uB0B4\uB0B4 \uAD6C\uB3C5\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 10\uC6D4\uBD80\uD130
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBC1B\uB294\uB2E4\uBA70,
        \uC11D \uB2EC \uCE58 54,000\uC6D0\uC744 \uC624\uD6C4 5\uC2DC\uAE4C\uC9C0
        \uC790\uAE30 \uBA85\uC758 \uACC4\uC88C\uB85C \uBCF4\uB0B4\uB77C\uACE0 \uD588\uB2E4.\n\n\uC774\uB984\uACFC
        \uACC4\uC88C\uB294 \uC9C4\uC9DC\uC600\uB2E4. \uC624\uC0C1\uCCA0(58) \uC528\uB294
        6\uB144\uAC04 \uC9C0\uAD6D\uC744 \uC6B4\uC601\uD588\uB2E4. \uBCF8\uC0AC\uB294
        9\uC6D4 30\uC77C \uADF8\uC640\uC758 \uACC4\uC57D\uC744 \uB05D\uB0C8\uACE0,
        \uD654\uC694\uC77C \uC790 1\uBA74 \uC54C\uB9BC\uC73C\uB85C \uC774\uB97C \uC54C\uB838\uB2E4.
        \uAD6C\uB3C5\uB8CC\uB294 \uC9C0\uB85C\uB85C\uB9CC \uBC1B\uB294\uB2E4.\n\n\uC0C8
        \uC9C0\uAD6D\uC7A5 \uB958\uBBF8\uB098 \uC528\uB294 \"\uC870\uD68C\uD574 \uBCF4\uBA74
        \uC774\uB984\uC774 \uC9C4\uC9DC\uB77C\uB294 \uAC74 \uB098\uC628\uB2E4. \uD558\uC9C0\uB9CC
        \uADF8 \uC0AC\uB78C\uC774 \uC544\uC9C1 \uC218\uAE08\uD560 \uC790\uACA9\uC774
        \uC788\uB294\uC9C0\uB294 \uC548 \uB098\uC628\uB2E4\"\uBA70 \"\uADF8\uB798\uC11C
        \uC54C\uB9BC\uC744 \uB0B4\uB294 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uCC45\uC0C1 \uC704 \uC2E0\uBB38\uC758
        \uC54C\uB9BC\uC5D0 \uADF8\uB294 \uB354 \uC774\uC0C1 \uC218\uAE08\uD558\uC9C0
        \uC54A\uB294\uB2E4\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 7f6f4af632dd44a20a424d219911ebe3, type: 3}
    - outcome: 0
      headline: "\uC2E0\uBB38\uACFC \uBB34\uAD00\uD55C \uC0AC\uB78C\uC5D0\uAC8C \uB0B8
        \uC11D \uB2EC \uCE58 \uAD6C\uB3C5\uB8CC"
      subhead: "\uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD, \uC804 \uC9C0\uAD6D\uC7A5\uC5D0\uAC8C
        54,000\uC6D0 \uC1A1\uAE08"
      body: "9\uC6D4\uAE4C\uC9C0 \uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC744
        \uB9E1\uC558\uB358 \uB0A8\uC131\uC774 \uD654\uC694\uC77C \uB0B4\uB0B4 \uAD6C\uB3C5\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 10\uC6D4\uBD80\uD130
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBC1B\uB294\uB2E4\uBA70,
        \uC11D \uB2EC \uCE58 54,000\uC6D0\uC744 \uC624\uD6C4 5\uC2DC\uAE4C\uC9C0
        \uC790\uAE30 \uBA85\uC758 \uACC4\uC88C\uB85C \uBCF4\uB0B4\uB77C\uACE0 \uD588\uB2E4.\n\n\uB9DD\uC6D0\uB3D9\uC758
        22\uC138 \uB300\uD559\uC0DD \uD55C \uBA85\uC740 \uB3C8\uC744 \uBCF4\uB0C8\uB2E4.
        \uC870\uD68C \uACB0\uACFC\uC5D0\uB294 12\uB144 \uB41C \uACC4\uC88C\uC640
        \uC9C4\uC9DC \uC774\uB984\uC774 \uB098\uC654\uACE0, \uADF8\uAC74 \uC0AC\uC2E4\uC774\uC5C8\uB2E4.
        \uC774\uB984\uACFC \uACC4\uC88C\uB294 \uC9C4\uC9DC\uC600\uB2E4. \uC624\uC0C1\uCCA0(58)
        \uC528\uB294 6\uB144\uAC04 \uC9C0\uAD6D\uC744 \uC6B4\uC601\uD588\uB2E4. \uBCF8\uC0AC\uB294
        9\uC6D4 30\uC77C \uADF8\uC640\uC758 \uACC4\uC57D\uC744 \uB05D\uB0C8\uACE0,
        \uD654\uC694\uC77C \uC790 1\uBA74 \uC54C\uB9BC\uC73C\uB85C \uC774\uB97C \uC54C\uB838\uB2E4.
        \uAD6C\uB3C5\uB8CC\uB294 \uC9C0\uB85C\uB85C\uB9CC \uBC1B\uB294\uB2E4.\n\n\uC0C8
        \uC9C0\uAD6D\uC7A5 \uB958\uBBF8\uB098 \uC528\uB294 \"\uC870\uD68C\uD574 \uBCF4\uBA74
        \uC774\uB984\uC774 \uC9C4\uC9DC\uB77C\uB294 \uAC74 \uB098\uC628\uB2E4. \uD558\uC9C0\uB9CC
        \uADF8 \uC0AC\uB78C\uC774 \uC544\uC9C1 \uC218\uAE08\uD560 \uC790\uACA9\uC774
        \uC788\uB294\uC9C0\uB294 \uC548 \uB098\uC628\uB2E4\"\uBA70 \"\uADF8\uB798\uC11C
        \uC54C\uB9BC\uC744 \uB0B4\uB294 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC774\uB984\uB3C4 \uACC4\uC88C\uB3C4 \uC9C4\uC9DC\uC600\uB2E4.
        \uD558\uC9C0\uB9CC \uC2E0\uBB38\uC0AC \uC54C\uB9BC\uC5D0\uB294 \uADF8\uAC00
        \uADF8\uB9CC\uB480\uB2E4\uACE0 \uB098\uC640 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 35fae1395b3514bb680ef36dffef0df8, type: 3}
    - outcome: 3
      headline: "'5\uC2DC\uAE4C\uC9C0 \uC548 \uB0B4\uBA74 \uC2E0\uBB38 \uB04A\uAE41\uB2C8\uB2E4'"
      subhead: "\uB2E4\uC74C \uB0A0 \uC544\uCE68\uC5D0\uB3C4 \uC2E0\uBB38\uC740 \uADF8\uB300\uB85C
        \uBC30\uB2EC\uB410\uB2E4."
      body: "9\uC6D4\uAE4C\uC9C0 \uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC744
        \uB9E1\uC558\uB358 \uB0A8\uC131\uC774 \uD654\uC694\uC77C \uB0B4\uB0B4 \uAD6C\uB3C5\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 10\uC6D4\uBD80\uD130
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBC1B\uB294\uB2E4\uBA70,
        \uC11D \uB2EC \uCE58 54,000\uC6D0\uC744 \uC624\uD6C4 5\uC2DC\uAE4C\uC9C0
        \uC790\uAE30 \uBA85\uC758 \uACC4\uC88C\uB85C \uBCF4\uB0B4\uB77C\uACE0 \uD588\uB2E4.\n\n\uC774\uB984\uACFC
        \uACC4\uC88C\uB294 \uC9C4\uC9DC\uC600\uB2E4. \uC624\uC0C1\uCCA0(58) \uC528\uB294
        6\uB144\uAC04 \uC9C0\uAD6D\uC744 \uC6B4\uC601\uD588\uB2E4. \uBCF8\uC0AC\uB294
        9\uC6D4 30\uC77C \uADF8\uC640\uC758 \uACC4\uC57D\uC744 \uB05D\uB0C8\uACE0,
        \uD654\uC694\uC77C \uC790 1\uBA74 \uC54C\uB9BC\uC73C\uB85C \uC774\uB97C \uC54C\uB838\uB2E4.
        \uAD6C\uB3C5\uB8CC\uB294 \uC9C0\uB85C\uB85C\uB9CC \uBC1B\uB294\uB2E4.\n\n\uC0C8
        \uC9C0\uAD6D\uC7A5 \uB958\uBBF8\uB098 \uC528\uB294 \"\uC870\uD68C\uD574 \uBCF4\uBA74
        \uC774\uB984\uC774 \uC9C4\uC9DC\uB77C\uB294 \uAC74 \uB098\uC628\uB2E4. \uD558\uC9C0\uB9CC
        \uADF8 \uC0AC\uB78C\uC774 \uC544\uC9C1 \uC218\uAE08\uD560 \uC790\uACA9\uC774
        \uC788\uB294\uC9C0\uB294 \uC548 \uB098\uC628\uB2E4\"\uBA70 \"\uADF8\uB798\uC11C
        \uC54C\uB9BC\uC744 \uB0B4\uB294 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uB05D\uB0B4
        \uB2F5\uC744 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uC54C\uB9BC\uC740 \uCC45\uC0C1
        \uC704 \uC2E0\uBB38\uC5D0 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: d8143f850e73d449d80288d97f4ef037, type: 3}
    ruleTitle: "\uC9C4\uC9DC \uC774\uB984\uC774 \uACE7 \uC790\uACA9\uC740 \uC544\uB2C8\uB2E4"
    rule: "\uAC70\uB798\uD558\uB294 \uD68C\uC0AC \uC774\uB984\uC73C\uB85C \uB3C8\uC744
      \uAC77\uB294 \uC0AC\uB78C\uC774 \uC788\uB2E4\uBA74? \uC870\uD68C\uB85C\uB294
      \uADF8 \uC774\uB984\uC774 \uC9C4\uC9DC\uB77C\uB294 \uAC83\uB9CC \uC54C \uC218
      \uC788\uB2E4. \uB204\uAC00, \uC5B4\uB5A4 \uBC29\uBC95\uC73C\uB85C \uAC77\uB294\uC9C0\uB294
      \uD68C\uC0AC\uAC00 \uC9C1\uC811 \uB0B8 \uC54C\uB9BC\uC5D0 \uC788\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 7\uC77C"
  - id: paper_legit
    scenario: paper
    intro: "\uC218\uC5C5\uC740 \uB05D\uB0AC\uB2E4. \uCC45\uC0C1 \uC704\uC5D0\uB294
      3\uC6D4\uC5D0 \uC544\uBE60\uAC00 \uAD6C\uB3C5 \uC2E0\uCCAD\uD574 \uC900 \uC11C\uC6B8\uB370\uC77C\uB9AC\uAC00
      \uB193\uC5EC \uC788\uB2E4. \uB9E4\uC77C \uC544\uCE68 \uC624\uB294 \uC2E0\uBB38\uC774\uB2E4."
    conversation: {fileID: 11400000, guid: 7cc4ea16f362340b7a530cdb39e34056, type: 2}
    phone: {fileID: 11400000, guid: 85568f87b7a3a4fdaa7cb9b60fc3f9d4, type: 2}
    room: {fileID: 11400000, guid: 0e85164936caf43a2ae9c784d2b08eb2, type: 2}
    directory: {fileID: 11400000, guid: 20a008497ebc44571b667b2962488307, type: 2}
    clues:
    - id: notice
      text: "\uC624\uB298 \uC790 \uC11C\uC6B8\uB370\uC77C\uB9AC\uC5D0 \uC9C1\uC811
        \uC54C\uB9BC\uC774 \uC2E4\uB838\uB2E4. \uC774\uBC88 \uC8FC \uC624\uC0C1\uCCA0
        \uC9C0\uAD6D\uC7A5\uC774 \uC804\uD654\uB85C 10~12\uC6D4 \uAD6C\uB3C5\uB8CC
        54,000\uC6D0\uC744 \uC548\uB0B4\uD558\uBA70, \uADF8\uAC00 \uBD88\uB7EC \uC900
        \uBC14\uB85C \uADF8 \uACC4\uC88C\uB85C \uBC1B\uB294\uB2E4\uACE0."
      where: "\uCC45\uC0C1 \uC704 \uC2E0\uBB38"
      guide: 
      when:
      - kind: 0
        target: Newspaper
    papers:
    - outcome: 0
      headline: "\uB9C8\uD3EC\uC9C0\uAD6D, \uBC29\uBB38 \uC218\uAE08 \uB300\uC2E0
        \uACC4\uC88C\uC774\uCCB4\uB85C"
      subhead: "1\uBA74 \uC54C\uB9BC\uC5D0 \uC774\uC5B4 \uC9C0\uAD6D\uC7A5\uC774
        \uB3C5\uC790\uB4E4\uC5D0\uAC8C \uC9C1\uC811 \uC804\uD654\uD588\uB2E4."
      body: "\uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC774 \uC774\uB2EC\uBD80\uD130
        \uBC29\uBB38 \uC218\uAE08\uC744 \uC911\uB2E8\uD588\uB2E4. \uC624\uC0C1\uCCA0(58)
        \uC9C0\uAD6D\uC7A5\uC740 \uD654\uC694\uC77C \uD558\uB8E8 \uB3D9\uC548 \uAD6C\uB3C5\uC790
        400\uBA85\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5B4 \uC11D \uB2EC \uCE58
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBD80\uD0C1\uD588\uB2E4.\n\n\uC624
        \uC9C0\uAD6D\uC7A5\uC740 \"\uC808\uBC18\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C
        \uC54C\uB354\uB77C\"\uBA74\uC11C\uB3C4 \"\uD0D3\uD560 \uC77C\uC774 \uC544\uB2C8\uB2E4.
        \uADF8\uB798\uC11C \uC81C \uC774\uB984\uACFC \uBC88\uD638, \uACC4\uC88C\uB97C
        1\uBA74\uC5D0 \uBA3C\uC800 \uC2E4\uC740 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4.
        \uD55C \uB300\uD559\uC0DD\uC740 \uADF8\uAC00 \uC804\uD654\uB85C \uAE30\uB2E4\uB9AC\uB294
        \uB3D9\uC548 \uC54C\uB9BC\uC744 \uC77D\uACE0 \uB098\uC11C \uAD6C\uB3C5\uB8CC\uB97C
        \uB0C8\uB2E4. \uADF8\uB294 \"\uBC14\uB85C \uADF8\uB807\uAC8C \uD558\uB294
        \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4.\n\n\uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uC218\uAE08\uD558\uB294 \uC0AC\uB78C\uC744 \uD655\uC778\uD560 \uACF3\uC740
        \uD68C\uC0AC\uAC00 \uC9C1\uC811 \uB0B8 \uC54C\uB9BC\uC774\uB77C\uACE0 \uB9D0\uD55C\uB2E4.
        \uB204\uAC00, \uC5BC\uB9C8\uB97C, \uC5B4\uB290 \uACC4\uC88C\uB85C \uBC1B\uB294\uC9C0\uAC00
        \uAC70\uAE30\uC5D0 \uC788\uB2E4."
      verdictNote: "\uADF8\uB294 \uC9C4\uC9DC \uC9C0\uAD6D\uC7A5\uC774\uC5C8\uACE0,
        \uB2F9\uC2E0\uC740 \uD655\uC778\uD588\uB2E4. \uC2E0\uBB38\uC0AC \uC54C\uB9BC\uC5D0
        \uADF8\uC758 \uC774\uB984\uACFC \uAE08\uC561, \uACC4\uC88C\uAC00 \uADF8\uB300\uB85C
        \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 6d3a82f66939447ab8cccb5c5477eb35, type: 3}
    - outcome: 1
      headline: "\uC790\uAE30 \uC2E0\uBB38 \uC9C0\uAD6D\uC7A5 \uC804\uD654\uB3C4
        \uB04A\uB294 \uB3C5\uC790\uB4E4"
      subhead: "\uC9C0\uAD6D\uC7A5\uC758 \uC9C4\uC9DC \uC804\uD654\uAC00 \uC0AC\uAE30\uB85C
        \uC624\uD574\uBC1B\uC558\uB2E4."
      body: "\uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC774 \uC774\uB2EC\uBD80\uD130
        \uBC29\uBB38 \uC218\uAE08\uC744 \uC911\uB2E8\uD588\uB2E4. \uC624\uC0C1\uCCA0(58)
        \uC9C0\uAD6D\uC7A5\uC740 \uD654\uC694\uC77C \uD558\uB8E8 \uB3D9\uC548 \uAD6C\uB3C5\uC790
        400\uBA85\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5B4 \uC11D \uB2EC \uCE58
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBD80\uD0C1\uD588\uB2E4.\n\n\uC624
        \uC9C0\uAD6D\uC7A5\uC740 \"\uC808\uBC18\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C
        \uC54C\uB354\uB77C\"\uBA74\uC11C\uB3C4 \"\uD0D3\uD560 \uC77C\uC774 \uC544\uB2C8\uB2E4.
        \uADF8\uB798\uC11C \uC81C \uC774\uB984\uACFC \uBC88\uD638, \uACC4\uC88C\uB97C
        1\uBA74\uC5D0 \uBA3C\uC800 \uC2E4\uC740 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4.
        \uADF8\uB294 \uC218\uC694\uC77C\uC5D0\uB3C4 \uBAA8\uB4E0 \uC9D1\uC5D0 \uC2E0\uBB38\uC744
        \uB123\uC5C8\uB2E4. \"\uD558\uB8E8\uB9CC \uB354 \uB123\uC5B4 \uBCF4\uB294
        \uAC83\"\uC774\uB77C\uACE0 \uD588\uB2E4.\n\n\uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uC218\uAE08\uD558\uB294 \uC0AC\uB78C\uC744 \uD655\uC778\uD560 \uACF3\uC740
        \uD68C\uC0AC\uAC00 \uC9C1\uC811 \uB0B8 \uC54C\uB9BC\uC774\uB77C\uACE0 \uB9D0\uD55C\uB2E4.
        \uB204\uAC00, \uC5BC\uB9C8\uB97C, \uC5B4\uB290 \uACC4\uC88C\uB85C \uBC1B\uB294\uC9C0\uAC00
        \uAC70\uAE30\uC5D0 \uC788\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uCC45\uC0C1 \uC704
        \uC2E0\uBB38\uC758 \uC54C\uB9BC\uC5D0 \uADF8\uC758 \uC774\uB984\uACFC \uAE08\uC561,
        \uACC4\uC88C\uAC00 \uC2E4\uB824 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 97c6f7bf3ac334de29801645777cd377, type: 3}
    - outcome: 3
      headline: "\uC7A5\uBD80\uB294 5\uC2DC\uC5D0 \uB9C8\uAC10\uB410\uB2E4"
      subhead: "\uC9C0\uAD6D\uC7A5\uC740 \uB05D\uB0B4 \uACB0\uC815\uD558\uC9C0 \uBABB\uD55C
        \uB3C5\uC790\uB4E4\uC744 \uC804\uD654\uB85C \uAE30\uB2E4\uB838\uB2E4."
      body: "\uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC774 \uC774\uB2EC\uBD80\uD130
        \uBC29\uBB38 \uC218\uAE08\uC744 \uC911\uB2E8\uD588\uB2E4. \uC624\uC0C1\uCCA0(58)
        \uC9C0\uAD6D\uC7A5\uC740 \uD654\uC694\uC77C \uD558\uB8E8 \uB3D9\uC548 \uAD6C\uB3C5\uC790
        400\uBA85\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5B4 \uC11D \uB2EC \uCE58
        \uAD6C\uB3C5\uB8CC\uB97C \uACC4\uC88C\uC774\uCCB4\uB85C \uBD80\uD0C1\uD588\uB2E4.\n\n\uC624
        \uC9C0\uAD6D\uC7A5\uC740 \"\uC808\uBC18\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C
        \uC54C\uB354\uB77C\"\uBA74\uC11C\uB3C4 \"\uD0D3\uD560 \uC77C\uC774 \uC544\uB2C8\uB2E4.
        \uADF8\uB798\uC11C \uC81C \uC774\uB984\uACFC \uBC88\uD638, \uACC4\uC88C\uB97C
        1\uBA74\uC5D0 \uBA3C\uC800 \uC2E4\uC740 \uAC83\"\uC774\uB77C\uACE0 \uB9D0\uD588\uB2E4.\n\n\uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uC218\uAE08\uD558\uB294 \uC0AC\uB78C\uC744 \uD655\uC778\uD560 \uACF3\uC740
        \uD68C\uC0AC\uAC00 \uC9C1\uC811 \uB0B8 \uC54C\uB9BC\uC774\uB77C\uACE0 \uB9D0\uD55C\uB2E4.
        \uB204\uAC00, \uC5BC\uB9C8\uB97C, \uC5B4\uB290 \uACC4\uC88C\uB85C \uBC1B\uB294\uC9C0\uAC00
        \uAC70\uAE30\uC5D0 \uC788\uB2E4."
      verdictNote: "\uADF8\uB294 \uC9C4\uC9DC \uC9C0\uAD6D\uC7A5\uC774\uC5C8\uACE0,
        \uC54C\uB9BC\uC740 \uCC45\uC0C1 \uC704 \uC2E0\uBB38\uC5D0 \uC788\uC5C8\uB2E4.
        \uC81C\uB54C \uACB0\uC815\uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 2800000, guid: 474616228d890438e98aca47ed463247, type: 3}
    ruleTitle: "\uD68C\uC0AC\uAC00 \uB0B8 \uC54C\uB9BC\uC774 \uB2F5\uC774\uB2E4"
    rule: "\uD68C\uC0AC\uAC00 \uC9C1\uC811 \uB0B8 \uC54C\uB9BC\uC5D0 \uC218\uAE08\uD558\uB294
      \uC0AC\uB78C, \uAE08\uC561, \uACC4\uC88C\uAC00 \uADF8\uB300\uB85C \uB098\uC640
      \uC788\uB2E4\uBA74 \uBCF4\uB0B4\uB3C4 \uC548\uC804\uD558\uB2E4. \uC54C\uB9BC\uC744
      \uC77D\uACE0, \uADF8\uB2E4\uC74C\uC5D0 \uD589\uB3D9\uD558\uB77C."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 7\uC77C"
  - id: sale_scam
    scenario: sale
    intro: "\uC218\uC5C5\uC740 \uB05D\uB0AC\uB2E4. \uC4F0\uB358 \uBAA8\uB2C8\uD130\uB294
      \uC774\uC6C3\uB9C8\uCF13\uC5D0\uC11C \uD314\uB838\uB2E4. \uAD6C\uB9E4\uC790\uAC00
      \uC624\uB298 6\uB9CC \uC6D0\uC744 \uBCF4\uB0B4\uACE0 \uD1A0\uC694\uC77C\uC5D0
      \uAC00\uC9C0\uB7EC \uC628\uB2E4."
    conversation: {fileID: 11400000, guid: c1fb8a60879474d73b40eb292912a21e, type: 2}
    phone: {fileID: 11400000, guid: 31758ec7cba0544a9baef7ac0fae3431, type: 2}
    room: {fileID: 11400000, guid: f445bb43c5e964d5bb809afcf6c4b3d5, type: 2}
    directory: {fileID: 11400000, guid: 173b0bf087f334de8bd890efb1eaceaa, type: 2}
    clues:
    - id: deposit
      text: "\uC740\uD589 \uB0B4\uC5ED\uC5D0 \uC624\uB298 \uB4E4\uC5B4\uC628 \uB3C8\uC774
        \uC5C6\uB2E4. \uC0C1\uB300\uAC00 \uBCF4\uB0B8 \uB3C8\uC774 \uC5C6\uC73C\uB2C8
        \uB3CC\uB824\uC904 \uB3C8\uB3C4 \uC5C6\uB2E4."
      where: "\uD734\uB300\uD3F0 \u2192 \uB204\uB9AC\uC740\uD589"
      guide: 
      when:
      - kind: 5
        target: 
    papers:
    - outcome: 1
      headline: "'\uB3C8\uC744 \uB354 \uBCF4\uB0C8\uC5B4\uC694': \uB4E4\uC5B4\uC624\uC9C0\uB3C4
        \uC54A\uC740 \uB3C8\uC744 \uB3CC\uB824 \uB2EC\uB77C\uB294 \uC804\uD654"
      subhead: "\uC740\uD589 \uC571\uBD80\uD130 \uC5F4\uC5B4 \uBCF8 \uD310\uB9E4\uC790\uB4E4\uC740
        \uD53C\uD574\uAC00 \uC5C6\uC5C8\uB2E4."
      body: "\uD654\uC694\uC77C, \uC911\uACE0 \uAC70\uB798 \uC571 \uC774\uC6C3\uB9C8\uCF13\uC758
        \uD310\uB9E4\uC790\uB4E4\uC5D0\uAC8C \uC6B8\uBA39\uC774\uB294 '\uAD6C\uB9E4\uC790'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uC120\uC785\uAE08\uD558\uB2E4\uAC00
        0\uC744 \uD558\uB098 \uB354 \uB20C\uB800\uB2E4\uBA70, \uC6D4\uC138 \uB0BC
        \uB3C8\uC774\uB2C8 \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uCC28\uC561\uC744 \uB3CC\uB824
        \uB2EC\uB77C\uB294 \uAC83\uC774\uC5C8\uB2E4.\n\n\uB3C8\uC740 \uB4E4\uC5B4\uC628
        \uC801\uC774 \uC5C6\uC5C8\uB2E4. \uACBD\uCC30\uC5D0 \uB530\uB974\uBA74 \uC774\uB4E4\uC740
        \uC120\uC785\uAE08\uC744 \uBC1B\uC73C\uB824\uACE0 \uACC4\uC88C\uBC88\uD638\uB97C
        \uC54C\uB824 \uC900 \uD310\uB9E4\uC790\uB97C \uACE8\uB77C, \uB204\uAD70\uAC00
        \uC804\uD654\uB85C \uC6B8\uACE0 \uC788\uB294 \uB3D9\uC548\uC5D0\uB294 \uC740\uD589
        \uC571\uC744 \uC5F4\uC5B4 \uBCF4\uC9C0 \uC54A\uC73C\uB9AC\uB77C\uB294 \uC810\uC744
        \uB178\uB9B0\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C \uAD00\uACC4\uC790\uB294
        \"\uC774\uCCB4\uB294 \uBA87 \uCD08\uBA74 \uB4E4\uC5B4\uC628\uB2E4\"\uBA70
        \"\uB0B4\uC5ED\uC5D0 \uC5C6\uC73C\uBA74 \uBCF4\uB0B8 \uC801\uC774 \uC5C6\uB294
        \uAC83\uC774\uB2E4. \uBB54\uAC00\uB97C '\uB3CC\uB824\uC8FC\uAE30' \uC804\uC5D0
        \uBA3C\uC800 \uD655\uC778\uD558\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uC740\uD589 \uB0B4\uC5ED\uC5D0\uB294
        \uC0C1\uB300\uAC00 \uBCF4\uB0B8 \uB3C8\uC774 \uC5C6\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: c1741a62a7c0e4729b9570733cabbec5, type: 3}
    - outcome: 0
      headline: "\uB4E4\uC5B4\uC628 \uC801 \uC5C6\uB294 54\uB9CC \uC6D0\uC744 '\uB3CC\uB824\uC900'
        \uD310\uB9E4\uC790"
      subhead: "\uBAA8\uB2C8\uD130\uB97C \uD314\uB358 \uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD,
        \uAC00\uC9DC \uAD6C\uB9E4\uC790\uC5D0\uAC8C \uC790\uAE30 \uB3C8 \uC1A1\uAE08"
      body: "\uD654\uC694\uC77C, \uC911\uACE0 \uAC70\uB798 \uC571 \uC774\uC6C3\uB9C8\uCF13\uC758
        \uD310\uB9E4\uC790\uB4E4\uC5D0\uAC8C \uC6B8\uBA39\uC774\uB294 '\uAD6C\uB9E4\uC790'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uC120\uC785\uAE08\uD558\uB2E4\uAC00
        0\uC744 \uD558\uB098 \uB354 \uB20C\uB800\uB2E4\uBA70, \uC6D4\uC138 \uB0BC
        \uB3C8\uC774\uB2C8 \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uCC28\uC561\uC744 \uB3CC\uB824
        \uB2EC\uB77C\uB294 \uAC83\uC774\uC5C8\uB2E4.\n\n6\uB9CC \uC6D0\uC9DC\uB9AC
        \uBAA8\uB2C8\uD130\uB97C \uD314\uB358 22\uC138 \uB300\uD559\uC0DD\uC740 \uC790\uAE30
        \uB3C8 54\uB9CC \uC6D0\uC744 \uBCF4\uB0C8\uB2E4. \uACC4\uC88C\uB294 \uC0C1\uB300\uAC00
        \uB304 \uC774\uB984\uC778 '\uBC30\uC218\uC9C4' \uBA85\uC758\uC600\uB294\uB370,
        \uACBD\uCC30\uC740 \uC608\uAE08\uC8FC\uAC00 \uB3C8\uC744 \uBC1B\uACE0 \uD1B5\uC7A5\uC744
        \uBE4C\uB824\uC900 \uAC83\uC73C\uB85C \uBCF4\uACE0 \uC788\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C
        \uAD00\uACC4\uC790\uB294 \"\uC774\uCCB4\uB294 \uBA87 \uCD08\uBA74 \uB4E4\uC5B4\uC628\uB2E4\"\uBA70
        \"\uB0B4\uC5ED\uC5D0 \uC5C6\uC73C\uBA74 \uBCF4\uB0B8 \uC801\uC774 \uC5C6\uB294
        \uAC83\uC774\uB2E4. \uBB54\uAC00\uB97C '\uB3CC\uB824\uC8FC\uAE30' \uC804\uC5D0
        \uBA3C\uC800 \uD655\uC778\uD558\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC740\uD589 \uB0B4\uC5ED\uC5D0\uB294 \uC0C1\uB300\uAC00 \uBCF4\uB0B8
        \uB3C8\uC774 \uC5C6\uC5C8\uB2E4. \uB3CC\uB824\uC904 \uB3C8\uC740 \uCC98\uC74C\uBD80\uD130
        \uC5C6\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 43b300ec514d3493591d5d5258bc2721, type: 3}
    - outcome: 3
      headline: "'0 \uD558\uB098 \uB354' \uC804\uD654 \uC8FC\uC758\uBCF4"
      subhead: "\uAC00\uC9DC \uAD6C\uB9E4\uC790\uB4E4\uC774 \uC911\uACE0 \uD310\uB9E4\uC790\uC5D0\uAC8C
        \uD658\uBD88\uC744 \uC694\uAD6C\uD588\uB2E4."
      body: "\uD654\uC694\uC77C, \uC911\uACE0 \uAC70\uB798 \uC571 \uC774\uC6C3\uB9C8\uCF13\uC758
        \uD310\uB9E4\uC790\uB4E4\uC5D0\uAC8C \uC6B8\uBA39\uC774\uB294 '\uAD6C\uB9E4\uC790'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uC120\uC785\uAE08\uD558\uB2E4\uAC00
        0\uC744 \uD558\uB098 \uB354 \uB20C\uB800\uB2E4\uBA70, \uC6D4\uC138 \uB0BC
        \uB3C8\uC774\uB2C8 \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uCC28\uC561\uC744 \uB3CC\uB824
        \uB2EC\uB77C\uB294 \uAC83\uC774\uC5C8\uB2E4.\n\n\uB3C8\uC740 \uB4E4\uC5B4\uC628
        \uC801\uC774 \uC5C6\uC5C8\uB2E4. \uACBD\uCC30\uC5D0 \uB530\uB974\uBA74 \uC774\uB4E4\uC740
        \uC120\uC785\uAE08\uC744 \uBC1B\uC73C\uB824\uACE0 \uACC4\uC88C\uBC88\uD638\uB97C
        \uC54C\uB824 \uC900 \uD310\uB9E4\uC790\uB97C \uACE8\uB77C, \uB204\uAD70\uAC00
        \uC804\uD654\uB85C \uC6B8\uACE0 \uC788\uB294 \uB3D9\uC548\uC5D0\uB294 \uC740\uD589
        \uC571\uC744 \uC5F4\uC5B4 \uBCF4\uC9C0 \uC54A\uC73C\uB9AC\uB77C\uB294 \uC810\uC744
        \uB178\uB9B0\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C \uAD00\uACC4\uC790\uB294
        \"\uC774\uCCB4\uB294 \uBA87 \uCD08\uBA74 \uB4E4\uC5B4\uC628\uB2E4\"\uBA70
        \"\uB0B4\uC5ED\uC5D0 \uC5C6\uC73C\uBA74 \uBCF4\uB0B8 \uC801\uC774 \uC5C6\uB294
        \uAC83\uC774\uB2E4. \uBB54\uAC00\uB97C '\uB3CC\uB824\uC8FC\uAE30' \uC804\uC5D0
        \uBA3C\uC800 \uD655\uC778\uD558\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uB05D\uB0B4
        \uB2F5\uC744 \uD558\uC9C0 \uC54A\uC558\uB2E4. \uC740\uD589 \uB0B4\uC5ED\uB9CC
        \uD55C \uBC88 \uBD24\uC5B4\uB3C4 \uC54C \uC218 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: 918ff577f9e0b4ba0a7b7cf58b25fee0, type: 3}
    ruleTitle: "'\uB354 \uBCF4\uB0C8\uC5B4\uC694'? \uD1B5\uC7A5\uBD80\uD130 \uC5F4\uC5B4\uB77C"
    rule: "\uC798\uBABB \uBCF4\uB0B8 \uB3C8\uC744 \uB3CC\uB824 \uB2EC\uB77C\uB294
      \uB9D0\uC744 \uB4E4\uC73C\uBA74 \uBA3C\uC800 \uB0B4 \uC740\uD589 \uB0B4\uC5ED\uC744
      \uC5F4\uC5B4 \uBCF4\uB77C. \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC740 \uB3C8\uC740
      \uB3CC\uB824\uC904 \uC218 \uC5C6\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 7\uC77C"
  - id: sale_legit
    scenario: sale
    intro: "\uC218\uC5C5\uC740 \uB05D\uB0AC\uB2E4. \uC4F0\uB358 \uBAA8\uB2C8\uD130\uB294
      \uC774\uC6C3\uB9C8\uCF13\uC5D0\uC11C \uD314\uB838\uB2E4. \uAD6C\uB9E4\uC790\uAC00
      \uC624\uB298 6\uB9CC \uC6D0\uC744 \uBCF4\uB0B4\uACE0 \uD1A0\uC694\uC77C\uC5D0
      \uAC00\uC9C0\uB7EC \uC628\uB2E4."
    conversation: {fileID: 11400000, guid: 83d7f8d12c52a40518a1fe7b3f187583, type: 2}
