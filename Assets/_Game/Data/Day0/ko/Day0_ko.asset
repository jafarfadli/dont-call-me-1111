    ruleTitle: "\uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uD655\uC778\uD558\uB77C"
    rule: "\uC804\uD654 \uAC74 \uC0AC\uB78C\uC758 \uB9D0\uC740 \uB9D0\uC77C \uBFD0\uC774\uB2E4.
