  startTime: 14:10
  intro: "\uC6D4\uC694\uC77C \uB300\uCCB4\uACF5\uD734\uC77C, \uD63C\uC790 \uC0B4\uBA70
    \uB9DE\uB294 \uCCAB \uAC00\uC744. \uCCAB \uC804\uD654\uB294 \uC5F0\uC2B5\uC774\uB2E4.
    \uB178\uB780 \uBA54\uBAA8\uAC00 \uD655\uC778\uD560 \uACF3\uC744 \uD558\uB098\uC529
    \uC54C\uB824 \uC900\uB2E4."
  ringDelay: 7
  variants:
  - id: scam
    conversation: {fileID: 11400000, guid: 9fd23ecec009142dc92086b55fc1d552, type: 2}
    phone: {fileID: 11400000, guid: f84613638ebc948639bfb289f7986fa3, type: 2}
    room: {fileID: 11400000, guid: 9ccc3ce7889754f5e852e4b1e2615af0, type: 2}
    directory: {fileID: 11400000, guid: 78d352a964c0f4528a02aaacf7ce6f04, type: 2}
    clues:
    - id: paper
      text: "\uC624\uB298 \uC2E0\uBB38\uC774 \uBC14\uB85C \uC774 \uC218\uBC95\uC744
        \uACBD\uACE0\uD55C\uB2E4. \uC694\uAE08\uC774 \uBBF8\uB0A9\uB410\uB2E4\uBA70
        \uC774\uCCB4\uB97C \uC694\uAD6C\uD558\uB294 \uC804\uD654."
      where: "\uCC45\uC0C1 \uC704 \uC2E0\uBB38"
      guide: "\uB9E4\uC77C \uC544\uCE68 \uC2E0\uBB38\uC5D0\uB294 \uC694\uC998 \uB3C4\uB294
        \uC218\uBC95\uC774 \uC2E4\uB9B0\uB2E4. \uCC45\uC0C1 \uC704 \uC2E0\uBB38\uC744
        \uD074\uB9AD\uD558\uC138\uC694."
      when:
      - kind: 0
        target: Newspaper
    - id: caller_number
      text: "\uBC1C\uC2E0 \uBC88\uD638\uB294 3\uC77C \uC804 \uAC1C\uD1B5\uB41C \uC120\uBD88\uD3F0\uC774\uACE0
        \uC0AC\uAE30 \uC2E0\uACE0\uAC00 4\uAC74 \uC788\uB2E4. \uAC00\uC2A4 \uD68C\uC0AC
        \uBC88\uD638\uAC00 \uC544\uB2C8\uB2E4."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uC804\uD654\uBC88\uD638 \uC870\uD68C"
      guide: "\uCEF4\uD4E8\uD130\uB85C \uADF8 \uBC88\uD638\uC758 \uC9C4\uC9DC \uC8FC\uC778\uC744
        \uBCFC \uC218 \uC788\uB2E4. \uBE5B\uB098\uB294 \uB178\uD2B8\uBD81\uC744 \uD074\uB9AD\uD55C
        \uB4A4, '\uC804\uD654\uBC88\uD638 \uC870\uD68C'\uC5D0\uC11C \uC0C1\uB300\uC758
        \uBC88\uD638\uB97C \uD074\uB9AD\uD558\uC138\uC694."
      when:
      - kind: 2
        target: 010-7359-2046
    - id: account_owner
      text: "'\uC218\uB0A9 \uACC4\uC88C'\uC758 \uC608\uAE08\uC8FC\uB294 \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uAC00
        \uC544\uB2C8\uB77C \uAC1C\uC778 '\uD55C\uC131\uBBFC'\uC774\uB2E4."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uACC4\uC88C \uC870\uD68C"
      guide: "\uCEF4\uD4E8\uD130\uB85C \uB204\uAD6C \uACC4\uC88C\uC778\uC9C0\uB3C4
        \uC54C \uC218 \uC788\uB2E4. \uB178\uD2B8\uBD81\uC744 \uD074\uB9AD\uD558\uACE0
        '\uACC4\uC88C \uC870\uD68C'\uB97C \uACE0\uB978 \uB4A4, \uC0C1\uB300\uAC00
        \uBD88\uB7EC \uC900 \uACC4\uC88C\uB97C \uD074\uB9AD\uD558\uC138\uC694."
      when:
      - kind: 2
        target: 620-339-104772
      - kind: 3
        target: 620-339-104772
    - id: bill
      text: "\uC11C\uB78D \uC18D \uAC00\uC2A4 \uACE0\uC9C0\uC11C\uC5D0\uB294 '\uB0A9\uBD80\uC644\uB8CC'
        \uB3C4\uC7A5\uC774 \uCC0D\uD600 \uC788\uACE0(9\uC6D4 28\uC77C \uC790\uB3D9\uC774\uCCB4),
        \uD68C\uC0AC\uC758 \uC9C4\uC9DC \uBC88\uD638\uB294 02-555-0181\uC774\uB2E4."
      where: "\uCC45\uC0C1 \uC11C\uB78D \u2192 \uB3C4\uC2DC\uAC00\uC2A4 \uACE0\uC9C0\uC11C"
      guide: "\uB0B4 \uC11C\uB958\uB294 \uCC45\uC0C1 \uC11C\uB78D\uC5D0 \uC788\uB2E4.
        \uC11C\uB78D\uC744 \uC5F4\uACE0 \uAC00\uC2A4 \uACE0\uC9C0\uC11C\uB97C \uCC3E\uC544\uBCF4\uC138\uC694."
      when:
      - kind: 1
        target: "\uB3C4\uC2DC\uAC00\uC2A4 \uACE0\uC9C0\uC11C \xB7 9\uC6D4"
    - id: calendar
      text: "\uB2EC\uB825\uC744 \uBCF4\uB2C8 \uC624\uB298\uC740 \uB300\uCCB4\uACF5\uD734\uC77C\uC774\uB2E4.
        \uD68C\uC0AC\uB4E4\uC774 \uC26C\uB294 \uB0A0\uC778\uB370 '\uAC00\uC2A4 \uD68C\uC0AC'\uC5D0\uC11C
        \uC804\uD654\uAC00 \uC654\uB2E4."
      where: "\uBCBD\uC5D0 \uAC78\uB9B0 \uB2EC\uB825"
      guide: "\uBCBD\uC5D0 \uAC78\uB9B0 \uB2EC\uB825\uC5D0\uB294 \uC624\uB298\uC774
        \uBB34\uC2A8 \uB0A0\uC778\uC9C0, \uB0B4\uAC00 \uC801\uC5B4 \uB454 \uC77C\uC815\uC774
        \uC788\uB2E4. \uB2EC\uB825\uC744 \uD074\uB9AD\uD558\uC138\uC694."
      when:
      - kind: 0
        target: Calendar
    - id: bank
      text: "\uC740\uD589 \uB0B4\uC5ED\uC5D0 9\uC6D4 28\uC77C \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uB85C
        18,420\uC6D0\uC774 \uB098\uAC04 \uAE30\uB85D\uC774 \uC788\uB2E4. \uC694\uAE08\uC740
        \uC774\uBBF8 \uB0C8\uB2E4."
      where: "\uD734\uB300\uD3F0 \u2192 \uB204\uB9AC\uC740\uD589"
      guide: "\uC740\uD589 \uC571\uC5D0\uC11C \uC2E4\uC81C\uB85C \uBE60\uC838\uB098\uAC04
        \uB3C8\uC744 \uBCFC \uC218 \uC788\uB2E4. \uD734\uB300\uD3F0\uC5D0\uC11C '\uC571'\uC744
        \uB204\uB978 \uB4A4 \uB204\uB9AC\uC740\uD589\uC744 \uC5EC\uC138\uC694."
      when:
      - kind: 5
        target: 
    - id: chat
      text: "\uC785\uC8FC\uBBFC \uCC44\uD305\uBC29\uC5D0\uC11C \uC9D1\uC8FC\uC778\uC774
        \uBAA8\uB450\uC5D0\uAC8C \uACBD\uACE0\uD588\uB2E4. \uAC00\uC2A4 \uD68C\uC0AC\uB294
        \uC804\uD654\uB85C \uB3C8\uC744 \uC694\uAD6C\uD558\uC9C0 \uC54A\uB294\uB2E4\uACE0."
      where: "\uCC44\uD305 \u2192 \uB9DD\uC6D0\uD558\uC774\uCE20 \uC785\uC8FC\uBBFC"
      guide: "\uC544\uB294 \uC0AC\uB78C\uB4E4\uC740 \uC9C1\uC811 \uAE00\uC744 \uB0A8\uAE34\uB2E4.
        '\uC571'\uC73C\uB85C \uB3CC\uC544\uAC00 '\uCC44\uD305'\uC744 \uC5F4\uACE0
        \uC785\uC8FC\uBBFC \uCC44\uD305\uBC29\uC744 \uC77D\uC5B4 \uBCF4\uC138\uC694."
      when:
      - kind: 4
        target: villa
    - id: contacts
      text: "\uC0C1\uB300\uB294 \uC5F0\uB77D\uCC98\uC5D0 \uC5C6\uB294 \uBC88\uD638\uB2E4.
        \uC800\uC7A5\uB41C \uBC88\uD638\uB77C\uBA74 \uC804\uD654\uAC00 \uC62C \uB54C
        \uC774\uB984\uC774 \uB72C\uB2E4."
      where: "\uD734\uB300\uD3F0 \u2192 \uC5F0\uB77D\uCC98"
      guide: "\uC800\uC7A5\uB41C \uBC88\uD638\uB294 \uC804\uD654\uAC00 \uC62C \uB54C
        \uC774\uB984\uC774 \uB72C\uB2E4. '\uC571'\uC73C\uB85C \uB3CC\uC544\uAC00
        '\uC5F0\uB77D\uCC98'\uB97C \uC5F4\uC5B4 \uBCF4\uC138\uC694. \uC0C1\uB300\uAC00
        \uC788\uB098\uC694?"
      when:
      - kind: 6
        target: 
    papers:
    - outcome: 1
      headline: "\uACF5\uD734\uC77C '\uAC00\uC2A4 \uC694\uAE08' \uC804\uD654\uB294
        \uAC00\uC9DC\uC600\uB2E4"
      subhead: "\uACE0\uC9C0\uC11C\uC640 \uC740\uD589 \uB0B4\uC5ED\uC744 \uD655\uC778\uD55C
        \uC8FC\uBBFC\uB4E4\uC740 \uC804\uD654\uB97C \uB04A\uC5C8\uB2E4."
      body: "\uC6D4\uC694\uC77C \uB300\uCCB4\uACF5\uD734\uC77C, \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4
        \uC694\uAE08\uD300 '\uBC31 \uD300\uC7A5'\uC744 \uC790\uCE6D\uD55C \uC5EC\uC131\uC774
        \uB9DD\uC6D0\uB3D9 \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4.
        \uADF8\uB294 9\uC6D4 \uAC00\uC2A4 \uC694\uAE08\uC774 \uBBF8\uB0A9\uB410\uB2E4\uBA70
        \uB2F9\uC7A5 \uC774\uCCB4\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC624\uD6C4 5\uC2DC\uC5D0
        \uAC00\uC2A4\uAC00 \uB04A\uAE34\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\n\n\uC804\uD654\uB97C
        \uBC1B\uC740 \uC8FC\uBBFC \uB300\uBD80\uBD84\uC740 \uC774\uBBF8 \uC790\uB3D9\uC774\uCCB4\uB85C
        \uC694\uAE08\uC744 \uB0B8 \uC0C1\uD0DC\uC600\uB2E4. \uACBD\uCC30\uC5D0 \uB530\uB974\uBA74
        \uC0C1\uB300\uAC00 \uBD88\uB7EC \uC900 \uD55C\uBE5B\uC740\uD589 620-339-104772
        \uACC4\uC88C\uB294 \uC870\uC9C1\uC5D0 \uD1B5\uC7A5\uC744 \uD310 20\uB300
        \uB0A8\uC131\uC758 \uBA85\uC758\uB2E4. 010-7359-2046\uC73C\uB85C \uC804\uD654\uB97C
        \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uB098 \uAE08\uC735\uAC10\uB3C5\uC6D0
        1332\uC5D0 \uC2E0\uACE0\uD558\uBA74 \uB41C\uB2E4.\n\n\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uB294
        \"\uC804\uD654\uB85C \uC694\uAE08\uC744 \uAC77\uC9C0 \uC54A\uC73C\uBA70,
        \uADF8\uB0A0\uC740 \uACF5\uD734\uC77C\uC774\uB77C \uC0AC\uBB34\uC2E4\uB3C4
        \uC26C\uC5C8\uB2E4\"\uBA70 \"\uD68C\uC0AC \uBC88\uD638\uB294 \uACE0\uC9C0\uC11C\uC5D0
        \uC801\uD78C 02-555-0181 \uD558\uB098\uBFD0\"\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uC694\uAE08\uC740 9\uC6D4
        28\uC77C\uC5D0 \uC774\uBBF8 \uB0A9\uBD80\uB410\uACE0, \uACC4\uC88C\uB294
        \uBAA8\uB974\uB294 \uC0AC\uB78C \uAC83\uC774\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: b3755999e6adc48a3ba3a18302c89d96, type: 3}
    - outcome: 0
      headline: "\uB450 \uBC88 \uB0B8 \uAC00\uC2A4 \uC694\uAE08"
      subhead: "\uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD, \uACF5\uD734\uC77C\uC5D0 \uBAA8\uB974\uB294
        \uC0AC\uB78C\uC5D0\uAC8C 18,420\uC6D0 \uC1A1\uAE08"
      body: "\uC6D4\uC694\uC77C \uB300\uCCB4\uACF5\uD734\uC77C, \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4
        \uC694\uAE08\uD300 '\uBC31 \uD300\uC7A5'\uC744 \uC790\uCE6D\uD55C \uC5EC\uC131\uC774
        \uB9DD\uC6D0\uB3D9 \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4.
        \uADF8\uB294 9\uC6D4 \uAC00\uC2A4 \uC694\uAE08\uC774 \uBBF8\uB0A9\uB410\uB2E4\uBA70
        \uB2F9\uC7A5 \uC774\uCCB4\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC624\uD6C4 5\uC2DC\uC5D0
        \uAC00\uC2A4\uAC00 \uB04A\uAE34\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\n\n22\uC138
        \uB300\uD559\uC0DD \uD55C \uBA85\uC740 \uB3C8\uC744 \uBCF4\uB0C8\uB2E4. \uC9C4\uC9DC
        \uC694\uAE08\uC740 \uC77C\uC8FC\uC77C \uC804 \uC790\uB3D9\uC774\uCCB4\uB85C
        \uC774\uBBF8 \uB0A9\uBD80\uB41C \uC0C1\uD0DC\uC600\uB2E4. 18,420\uC6D0\uC740
        \uD55C\uC131\uBBFC \uBA85\uC758 \uACC4\uC88C\uB85C \uB4E4\uC5B4\uAC00 \uBA87
        \uBD84 \uB9CC\uC5D0 \uC0AC\uB77C\uC84C\uB2E4. \uACBD\uCC30 \uAD00\uACC4\uC790\uB294
        \"\uC18C\uC561\uC740 \uB204\uAC00 \uB3C8\uC744 \uBCF4\uB0B4\uB294\uC9C0 \uB5A0\uBCF4\uB294
        \uC218\uBC95\"\uC774\uB77C\uBA70 \"\uB2E4\uC74C \uC804\uD654\uB294 \uB354
        \uD070\uB3C8\uC744 \uC694\uAD6C\uD55C\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uB294
        \"\uC804\uD654\uB85C \uC694\uAE08\uC744 \uAC77\uC9C0 \uC54A\uC73C\uBA70,
        \uADF8\uB0A0\uC740 \uACF5\uD734\uC77C\uC774\uB77C \uC0AC\uBB34\uC2E4\uB3C4
        \uC26C\uC5C8\uB2E4\"\uBA70 \"\uD68C\uC0AC \uBC88\uD638\uB294 \uACE0\uC9C0\uC11C\uC5D0
        \uC801\uD78C 02-555-0181 \uD558\uB098\uBFD0\"\uC774\uB77C\uACE0 \uBC1D\uD614\uB2E4."
      verdictNote: "\uC694\uAE08\uC740 \uC774\uBBF8 \uB0B8 \uC0C1\uD0DC\uC600\uB2E4.
        \uC11C\uB78D, \uC740\uD589 \uC571, \uCEF4\uD4E8\uD130\uAC00 \uBAA8\uB450
        \uADF8\uB807\uAC8C \uB9D0\uD558\uACE0 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: b60175459ba6145df9eca78667094034, type: 3}
    - outcome: 3
      headline: "\uACF5\uD734\uC77C \uB0B4\uB0B4 \uC774\uC5B4\uC9C4 \uAC00\uC9DC
        '\uAC00\uC2A4 \uC694\uAE08' \uC804\uD654"
      subhead: "\uAC00\uC2A4\uB294 \uB04A\uAE30\uC9C0 \uC54A\uC558\uB2E4. \uC2E0\uACE0\uB294
        \uC801\uC5C8\uB2E4."
      body: "\uC6D4\uC694\uC77C \uB300\uCCB4\uACF5\uD734\uC77C, \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4
        \uC694\uAE08\uD300 '\uBC31 \uD300\uC7A5'\uC744 \uC790\uCE6D\uD55C \uC5EC\uC131\uC774
        \uB9DD\uC6D0\uB3D9 \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4.
        \uADF8\uB294 9\uC6D4 \uAC00\uC2A4 \uC694\uAE08\uC774 \uBBF8\uB0A9\uB410\uB2E4\uBA70
        \uB2F9\uC7A5 \uC774\uCCB4\uD558\uC9C0 \uC54A\uC73C\uBA74 \uC624\uD6C4 5\uC2DC\uC5D0
        \uAC00\uC2A4\uAC00 \uB04A\uAE34\uB2E4\uACE0 \uB9D0\uD588\uB2E4.\n\n\uC624\uD6C4
        5\uC2DC\uAC00 \uC9C0\uB0AC\uC9C0\uB9CC \uAC00\uC2A4\uAC00 \uB04A\uAE34 \uC9D1\uC740
        \uC5C6\uC5C8\uB2E4. \uACBD\uCC30\uC740 \uC0C1\uB300\uAC00 \uC800\uB141\uAE4C\uC9C0
        \uC804\uD654\uB97C \uACC4\uC18D \uAC78\uC5C8\uB2E4\uBA70, 010-7359-2046\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uB098 1332\uC5D0 \uC2E0\uACE0\uD574
        \uB2EC\uB77C\uACE0 \uB2F9\uBD80\uD588\uB2E4.\n\n\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uB294
