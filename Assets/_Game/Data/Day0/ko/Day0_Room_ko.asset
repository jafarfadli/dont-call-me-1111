  m_Script: {fileID: 11500000, guid: b53d3a7811bb8498d9ae0485fd422ad9, type: 3}
  m_Name: Day0_Room_ko
  m_EditorClassIdentifier: DontCallMe::DontCallMe.Data.RoomContent
  newspaper:
    masthead: "\uC11C\uC6B8\uB370\uC77C\uB9AC"
    issue: "\uC81C12,407\uD638"
    dateLine: "2026\uB144 10\uC6D4 5\uC77C \uC6D4\uC694\uC77C"
    price: "1,000\uC6D0"
    headline: "\"\uC9C0\uAE08 \uC548 \uB0B4\uBA74 \uAC00\uC2A4 \uB04A\uAE41\uB2C8\uB2E4\""
    subhead: "\uD63C\uC790 \uC0AC\uB294 \uC0AC\uB78C\uC744 \uB178\uB9B0 \uAC00\uC9DC
      \uC694\uAE08 \uB3C5\uCD09 \uC804\uD654. \uBA87 \uAC00\uC9C0\uB9CC \uD655\uC778\uD558\uBA74
      \uB9C9\uC744 \uC218 \uC788\uB2E4."
    photo: {fileID: 2800000, guid: 4c63c0d2cf38942db834f06de02c655f, type: 3}
    caption: "\uC774\uCCB4 \uC804, \uC740\uD589\uC740 \uB3C8\uC744 \uC2E4\uC81C\uB85C
      \uBC1B\uB294 \uC0AC\uB78C\uC744 \uBCF4\uC5EC \uC900\uB2E4. \uC0AC\uC9C4: \uC11C\uC6B8\uB370\uC77C\uB9AC"
    body:
    - "\uAC00\uC2A4\xB7\uC804\uAE30\xB7\uD1B5\uC2E0 \uD68C\uC0AC\uB97C \uC0AC\uCE6D\uD55C
      \uC804\uD654\uAC00 \uB9C8\uD3EC \uC8FC\uBBFC\uB4E4\uC5D0\uAC8C '\uC694\uAE08\uC774
      \uBBF8\uB0A9\uB410\uB2E4'\uBA70 \uB2F9\uC7A5 \uC774\uCCB4\uD558\uC9C0 \uC54A\uC73C\uBA74
      \uBA87 \uC2DC\uAC04 \uC548\uC5D0 \uACF5\uAE09\uC774 \uB04A\uAE34\uB2E4\uACE0
      \uB9D0\uD558\uACE0 \uC788\uB2E4."
    - "\uAE08\uC561\uC740 \uC720\uCD9C\uB41C \uACE0\uAC1D \uBA85\uB2E8\uC5D0\uC11C
      \uAC00\uC838\uC628 \uC9C4\uC9DC \uAE08\uC561\uC778 \uACBD\uC6B0\uAC00 \uB9CE\uB2E4.
      \uD558\uC9C0\uB9CC \uACC4\uC88C\uB294 \uAC00\uC9DC\uB2E4. \uBAA8\uB974\uB294
      \uC0AC\uB78C\uC758 \uACC4\uC88C\uC774\uACE0, \uB3C8\uC740 \uBA87 \uBD84 \uB9CC\uC5D0
      \uC0AC\uB77C\uC9C4\uB2E4."
    - "\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4 \uAD00\uACC4\uC790\uB294 \"\uC804\uD654\uB85C
      \uC694\uAE08\uC744 \uAC77\uB294 \uC77C\uC740 \uC5C6\uACE0, \uACF5\uD734\uC77C\uC5D0\uB294
      \uB354\uB354\uC6B1 \uC5C6\uB2E4\"\uBA70 \"\uACE0\uC9C0\uC11C\uC640 \uC740\uD589
      \uB0B4\uC5ED\uC744 \uBCF4\uACE0, \uADF8 \uBC88\uD638\uC640 \uACC4\uC88C\uC758
      \uC8FC\uC778\uC744 \uC870\uD68C\uD574 \uBCF4\uB77C. \uCCB4\uD06C\uD37C\uC2A4\uD2B8(checkfirst.kr)\uC5D0\uC11C
      2\uBD84\uC774\uBA74 \uB41C\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4."
    warningTitle: "\uACBD\uACE0: \uC804\uD654\uB85C \uC694\uAE08\uC744 \uAC77\uB294
      \uACF3\uC740 \uC5C6\uB2E4"
    warningText: "\uAC00\uC2A4\xB7\uC804\uAE30\xB7\uD1B5\uC2E0 \uD68C\uC0AC\uB294
      \uACE0\uC9C0\uC11C\uB97C \uBCF4\uB0B8\uB2E4. \uC804\uD654\uB85C \uC774\uCCB4\uB97C
      \uC694\uAD6C\uD558\uC9C0 \uC54A\uB294\uB2E4. \uB3C8\uC744 \uBCF4\uB0B4\uAE30
      \uC804\uC5D0 \uADF8 \uBC88\uD638\uC640 \uACC4\uC88C\uC758 \uC8FC\uC778\uC774
      \uB204\uAD6C\uC778\uC9C0, \uB0B4 \uACE0\uC9C0\uC11C\uC640 \uC740\uD589 \uB0B4\uC5ED\uC740
      \uBB50\uB77C\uACE0 \uD558\uB294\uC9C0, \uC544\uB294 \uC0AC\uB78C\uB4E4\uC774
      \uBB50\uB77C\uACE0 \uC37C\uB294\uC9C0 \uD655\uC778\uD558\uB77C."
    print: {fileID: 2800000, guid: 54de0085ac7c14fe6a5395effe2ce784, type: 3}
    local:
    - title: "\uC624\uB298\uC740 \uB300\uCCB4\uACF5\uD734\uC77C"
      text: "\uC740\uD589, \uAD00\uACF5\uC11C, \uACE0\uAC1D\uC13C\uD130\uB294 \uB300\uCCB4\uACF5\uD734\uC77C\uB85C
        \uC270\uB2E4. \uD654\uC694\uC77C\uC5D0 \uB2E4\uC2DC \uBB38\uC744 \uC5F0\uB2E4."
    - title: "\uB2E4\uC74C \uC8FC \uAC00\uC2A4 \uC810\uAC80"
      text: "\uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4\uAC00 12\uC77C\uBD80\uD130 \uB9DD\uC6D0\uB3D9
        \uBE4C\uB77C\uB97C \uC810\uAC80\uD55C\uB2E4. \uC810\uAC80\uC6D0\uC740 \uC2E0\uBD84\uC99D\uC744
        \uC9C0\uB2C8\uBA70 \uB3C8\uC744 \uBC1B\uC9C0 \uC54A\uB294\uB2E4."
    - title: "\uC9C0\uD558\uCCA0 \uC694\uAE08"
      text: "\uAE30\uBCF8\uC694\uAE08 1,550\uC6D0\uC774 \uC5F0\uB9D0\uAE4C\uC9C0
        \uC720\uC9C0\uB41C\uB2E4."
    ads:
    - title: "24\uC2DC \uCE58\uD0A8"
      text: "\uD6C4\uB77C\uC774\uB4DC & \uAC04\uC7A5\uB9C8\uB298. 2\uB9CC \uC6D0
        \uC774\uC0C1 \uBB34\uB8CC \uBC30\uB2EC. 02-555-0147"
    - title: "\uCCB4\uD06C\uD37C\uC2A4\uD2B8"
      text: "\uADF8 \uBC88\uD638\uC758 \uC8FC\uC778\uC740? \uADF8 \uACC4\uC88C\uC758
        \uC608\uAE08\uC8FC\uB294? \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uC870\uD68C\uD558\uC138\uC694.
        checkfirst.kr"
    - title: "\uD55C\uBE5B\uD559\uC6D0"
      text: "\uD1A0\uC775 \uC8FC\uB9D0\uBC18, \uB300\uD559\uC0DD 30% \uD560\uC778.
        02-555-0166"
  drawer:
  - title: "\uC784\uB300\uCC28 \uACC4\uC57D\uC11C \xB7 302\uD638"
