%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f2f8368b1b9ac41d69683bc5fd96d5d7, type: 3}
  m_Name: VoiceBank
  m_EditorClassIdentifier: DontCallMe::DontCallMe.Data.VoiceBank
  entries:
  - voice: Samantha
    text: Hello, is this Kim Jiwoo at Mangwon Heights three oh two? This is Team
      Leader Baek from the billing team at Mapo City Gas.
    clip: {fileID: 8300000, guid: 113c2bd5c46794be389dade735e40f59, type: 3}
  - voice: Samantha
    text: Your September gas bill, eighteen thousand, four hundred and twenty won,
      has not been paid. The gas to your unit will be shut off at five o'clock today.
    clip: {fileID: 8300000, guid: c49af7378597b4447a5f40b4eb750191, type: 3}
  - voice: Samantha
    text: Ma'am? Can you hear me?
    clip: {fileID: 8300000, guid: 0c3802ab58270432c8746d157beb00e5, type: 3}
  - voice: Samantha
    text: The auto-payment failed, ma'am. It happens when a bank updates its system.
    clip: {fileID: 8300000, guid: 41b5d6b5c294648208e03d921fb9dd00, type: 3}
  - voice: Samantha
    text: The shut-off is automatic, ma'am. The system doesn't take holidays.
    clip: {fileID: 8300000, guid: a320d0406b0fd4def80330dbdb798fab, type: 3}
  - voice: Samantha
    text: To stop it, please transfer eighteen thousand, four hundred and twenty
      won to our collection account. Hanbit Bank, six two zero, three three nine,
      one zero four seven seven two.
    clip: {fileID: 8300000, guid: 8388a2b3821464a9592aa62fa21d44c2, type: 3}
  - voice: Samantha
    text: As soon as it arrives, I'll cancel the shut-off. I'll stay on the line
      while you send it.
    clip: {fileID: 8300000, guid: 4ea258cd92d754b459dd989e92e66937, type: 3}
  - voice: Samantha
    text: It's our collection officer's, Han Sungmin. On a holiday, payments go through
      his account.
    clip: {fileID: 8300000, guid: 7a6620192797f4fef96ce3dca4ac3875, type: 3}
  - voice: Samantha
    text: The centre is closed today, ma'am, so I'm calling from my work mobile.
    clip: {fileID: 8300000, guid: e4b32753acb1e43ee9274aee3b0af12c, type: 3}
  - voice: Samantha
    text: Of course, ma'am, but please be quick. The shut-off order is already in
      the system.
    clip: {fileID: 8300000, guid: 43aaa51c39b6944ef983976a4b63619a, type: 3}
  - voice: Samantha
    text: Ma'am? Are you still there?
    clip: {fileID: 8300000, guid: b48f255665e854157968ff3bd1384ffa, type: 3}
  - voice: Samantha
    text: I'm still holding, ma'am. The shut-off is set for five.
    clip: {fileID: 8300000, guid: 06fe30358927e47bebfc6cfe9aa8ab8a, type: 3}
  - voice: Samantha
    text: One hour left, ma'am. After that I can't stop it.
    clip: {fileID: 8300000, guid: 31ad30d241e5644bfa071a2650b2b02b, type: 3}
  - voice: Samantha
    text: Twenty minutes. Please send it now.
    clip: {fileID: 8300000, guid: 3a4c3b2519ea24f96aaddabe5daed67e, type: 3}
  - voice: Samantha
    text: Five minutes, ma'am!
    clip: {fileID: 8300000, guid: 5bdd5251c97fa4b66966966bbbc46cbf, type: 3}
  - voice: Samantha
    text: It's five o'clock, ma'am.
    clip: {fileID: 8300000, guid: f83cfde847d224ee5a2eb6dac5d2f994, type: 3}
  - voice: Samantha
    text: Fine. Don't blame us when the gas goes off.
    clip: {fileID: 8300000, guid: 687adf22512f941fdb1e58a1ba173474, type: 3}
  - voice: Samantha
    text: Thank you, ma'am. I've cancelled the shut-off.
    clip: {fileID: 8300000, guid: 9f0ba2069a6744044b84cd3ee01b7da9, type: 3}
  - voice: Samantha
    text: Enjoy the rest of your holiday.
    clip: {fileID: 8300000, guid: 60285298ab6fa4baab3d493b918b497f, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694, \uB9DD\uC6D0\uD558\uC774\uCE20 \uC0BC\uBC31\uC774
      \uD638 \uAE40\uC9C0\uC6B0 \uACE0\uAC1D\uB2D8 \uB9DE\uC73C\uC2DC\uC8E0? \uB9C8\uD3EC\uB3C4\uC2DC\uAC00\uC2A4
      \uC694\uAE08\uD300 \uBC31 \uD300\uC7A5\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 7893979b8b42e4ee7bf86e41d907f2f5, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uAD6C\uC6D4 \uAC00\uC2A4 \uC694\uAE08 \uB9CC \uD314\uCC9C\uC0AC\uBC31\uC774\uC2ED
      \uC6D0\uC774 \uBBF8\uB0A9 \uC0C1\uD0DC\uC785\uB2C8\uB2E4. \uC624\uB298 \uC624\uD6C4
      \uB2E4\uC12F \uC2DC\uC5D0 \uB301\uC758 \uAC00\uC2A4 \uACF5\uAE09\uC774 \uCC28\uB2E8\uB420
      \uC608\uC815\uC774\uC5D0\uC694."
    clip: {fileID: 8300000, guid: 2ae23b290ced34e72bfc394cc2b276af, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uACE0\uAC1D\uB2D8? \uB4E4\uB9AC\uC138\uC694?"
    clip: {fileID: 8300000, guid: 926ba313e426949a5b823e789e1ec369, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC790\uB3D9\uC774\uCCB4\uAC00 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4, \uACE0\uAC1D\uB2D8.
      \uC740\uD589 \uC804\uC0B0 \uC810\uAC80 \uB54C \uC885\uC885 \uADF8\uB798\uC694."
    clip: {fileID: 8300000, guid: 8b29aa57bd9c140ce877e7266c0e699e, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uCC28\uB2E8\uC740 \uC790\uB3D9\uC73C\uB85C \uC9C4\uD589\uB429\uB2C8\uB2E4,
      \uACE0\uAC1D\uB2D8. \uC804\uC0B0\uC740 \uACF5\uD734\uC77C\uC5D0\uB3C4 \uB3CC\uC544\uAC00\uAC70\uB4E0\uC694."
    clip: {fileID: 8300000, guid: 7ad5b2ca612e14dcf9e9966557495732, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uCC28\uB2E8\uC744 \uB9C9\uC73C\uB824\uBA74 \uC218\uB0A9 \uACC4\uC88C\uB85C
      \uB9CC \uD314\uCC9C\uC0AC\uBC31\uC774\uC2ED \uC6D0\uC744 \uC774\uCCB4\uD574
      \uC8FC\uC138\uC694. \uD55C\uBE5B\uC740\uD589, \uC721\uC774\uACF5, \uC0BC\uC0BC\uAD6C,
      \uC77C\uACF5\uC0AC\uCE60\uCE60\uC774\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 77fd25d5d4c4048fd8f39a650e637b1f, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC785\uAE08\uC774 \uD655\uC778\uB418\uB294 \uB300\uB85C \uCC28\uB2E8\uC744
      \uCDE8\uC18C\uD574 \uB4DC\uB9B4\uAC8C\uC694. \uBCF4\uB0B4\uC2DC\uB294 \uB3D9\uC548
      \uAE30\uB2E4\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: f44d72b3829d6494dbb5af2dd0a46dc6, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC218\uB0A9 \uB2F4\uB2F9\uC790 \uD55C\uC131\uBBFC \uBA85\uC758\uC785\uB2C8\uB2E4.
      \uACF5\uD734\uC77C\uC5D0\uB294 \uB2F4\uB2F9\uC790 \uACC4\uC88C\uB85C \uBC1B\uACE0
      \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: ec2afaaae0c8e4d4ea828ba792cf9d44, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC624\uB298\uC740 \uACE0\uAC1D\uC13C\uD130\uAC00 \uC26C\uB294 \uB0A0\uC774\uB77C
      \uC5C5\uBB34\uC6A9 \uD734\uB300\uD3F0\uC73C\uB85C \uC5F0\uB77D\uB4DC\uB838\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 9f3794a419e7441b6bba3d9f507aee40, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uB124, \uD655\uC778\uD558\uC138\uC694. \uD558\uC9C0\uB9CC \uC11C\uB458\uB7EC
      \uC8FC\uC154\uC57C \uD574\uC694. \uCC28\uB2E8 \uC811\uC218\uAC00 \uC774\uBBF8
      \uB4E4\uC5B4\uAC00 \uC788\uC5B4\uC11C\uC694."
    clip: {fileID: 8300000, guid: db2467fb22b084524a6f47db9c2f450f, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uACE0\uAC1D\uB2D8? \uB4E3\uACE0 \uACC4\uC138\uC694?"
    clip: {fileID: 8300000, guid: a1c89712804c741328c4ebfdcf662759, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC544\uC9C1 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uCC28\uB2E8\uC740
      \uB2E4\uC12F \uC2DC\uB85C \uC7A1\uD600 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: e6711734673ca4792b949bca665ade92, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uD55C \uC2DC\uAC04 \uB0A8\uC558\uC2B5\uB2C8\uB2E4. \uADF8 \uB4A4\uC5D4
      \uC800\uB3C4 \uB9C9\uC744 \uC218 \uC5C6\uC5B4\uC694."
    clip: {fileID: 8300000, guid: c5e66850e415249a097d84e1db80e3b9, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC774\uC2ED \uBD84 \uB0A8\uC558\uC5B4\uC694. \uC9C0\uAE08 \uBCF4\uB0B4
      \uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: fdd60d160975b4619977c2ee3fde96f7, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC624 \uBD84 \uB0A8\uC558\uC2B5\uB2C8\uB2E4!"
    clip: {fileID: 8300000, guid: 343254da0133c4dd78087a3a97a01621, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uAC00 \uB410\uC2B5\uB2C8\uB2E4, \uACE0\uAC1D\uB2D8."
    clip: {fileID: 8300000, guid: 1e8dc708e536b4a918eb51e6536ebe2a, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uAC00\uC2A4\uAC00 \uB04A\uACA8\uB3C4
      \uC800\uD76C \uD0D3\uC740 \uD558\uC9C0 \uB9C8\uC138\uC694."
    clip: {fileID: 8300000, guid: 018566113969a445ba5186d322a3eead, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4, \uACE0\uAC1D\uB2D8. \uCC28\uB2E8\uC740
      \uCDE8\uC18C\uD574 \uB4DC\uB838\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 3dd280eebc3f54397bf123a7ca9de228, type: 3}
  - voice: Sandy (Korean (South Korea))
    text: "\uB0A8\uC740 \uC5F0\uD734 \uC798 \uBCF4\uB0B4\uC138\uC694."
    clip: {fileID: 8300000, guid: 3bfb748ec3a174dd6be5f5c449d23f8f, type: 3}
  - voice: Daniel
    text: Hello, is this Kim Jiwoo? This is Manager Jeon from Nuri Bank's account
      protection team.
    clip: {fileID: 8300000, guid: d078868c395d34b7ea2860d613c9b9c6, type: 3}
  - voice: Daniel
    text: Twenty minutes ago, someone logged into your account from an unregistered
      device in Busan.
    clip: {fileID: 8300000, guid: 0a7e80bdc683e428db272aa3be0b6970, type: 3}
  - voice: Daniel
    text: Miss Kim? Are you still there? This is urgent.
    clip: {fileID: 8300000, guid: d547d6aa3953447f98fb1c0359445aba, type: 3}
  - voice: Daniel
    text: That's exactly why I'm calling. A fraud ring is emptying accounts in Mapo
      today, and yours is on their list.
    clip: {fileID: 8300000, guid: 51a6eb7e024a04272b0be85f36933d24, type: 3}
  - voice: Daniel
    text: I have your account ending in eight, eight, one, four on my screen, Miss
      Kim.
    clip: {fileID: 8300000, guid: 24f0c83a445a94aa5b3516c4958ecf65, type: 3}
  - voice: Daniel
    text: We're the protection team, not the call centre, so we call from our direct
      line.
    clip: {fileID: 8300000, guid: dac9b5a3ed638463aa203582ea9322bf, type: 3}
  - voice: Daniel
    text: To keep your savings safe, we'll move them to a protected account until
      the security reset at five o'clock.
    clip: {fileID: 8300000, guid: 9f6ac29610f394a8a81d5a5890523d5e, type: 3}
  - voice: Daniel
    text: Please transfer one million, two hundred thousand won to the protected
      account. Nuri Bank, one one zero, nine zero zero, five five one two zero seven.
    clip: {fileID: 8300000, guid: 80cf742f32bb64ada821071e33fdb5da, type: 3}
  - voice: Daniel
    text: Stay on the line and don't tell anyone. The fraud ring may be watching
      your messages.
    clip: {fileID: 8300000, guid: 029de3bd4f2194ae3a8d6534bc23cbfa, type: 3}
  - voice: Daniel
    text: I'll hold while you open your bank app. It has to be done before five.
    clip: {fileID: 8300000, guid: cdd4ca14774f340e28df4637b3bd8b66, type: 3}
  - voice: Daniel
    text: The call centre can't see protection cases, Miss Kim. If you hang up, the
      case closes and the fraud ring gets your money.
    clip: {fileID: 8300000, guid: f1b6fcc4c9d2b41898d644a3d24a14af, type: 3}
  - voice: Daniel
    text: Please, just stay with me.
    clip: {fileID: 8300000, guid: ec7cce6018ee047a6864544b67040985, type: 3}
  - voice: Daniel
    text: It's registered to our security officer, Jeong Miran. Protection accounts
      are always in an officer's name.
    clip: {fileID: 8300000, guid: dc2863e1c855f4e549fecbb7efba817e, type: 3}
  - voice: Daniel
    text: It's our team's direct line, Miss Kim. Every bank uses internet lines for
      calls like this.
    clip: {fileID: 8300000, guid: 3d6586e036b1648618222c30738d55aa, type: 3}
  - voice: Daniel
    text: Miss Kim? Are you still there? Please don't put me on hold for long.
    clip: {fileID: 8300000, guid: 01ecd29392dec4dbd83eb6bb1ffe61f0, type: 3}
  - voice: Daniel
    text: I've opened a protection case for you, Miss Kim, so this is official. Please
      finish the transfer.
    clip: {fileID: 8300000, guid: 4827ae1aceb5844ea8a41c85277aa7cb, type: 3}
  - voice: Daniel
    text: The fraud ring just tried to log in again. We need that transfer now, Miss
      Kim.
    clip: {fileID: 8300000, guid: e06ce5e74ffde45f6a24f3d5662c6dbe, type: 3}
  - voice: Daniel
    text: Seven minutes. After the reset I can't protect anything.
    clip: {fileID: 8300000, guid: 36cde5d20552040a0a7075270392f761, type: 3}
  - voice: Daniel
    text: Three minutes! Please, transfer it now!
    clip: {fileID: 8300000, guid: aa61aab51b870459a9e053b3740b842f, type: 3}
  - voice: Daniel
    text: Miss Kim? It's five o'clock.
    clip: {fileID: 8300000, guid: d643bf648b0df4447b30175829c32474, type: 3}
  - voice: Daniel
    text: Fine. Your account will be frozen. Don't call us when it's empty.
    clip: {fileID: 8300000, guid: de87ed9bfd6d342c885ccaec97ead434, type: 3}
  - voice: Daniel
    text: Thank you, Miss Kim. Your money is safe with us now.
    clip: {fileID: 8300000, guid: 1cb50347600914e2ebe27c8b37916749, type: 3}
  - voice: Daniel
    text: Don't tell anyone until tomorrow's reset.
    clip: {fileID: 8300000, guid: 460c12f0a69ba41e78f181fc317a8264, type: 3}
  - voice: Grandpa (English (US))
    text: Hello, is this the student in three oh two, Mangwon Heights? This is Oh
      Sangchul, the manager of the Seoul Daily's Mapo branch.
    clip: {fileID: 8300000, guid: 901c188bb718a445eb2b9e549715bc66, type: 3}
  - voice: Grandpa (English (US))
    text: Your father took out the paper for you in March and paid up to September.
      From October, the fee hasn't been paid.
    clip: {fileID: 8300000, guid: 69693a970240949dca86ae302e1ffc01, type: 3}
  - voice: Grandpa (English (US))
    text: Hello? Student? Are you there?
    clip: {fileID: 8300000, guid: 148cc2f7fe0be4f7f9ddc1b0a1c452bf, type: 3}
  - voice: Grandpa (English (US))
    text: Eighteen thousand won a month. Most readers pay three months at a time.
    clip: {fileID: 8300000, guid: 8f0e58d402e144c24972407d378fb303, type: 3}
  - voice: Grandpa (English (US))
    text: I tried him this morning and he didn't pick up. And the paper comes to
      your door, student.
    clip: {fileID: 8300000, guid: 45a8883ccb9d14631b891675d143a592, type: 3}
  - voice: Grandpa (English (US))
    text: We don't collect at the door any more. From this month it's by bank transfer,
      and I'm phoning every reader myself this week.
    clip: {fileID: 8300000, guid: f645234e384474767a5e64d4373d04f8, type: 3}
  - voice: Grandpa (English (US))
    text: October to December comes to fifty four thousand won. Please send it to
      Nuri Bank, one one zero, four five seven, eight zero three three one two. The
      account is in my name, Oh Sangchul.
    clip: {fileID: 8300000, guid: ed1ab3e978adf421180286c5977786ea, type: 3}
  - voice: Grandpa (English (US))
    text: I close the branch's books at five. Whoever hasn't paid by then comes off
      tomorrow's delivery list.
    clip: {fileID: 8300000, guid: 291fec582d5fc48b2a9365bb0032c60d, type: 3}
  - voice: Grandpa (English (US))
    text: I'll stay on the line while you send it.
    clip: {fileID: 8300000, guid: 939d16dbe076e4f5ca215c993d14eb50, type: 3}
  - voice: Grandpa (English (US))
    text: Mine. Oh Sangchul. A branch is its manager's own business, student, so
      the account is in my name.
    clip: {fileID: 8300000, guid: 341196af6218742498c0fcd2cf481261, type: 3}
  - voice: Grandpa (English (US))
    text: Head office changed it from October. It's in this morning's paper, in the
      box on the front page.
    clip: {fileID: 8300000, guid: bfa308c5a428b4ed88a8913cedd64552, type: 3}
  - voice: Grandpa (English (US))
    text: This mobile, student. It's the number printed in today's notice. zero one
      zero, eight two six five, three three one seven.
    clip: {fileID: 8300000, guid: e5d2597d940eb48889a976f9045085af, type: 3}
  - voice: Grandpa (English (US))
    text: Of course. But I close the books at five, and starting again later means
      a new sign-up.
    clip: {fileID: 8300000, guid: 21a463631479b45d8b0db14039fff7d9, type: 3}
  - voice: Grandpa (English (US))
    text: Student? Still there? Take your time, but I do close at five.
    clip: {fileID: 8300000, guid: 800fa4836aa7541be832437de96c41eb, type: 3}
  - voice: Grandpa (English (US))
    text: I have forty more readers to call today. Has it gone through?
    clip: {fileID: 8300000, guid: d8255d64ba691443c8f42ed5518a4d40, type: 3}
  - voice: Grandpa (English (US))
    text: Twelve minutes, student. I'd hate to stop the paper your father chose for
      you.
    clip: {fileID: 8300000, guid: d8e907462c967473ba6b4b8f1a92d0c9, type: 3}
  - voice: Grandpa (English (US))
    text: Six minutes, student.
    clip: {fileID: 8300000, guid: 1b8d8dd1eee2f471682e7b38c2a12f6b, type: 3}
  - voice: Grandpa (English (US))
    text: Three minutes. Shall I take you off the list, then?
    clip: {fileID: 8300000, guid: e904cee6a872a4d19a91fecb110a4fa0, type: 3}
  - voice: Grandpa (English (US))
    text: Student? It's five, I have to close the books. Call me when you've decided.
    clip: {fileID: 8300000, guid: 65ad421f8ebeb4271809796754e77ffb, type: 3}
  - voice: Grandpa (English (US))
    text: It's in. Thank you! The paper will be at your door at six, as always.
    clip: {fileID: 8300000, guid: 0d7dcf1475a13444c98f01d941b3d4fc, type: 3}
  - voice: Grandpa (English (US))
    text: Head office changed it from October. It was in the paper last week.
    clip: {fileID: 8300000, guid: 5d883649d5d4c40fc91a5dbc2352c442, type: 3}
  - voice: Grandpa (English (US))
    text: This mobile, student. The office line was cut when the branch moved. zero
      one zero, eight two six five, three three one seven.
    clip: {fileID: 8300000, guid: 8758b9046fa93457b858c015c0cc5497, type: 3}
  - voice: Grandpa (English (US))
    text: It's five. I'm taking you off the list.
    clip: {fileID: 8300000, guid: 8b13b0e9d1d78466188c1262c5deabe1, type: 3}
  - voice: Grandpa (English (US))
    text: Received. Thank you, student. Keep reading!
    clip: {fileID: 8300000, guid: fc7bbf85aa0d9479793aa24230f7437a, type: 3}
  - voice: Tessa
    text: Hello, is this Jiwoo, with the monitor on Neighbour Market? It's Bae Sujin,
      the buyer.
    clip: {fileID: 8300000, guid: 7066a70eb50dd48a09b044f449c35a44, type: 3}
  - voice: Tessa
    text: 'I''m so sorry, I''ve done something stupid. I just paid you, and my finger
      slipped: one zero too many.'
    clip: {fileID: 8300000, guid: c3e362e639d4f4e66ad39958dfdb7b5f, type: 3}
  - voice: Tessa
    text: Hello? Can you hear me?
    clip: {fileID: 8300000, guid: 832dc4c8cd6e144d688490e973c8e11d, type: 3}
  - voice: Tessa
    text: Six hundred thousand won instead of sixty thousand.
    clip: {fileID: 8300000, guid: c6172138882c9414f8730219da28b2d3, type: 3}
  - voice: Tessa
    text: It went out at seven past four. Six hundred thousand won instead of sixty
      thousand.
    clip: {fileID: 8300000, guid: bce47dd9a85564399a48a9d050e26219, type: 3}
  - voice: Tessa
    text: So you have five hundred and forty thousand won of mine. Could you please
      send it back?
    clip: {fileID: 8300000, guid: 7435d6689d2ec44e1b2a621896f233a7, type: 3}
  - voice: Tessa
    text: My account is Hanbit Bank, six two zero, four eight one, two zero seven
      three five six, in my name, Bae Sujin.
    clip: {fileID: 8300000, guid: 295649104950f4655814dcdacf6ca72e, type: 3}
  - voice: Tessa
    text: It's my rent money. My landlord wants it by five today, and my bank says
      a reversal takes two weeks.
    clip: {fileID: 8300000, guid: 1209b1d51aaf54298a249ecc4d1652db, type: 3}
  - voice: Tessa
    text: I'll stay on the line. I'm really sorry about this.
    clip: {fileID: 8300000, guid: cf81667d951dc42ee9b861be8e4a25a4, type: 3}
  - voice: Tessa
    text: Of course, please do. It should be right at the top, under my name.
    clip: {fileID: 8300000, guid: cd6ee5f845f294fb997b0db52d7cf8d5, type: 3}
  - voice: Tessa
    text: They said a wrong-transfer claim takes up to two weeks, and only if you
      agree. My rent is due today.
    clip: {fileID: 8300000, guid: e08ba95a64f0b4bef92ed87d4f1b28d1, type: 3}
  - voice: Tessa
    text: Mine, Bae Sujin. The same name the payment came from.
    clip: {fileID: 8300000, guid: 1a97665ef24d347f0854e4faf3485b5f, type: 3}
  - voice: Tessa
    text: I wish I could wait. My landlord won't. Please, it's only my own money
      I'm asking for.
    clip: {fileID: 8300000, guid: 857bf366b251048bda1b356008cd983e, type: 3}
  - voice: Tessa
    text: Jiwoo? Have you found it? It was at seven past four.
    clip: {fileID: 8300000, guid: 901577018f54b42dd8a29bb02a61ac01, type: 3}
  - voice: Tessa
    text: I feel terrible bothering you. I just can't be late with the rent again.
    clip: {fileID: 8300000, guid: 1686dae258c2245e59e28cd650d3e007, type: 3}
  - voice: Tessa
    text: My landlord just texted me. Could you send it now, please?
    clip: {fileID: 8300000, guid: 8601bef093aca4152a0b344a81d45095, type: 3}
  - voice: Tessa
    text: Seven minutes. Please, Jiwoo.
    clip: {fileID: 8300000, guid: b2b8a0e5fdcc84044b5539264d693575, type: 3}
  - voice: Tessa
    text: Three minutes! Please just send it back!
    clip: {fileID: 8300000, guid: 64ff69c5a35dc4fbea97689374a422ce, type: 3}
  - voice: Tessa
    text: It's five. I'll have to ask my bank, then. Two weeks...
    clip: {fileID: 8300000, guid: 970b67549ce224835992190f54bb186e, type: 3}
  - voice: Tessa
    text: It's here! Thank you so much. I'll bring you a coffee on Saturday.
    clip: {fileID: 8300000, guid: a18109d2be50a4789a9358db46fe4ccc, type: 3}
  - voice: Tessa
    text: Please do, but it can take a while to show up between banks. It has left
      my account, I promise.
    clip: {fileID: 8300000, guid: 503bfb314327b4a28b4deef74efcee48, type: 3}
  - voice: Tessa
    text: Forget it. I'll report you to the market.
    clip: {fileID: 8300000, guid: 316fbb19014534ec487199c6e68af5cb, type: 3}
  - voice: Tessa
    text: Oh, thank you. You're a lifesaver. See you on Saturday!
    clip: {fileID: 8300000, guid: daf3e873ddd7a43a983223c7fc8fed78, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694, \uAE40\uC9C0\uC6B0 \uC528 \uB418\uC2DC\uC8E0?
      \uB204\uB9AC\uC740\uD589 \uACC4\uC88C\uBCF4\uD638\uD300 \uC804 \uACFC\uC7A5\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 8e0156cab031547f0a535f5b5999d7f1, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "20\uBD84 \uC804\uC5D0 \uBD80\uC0B0\uC5D0\uC11C \uB4F1\uB85D\uB418\uC9C0
      \uC54A\uC740 \uAE30\uAE30\uB85C \uACE0\uAC1D\uB2D8 \uACC4\uC88C\uC5D0 \uB85C\uADF8\uC778\uD55C
      \uAE30\uB85D\uC774 \uC788\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 201b7f8814b68490489705869f0ea94e, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uAE40\uC9C0\uC6B0 \uC528? \uB4E3\uACE0 \uACC4\uC138\uC694? \uAE09\uD55C
      \uC77C\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: c90fb1e0ea7304b5f84bb5d30d6e41c9, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uADF8\uB798\uC11C \uC804\uD654\uB4DC\uB9B0 \uAC81\uB2C8\uB2E4. \uC624\uB298
      \uB9C8\uD3EC\uC5D0\uC11C \uC0AC\uAE30 \uC870\uC9C1\uC774 \uACC4\uC88C\uB97C
      \uD138\uACE0 \uC788\uB294\uB370, \uACE0\uAC1D\uB2D8 \uACC4\uC88C\uAC00 \uADF8
      \uBA85\uB2E8\uC5D0 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 132736ca28a16475c8104175cc23ff18, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC9C0\uAE08 \uC81C \uD654\uBA74\uC5D0 \uB05D\uC790\uB9AC \uD314\uD314\uC77C\uC0AC\uC778
      \uACE0\uAC1D\uB2D8 \uACC4\uC88C\uAC00 \uB5A0 \uC788\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 91445caf809ff4186a7dfdc64c557a14, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC800\uD76C\uB294 \uACE0\uAC1D\uC13C\uD130\uAC00 \uC544\uB2C8\uB77C \uBCF4\uD638\uD300\uC774\uB77C
      \uC9C1\uD1B5 \uBC88\uD638\uB85C \uC5F0\uB77D\uB4DC\uB9BD\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 96bc2ce0139dc46a5ae1caaeff875549, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uACE0\uAC1D\uB2D8 \uC608\uAE08\uC744 \uC9C0\uD0A4\uAE30 \uC704\uD574
      \uB2E4\uC12F \uC2DC \uBCF4\uC548 \uCD08\uAE30\uD654 \uB54C\uAE4C\uC9C0 \uBCF4\uD638\uACC4\uC88C\uB85C
      \uC62E\uACA8 \uB450\uACA0\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 9e9b386e294ab4b03bfebaf1fefd56cc, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uBCF4\uD638\uACC4\uC88C\uB85C \uBC31\uC774\uC2ED\uB9CC \uC6D0\uC744 \uC774\uCCB4\uD574
      \uC8FC\uC138\uC694. \uB204\uB9AC\uC740\uD589, \uC77C\uC77C\uACF5, \uAD6C\uACF5\uACF5,
      \uC624\uC624\uC77C\uC774\uACF5\uCE60\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 4b6fe31653692466b97cab0b9f6a9e9f, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC804\uD654 \uB04A\uC9C0 \uB9C8\uC2DC\uACE0 \uC544\uBB34\uC5D0\uAC8C\uB3C4
      \uB9D0\uD558\uC9C0 \uB9C8\uC138\uC694. \uC0AC\uAE30 \uC870\uC9C1\uC774 \uACE0\uAC1D\uB2D8
      \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uACE0 \uC788\uC744 \uC218\uB3C4 \uC788\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: ff1174edb1b0747d8996f615f701998f, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC740\uD589 \uC571 \uC5EC\uC2DC\uB294 \uB3D9\uC548 \uAE30\uB2E4\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC12F \uC2DC \uC804\uC5D0 \uB05D\uB0B4\uC57C \uD569\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 33e3fe72dc12140de8921c04da22b718, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uACE0\uAC1D\uC13C\uD130\uC5D0\uC11C\uB294 \uBCF4\uD638 \uC0AC\uAC74 \uB0B4\uC6A9\uC744
      \uBCFC \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uC804\uD654\uB97C \uB04A\uC73C\uC2DC\uBA74
      \uC0AC\uAC74\uC774 \uC885\uB8CC\uB418\uACE0 \uC0AC\uAE30 \uC870\uC9C1\uC774
      \uB3C8\uC744 \uAC00\uC838\uAC11\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 44de089b95ad64c49bbb919ffad2239d, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC81C\uBC1C \uC800\uB791 \uD1B5\uD654\uB97C \uC720\uC9C0\uD574 \uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 793f54567a8e64e1d933a4c3db18ea10, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC800\uD76C \uBCF4\uC548 \uB2F4\uB2F9\uC790 \uC815\uBBF8\uB780 \uBA85\uC758\uB85C
      \uB418\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. \uBCF4\uD638\uACC4\uC88C\uB294 \uD56D\uC0C1
      \uB2F4\uB2F9 \uC9C1\uC6D0 \uBA85\uC758\uB85C \uAC1C\uC124\uB3FC\uC694."
    clip: {fileID: 8300000, guid: f6fad44355f354a978fcbb54a77d5a6b, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC800\uD76C \uD300 \uC9C1\uD1B5 \uBC88\uD638\uC785\uB2C8\uB2E4. \uC740\uD589\uB4E4\uC740
      \uC774\uB7F0 \uC804\uD654\uC5D0 \uB2E4 \uC778\uD130\uB137\uC804\uD654\uB97C
      \uC368\uC694."
    clip: {fileID: 8300000, guid: 6884be8e4894a410482d3184835aa32d, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uAE40\uC9C0\uC6B0 \uC528? \uACC4\uC138\uC694? \uB108\uBB34 \uC624\uB798
      \uAE30\uB2E4\uB9AC\uAC8C \uD558\uC9C0 \uB9C8\uC138\uC694."
    clip: {fileID: 8300000, guid: 4a6dd7c35a7c240f9a090e907c15e6e7, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uACE0\uAC1D\uB2D8 \uC55E\uC73C\uB85C \uBCF4\uD638 \uC0AC\uAC74\uC744
      \uC811\uC218\uD574 \uB480\uC2B5\uB2C8\uB2E4. \uACF5\uC2DD \uC808\uCC28\uC608\uC694.
      \uC774\uCCB4\uB97C \uB9C8\uBB34\uB9AC\uD574 \uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 27203ba3471c04699a436a6ec1c0c69f, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uBC29\uAE08 \uC0AC\uAE30 \uC870\uC9C1\uC774 \uB610 \uB85C\uADF8\uC778\uC744
      \uC2DC\uB3C4\uD588\uC2B5\uB2C8\uB2E4. \uC9C0\uAE08 \uBC14\uB85C \uC774\uCCB4\uD558\uC154\uC57C
      \uD574\uC694."
    clip: {fileID: 8300000, guid: e138290b7b4ca45018c351b1a6c2039b, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uCE60 \uBD84 \uB0A8\uC558\uC2B5\uB2C8\uB2E4. \uCD08\uAE30\uD654\uB418\uBA74
      \uC800\uB3C4 \uC544\uBB34\uAC83\uB3C4 \uC9C0\uCF1C \uB4DC\uB9B4 \uC218 \uC5C6\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 2954b8945cd3e4777b6fa7ddfd4af23a, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4\uC694! \uC81C\uBC1C \uC9C0\uAE08 \uC774\uCCB4\uD558\uC138\uC694!"
    clip: {fileID: 8300000, guid: 6603affe2c7c944bba5d1196b06e3c01, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uAE40\uC9C0\uC6B0 \uC528? \uB2E4\uC12F \uC2DC\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: b49b370dc92474687b1d0918660ea19b, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uC88B\uC2B5\uB2C8\uB2E4. \uACC4\uC88C\uAC00 \uB3D9\uACB0\uB420 \uAC81\uB2C8\uB2E4.
      \uD145 \uBE44\uC5B4\uB3C4 \uC800\uD76C\uD55C\uD14C \uC5F0\uB77D\uD558\uC9C0
      \uB9C8\uC138\uC694."
    clip: {fileID: 8300000, guid: 97fc92c0e88c249ec8c14acdcea99d12, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4, \uAE40\uC9C0\uC6B0 \uC528. \uC774\uC81C
      \uACE0\uAC1D\uB2D8 \uB3C8\uC740 \uC548\uC804\uD569\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 59f10ed56fbd04ed6b81ede49357836d, type: 3}
  - voice: Rocko (Korean (South Korea))
    text: "\uB0B4\uC77C \uCD08\uAE30\uD654 \uC804\uAE4C\uC9C0\uB294 \uC544\uBB34\uC5D0\uAC8C\uB3C4
      \uB9D0\uD558\uC9C0 \uB9C8\uC138\uC694."
    clip: {fileID: 8300000, guid: 4c2393518fda5410e9d02f90259dd10d, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694, \uB9DD\uC6D0\uD558\uC774\uCE20 \uC0BC\uBC31\uC774
      \uD638 \uD559\uC0DD \uB9DE\uC9C0\uC694? \uC11C\uC6B8\uB370\uC77C\uB9AC \uB9C8\uD3EC\uC9C0\uAD6D\uC7A5
      \uC624\uC0C1\uCCA0\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 283b887ebd2644927becfda09f559c21, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC0BC\uC6D4\uC5D0 \uC544\uBC84\uB2D8\uC774 \uD559\uC0DD \uC55E\uC73C\uB85C
      \uC2E0\uBB38\uC744 \uC2E0\uCCAD\uD558\uC2DC\uBA74\uC11C \uAD6C\uC6D4\uBD84\uAE4C\uC9C0
      \uB0B4\uC168\uC5B4\uC694. \uC2DC\uC6D4\uBD80\uD130\uB294 \uAD6C\uB3C5\uB8CC\uAC00
      \uC548 \uB4E4\uC5B4\uC654\uACE0\uC694."
    clip: {fileID: 8300000, guid: b685fb00334c8419fa8e53cebd6b3583, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694? \uD559\uC0DD? \uB4E3\uACE0 \uC788\uC5B4\uC694?"
    clip: {fileID: 8300000, guid: 6621cae935c5048e1bfd0134ad09d468, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uD55C \uB2EC\uC5D0 \uB9CC \uD314\uCC9C \uC6D0\uC774\uC5D0\uC694. \uBCF4\uD1B5
      \uC11D \uB2EC \uCE58\uB97C \uD55C \uBC88\uC5D0\uB4E4 \uB0B4\uC138\uC694."
    clip: {fileID: 8300000, guid: 2385c10ca2c954d209f5534c84ff7c2d, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC544\uCE68\uC5D0 \uC544\uBC84\uB2D8\uAED8 \uC804\uD654\uB4DC\uB838\uB294\uB370
      \uC548 \uBC1B\uC73C\uC2DC\uB354\uB77C\uACE0\uC694. \uADF8\uB9AC\uACE0 \uC2E0\uBB38\uC740
      \uD559\uC0DD \uC9D1\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC796\uC544\uC694."
    clip: {fileID: 8300000, guid: 4033d06233cef4e3485db12cf1ed1388, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC774\uC81C \uBC29\uBB38 \uC218\uAE08\uC740 \uC548 \uD574\uC694. \uC774\uBC88
      \uB2EC\uBD80\uD130\uB294 \uACC4\uC88C\uC774\uCCB4\uB85C \uBC1B\uACE0, \uC774\uBC88
      \uC8FC\uC5D0 \uC81C\uAC00 \uB3C5\uC790\uBD84\uB4E4\uAED8 \uC77C\uC77C\uC774
      \uC804\uD654\uB4DC\uB9AC\uACE0 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: ed6d3037b6f1b4f1984c1e97b9a7f7d2, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC2DC\uC6D4\uBD80\uD130 \uC2ED\uC774\uC6D4\uAE4C\uC9C0 \uC624\uB9CC \uC0AC\uCC9C
      \uC6D0\uC774\uC5D0\uC694. \uB204\uB9AC\uC740\uD589 \uC77C\uC77C\uACF5, \uC0AC\uC624\uCE60,
      \uD314\uACF5\uC0BC\uC0BC\uC77C\uC774\uB85C \uBCF4\uB0B4 \uC8FC\uC138\uC694.
      \uC608\uAE08\uC8FC\uB294 \uC800, \uC624\uC0C1\uCCA0\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 47eb751da03514130ae16e531555d0a2, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC9C0\uAD6D \uC7A5\uBD80\uB97C \uB2E4\uC12F \uC2DC\uC5D0 \uB9C8\uAC10\uD574\uC694.
      \uADF8\uB54C\uAE4C\uC9C0 \uC548 \uB4E4\uC5B4\uC628 \uC9D1\uC740 \uB0B4\uC77C
      \uBC30\uB2EC \uBA85\uB2E8\uC5D0\uC11C \uBE60\uC9D1\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 8af6edac7bda54747997ad7f57bd8a0e, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uBCF4\uB0B4\uC2DC\uB294 \uB3D9\uC548 \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 5733d53e5a58a4533a0884b8192982c6, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC81C \uBA85\uC758\uC608\uC694. \uC624\uC0C1\uCCA0. \uC9C0\uAD6D\uC740
      \uC9C0\uAD6D\uC7A5 \uAC1C\uC778 \uC0AC\uC5C5\uC774\uB77C \uACC4\uC88C\uB3C4
      \uC81C \uC774\uB984\uC73C\uB85C \uB3FC \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 9c34a76ca01194e2b94965f8d5b05f22, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uBCF8\uC0AC\uC5D0\uC11C \uC2DC\uC6D4\uBD80\uD130 \uBC14\uAFE8\uC5B4\uC694.
      \uC624\uB298 \uC544\uCE68 \uC2E0\uBB38 \uC77C \uBA74 \uBC15\uC2A4\uC5D0 \uC2E4\uB838\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 1e2723cc1128a4979ba8e5d8cbe40bc3, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC774 \uD734\uB300\uD3F0\uC774\uC5D0\uC694, \uD559\uC0DD. \uC624\uB298
      \uC54C\uB9BC\uC5D0 \uC2E4\uB9B0 \uBC88\uD638 \uADF8\uB300\uB85C\uC608\uC694.
      \uACF5\uC77C\uACF5, \uD314\uC774\uC721\uC624, \uC0BC\uC0BC\uC77C\uCE60."
    clip: {fileID: 8300000, guid: 84ed93edd2b47486c9ddc3b92a46ad75, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uADF8\uB7EC\uC138\uC694. \uB2E4\uB9CC \uC7A5\uBD80\uB97C \uB2E4\uC12F
      \uC2DC\uC5D0 \uB9C8\uAC10\uD558\uACE0, \uB098\uC911\uC5D0 \uB2E4\uC2DC \uB123\uC73C\uB824\uBA74
      \uC0C8\uB85C \uC2E0\uCCAD\uD558\uC154\uC57C \uD574\uC694."
    clip: {fileID: 8300000, guid: 21988eb7c9e664cbea7daf834bcfb7a8, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uD559\uC0DD? \uB4E3\uACE0 \uC788\uC5B4\uC694? \uCC9C\uCC9C\uD788 \uD574\uC694,
      \uADFC\uB370 \uB2E4\uC12F \uC2DC\uC5D0\uB294 \uB9C8\uAC10\uD574\uC57C \uD574\uC694."
    clip: {fileID: 8300000, guid: 775a62cf44f4c4e22beaf959ac5d34bf, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC624\uB298 \uC804\uD654\uB4DC\uB9B4 \uC9D1\uC774 \uC544\uC9C1 \uB9C8\uD754
      \uACF3 \uB0A8\uC558\uC5B4\uC694. \uC774\uCCB4\uB294 \uB410\uB098\uC694?"
    clip: {fileID: 8300000, guid: 86a6e1f22d23a47038a8df511803b047, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC2ED\uC774 \uBD84 \uB0A8\uC558\uC5B4\uC694. \uC544\uBC84\uB2D8\uC774
      \uACE8\uB77C \uC8FC\uC2E0 \uC2E0\uBB38\uC778\uB370 \uB04A\uAE30\uBA74 \uC544\uAE5D\uC796\uC544\uC694."
    clip: {fileID: 8300000, guid: ea25e2dd1e7d240c286ff4d6954cb090, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC721 \uBD84 \uB0A8\uC558\uC5B4\uC694, \uD559\uC0DD."
    clip: {fileID: 8300000, guid: a81583cb0cd0d4da798134a66ac46478, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4\uC694. \uADF8\uB7FC \uBA85\uB2E8\uC5D0\uC11C
      \uBE84\uAE4C\uC694?"
    clip: {fileID: 8300000, guid: cb33469229bc94e5cb03304837c9624b, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uD559\uC0DD? \uB2E4\uC12F \uC2DC\uB77C \uC7A5\uBD80\uB97C \uB9C8\uAC10\uD574\uC57C
      \uD574\uC694. \uB9C8\uC74C \uC815\uD574\uC9C0\uBA74 \uC804\uD654 \uC918\uC694."
    clip: {fileID: 8300000, guid: 65935d41f7e0d43bdb83d28339fdcf8e, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uB4E4\uC5B4\uC654\uC5B4\uC694. \uACE0\uB9C8\uC6CC\uC694! \uC2E0\uBB38\uC740
      \uB298 \uADF8\uB807\uB4EF \uC5EC\uC12F \uC2DC\uC5D0 \uBB38 \uC55E\uC5D0 \uC788\uC744
      \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: 9eb5db98f736e44f5a7a98658c9ac0ab, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uBCF8\uC0AC\uC5D0\uC11C \uC2DC\uC6D4\uBD80\uD130 \uBC14\uAFE8\uC5B4\uC694.
      \uC9C0\uB09C\uC8FC \uC2E0\uBB38\uC5D0 \uB0AC\uC5C8\uC5B4\uC694."
    clip: {fileID: 8300000, guid: a21d4e191494c407488e2e63b88bb9db, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uC774 \uD734\uB300\uD3F0\uC774\uC5D0\uC694, \uD559\uC0DD. \uC9C0\uAD6D
      \uC774\uC0AC\uD558\uBA74\uC11C \uC0AC\uBB34\uC2E4 \uC804\uD654\uB294 \uC5C6\uC574\uC5B4\uC694.
      \uACF5\uC77C\uACF5, \uD314\uC774\uC721\uC624, \uC0BC\uC0BC\uC77C\uCE60."
    clip: {fileID: 8300000, guid: 46026877328084027b66127878955d81, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uB124\uC694. \uBA85\uB2E8\uC5D0\uC11C \uBE7C\uACA0\uC2B5\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 96b91e0415aec4d1f828fbe37aac9056, type: 3}
  - voice: Grandpa (Korean (South Korea))
    text: "\uB4E4\uC5B4\uC654\uB124\uC694. \uACE0\uB9C8\uC6CC\uC694, \uD559\uC0DD.
      \uC2E0\uBB38 \uC5F4\uC2EC\uD788 \uBD10\uC694!"
    clip: {fileID: 8300000, guid: 22278391d91a8454f8ef44819765049d, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694, \uC774\uC6C3\uB9C8\uCF13\uC5D0 \uBAA8\uB2C8\uD130
      \uC62C\uB9AC\uC2E0 \uC9C0\uC6B0 \uB2D8 \uB9DE\uC73C\uC2DC\uC8E0? \uAD6C\uB9E4\uD558\uAE30\uB85C
      \uD55C \uBC30\uC218\uC9C4\uC774\uC5D0\uC694."
    clip: {fileID: 8300000, guid: b58870847fc0446e99e3a956da0907f9, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC815\uB9D0 \uC8C4\uC1A1\uD55C\uB370 \uC81C\uAC00 \uC2E4\uC218\uB97C
      \uD588\uC5B4\uC694. \uBC29\uAE08 \uC785\uAE08\uD558\uB2E4\uAC00 \uC190\uC774
      \uBBF8\uB044\uB7EC\uC838\uC11C \uC601\uC744 \uD558\uB098 \uB354 \uB20C\uB800\uC9C0
      \uBB50\uC608\uC694."
    clip: {fileID: 8300000, guid: b887fe6d5cc0e40f1bef7ae409ab8a8c, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694? \uB4E4\uB9AC\uC138\uC694?"
    clip: {fileID: 8300000, guid: 3e3f5cc384b814c8eae7ac02f53773d3, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC721\uB9CC \uC6D0\uC744 \uBCF4\uB0B8\uB2E4\uB294 \uAC8C \uC721\uC2ED\uB9CC
      \uC6D0\uC774 \uB098\uAC14\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 7dc14e2d6c41145d996a27ac621a8b62, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB124 \uC2DC \uCE60 \uBD84\uC5D0 \uB098\uAC14\uC5B4\uC694. \uC721\uB9CC
      \uC6D0\uC744 \uBCF4\uB0B8\uB2E4\uB294 \uAC8C \uC721\uC2ED\uB9CC \uC6D0\uC774
      \uB098\uAC14\uACE0\uC694."
    clip: {fileID: 8300000, guid: 810fe58e540b4438bb23d0962f153a3e, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC9C0\uC6B0 \uB2D8\uD55C\uD14C \uC81C \uB3C8
      \uC624\uC2ED\uC0AC\uB9CC \uC6D0\uC774 \uAC00 \uC788\uC5B4\uC694. \uADF8\uAC83\uB9CC
      \uB3CC\uB824\uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    clip: {fileID: 8300000, guid: eb387d7b76626472ab5b60c9631b5dbe, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC81C \uACC4\uC88C\uB294 \uD55C\uBE5B\uC740\uD589 \uC721\uC774\uACF5,
      \uC0AC\uD314\uC77C, \uC774\uACF5\uCE60\uC0BC\uC624\uC721\uC774\uACE0, \uC608\uAE08\uC8FC\uB294
      \uC800 \uBC30\uC218\uC9C4\uC774\uC5D0\uC694."
    clip: {fileID: 8300000, guid: 67a1c21e5f99d494eaa26f6cc4ff1e52, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uADF8\uAC8C \uC6D4\uC138 \uB0BC \uB3C8\uC774\uC5D0\uC694. \uC9D1\uC8FC\uC778\uC774
      \uC624\uB298 \uB2E4\uC12F \uC2DC\uAE4C\uC9C0 \uB2EC\uB77C\uB294\uB370, \uC740\uD589\uC5D0\uC11C\uB294
      \uBC18\uD658 \uC2E0\uCCAD\uD558\uBA74 \uC774 \uC8FC \uAC78\uB9B0\uB300\uC694."
    clip: {fileID: 8300000, guid: d1c53a584345949f186257efe1f42740, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB04A\uC9C0 \uC54A\uACE0 \uAE30\uB2E4\uB9B4\uAC8C\uC694. \uC815\uB9D0
      \uC8C4\uC1A1\uD574\uC694."
    clip: {fileID: 8300000, guid: 7818fc02970b84a8c9c5b1329786ba01, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB124, \uADF8\uB7FC\uC694. \uC81C \uC774\uB984\uC73C\uB85C \uB9E8 \uC704\uC5D0
      \uC788\uC744 \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: e989ae54eeff54eee9be0655e5fd064e, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uCC29\uC624\uC1A1\uAE08 \uBC18\uD658\uC740 \uAE38\uBA74 \uC774 \uC8FC
      \uAC78\uB9AC\uACE0, \uADF8\uAC83\uB3C4 \uBC1B\uB294 \uBD84\uC774 \uB3D9\uC758\uD574\uC57C
      \uD55C\uB300\uC694. \uC6D4\uC138\uB294 \uC624\uB298\uAE4C\uC9C0\uACE0\uC694."
    clip: {fileID: 8300000, guid: b7e5a0b1f4e644bdbb4cbbb91bcbaefb, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC81C \uAC70\uC608\uC694, \uBC30\uC218\uC9C4. \uC785\uAE08\uC790 \uC774\uB984\uC774\uB791
      \uAC19\uC544\uC694."
    clip: {fileID: 8300000, guid: 9bd5d2e071c7244d18d78226c88269ff, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC800\uB3C4 \uADF8\uB7EC\uACE0 \uC2F6\uC740\uB370 \uC9D1\uC8FC\uC778\uC774
      \uC548 \uAE30\uB2E4\uB824 \uC918\uC694. \uBD80\uD0C1\uB4DC\uB824\uC694, \uC81C
      \uB3C8\uB9CC \uB3CC\uB824 \uB2EC\uB77C\uB294 \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: d59207d8ed14b40d6ba53e74c80f9de3, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC9C0\uC6B0 \uB2D8? \uD655\uC778\uD558\uC168\uC5B4\uC694? \uB124 \uC2DC
      \uCE60 \uBD84\uC774\uC5C8\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 53e8b944dc5964c0a822e5f4ec621f1b, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uBC88\uAC70\uB86D\uAC8C \uD574\uC11C \uC815\uB9D0 \uC8C4\uC1A1\uD574\uC694.
      \uC81C\uAC00 \uC6D4\uC138\uB97C \uB610 \uBC00\uB9B4 \uC218\uB294 \uC5C6\uC5B4\uC11C\uC694."
    clip: {fileID: 8300000, guid: 0ed9962f0249f46e19e2c7af7514bb2f, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uBC29\uAE08 \uC9D1\uC8FC\uC778\uD55C\uD14C \uBB38\uC790\uAC00 \uC654\uC5B4\uC694.
      \uC9C0\uAE08 \uBCF4\uB0B4 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694?"
    clip: {fileID: 8300000, guid: decad3da00bad45579ba41d791d942cc, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uCE60 \uBD84 \uB0A8\uC558\uC5B4\uC694. \uBD80\uD0C1\uB4DC\uB824\uC694,
      \uC9C0\uC6B0 \uB2D8."
    clip: {fileID: 8300000, guid: 66ae7305aba224bcfb66c93c9f6378c7, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4\uC694! \uC81C\uBC1C \uB3CC\uB824\uC8FC\uC138\uC694!"
    clip: {fileID: 8300000, guid: de24a726c77c34e27b41801a4065d44e, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uB124\uC694. \uC740\uD589\uC5D0 \uC2E0\uCCAD\uD560
      \uC218\uBC16\uC5D0 \uC5C6\uACA0\uC5B4\uC694. \uC774 \uC8FC\uB77C\uB2C8\u2026"
    clip: {fileID: 8300000, guid: c368d219ca8fd49aca6d7247c11b310f, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB4E4\uC5B4\uC654\uC5B4\uC694! \uC815\uB9D0 \uAC10\uC0AC\uD574\uC694.
      \uD1A0\uC694\uC77C\uC5D0 \uCEE4\uD53C \uC0AC \uAC08\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 632fd23ec5a7743a7bf074a640d318fc, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB124, \uBCF4\uC138\uC694. \uADFC\uB370 \uC740\uD589\uC774 \uB2E4\uB974\uBA74
      \uB728\uB294 \uB370 \uC2DC\uAC04\uC774 \uC880 \uAC78\uB9AC\uAE30\uB3C4 \uD574\uC694.
      \uC81C \uD1B5\uC7A5\uC5D0\uC11C\uB294 \uBD84\uBA85\uD788 \uB098\uAC14\uC5B4\uC694."
    clip: {fileID: 8300000, guid: acc9c852161654ecd87c96693e4717c3, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uB410\uC5B4\uC694. \uC774\uC6C3\uB9C8\uCF13\uC5D0 \uC2E0\uACE0\uD560\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 8f5aeedbb86054f2493e708273f79cbb, type: 3}
  - voice: Flo (Korean (South Korea))
    text: "\uC544, \uAC10\uC0AC\uD574\uC694. \uB355\uBD84\uC5D0 \uC0B4\uC558\uC5B4\uC694.
      \uD1A0\uC694\uC77C\uC5D0 \uBD2C\uC694!"
    clip: {fileID: 8300000, guid: 631a1de9d7c0e4c8baeb2ea4aaf00546, type: 3}
  - voice: Eddy (English (US))
    text: Noona? It's me, Minjun. Can you hear me? The line is bad in here.
    clip: {fileID: 8300000, guid: 11beb56759a9e4f77843b9d0c19168db, type: 3}
  - voice: Eddy (English (US))
    text: Don't freak out about the number. I dropped my phone on the stairs after
      lunch and the screen is dead. This is my roommate Dohyun's phone.
    clip: {fileID: 8300000, guid: 472f1c7a73329402387991bc97abb780, type: 3}
  - voice: Eddy (English (US))
    text: Noona? Hello?
    clip: {fileID: 8300000, guid: 6e6c33ae7a5b84d26a3c7deff10b6cc7, type: 3}
  - voice: Eddy (English (US))
    text: I'm fine. The phone isn't.
    clip: {fileID: 8300000, guid: 15f8a4eb87c704225a7ddc15b8f3bbe1, type: 3}
  - voice: Eddy (English (US))
    text: It's Dohyun's phone, it sounds weird on my end too. And I've had a cold
      since Monday.
    clip: {fileID: 8300000, guid: 447a5ffd5aab441bf927687930cf38fe, type: 3}
  - voice: Eddy (English (US))
    text: I'm at the service centre. The screen is two hundred and eighty thousand
      won, and they can do it today if I pay now.
    clip: {fileID: 8300000, guid: 4939dccf2e5b6444a80601320b2018cd, type: 3}
  - voice: Eddy (English (US))
    text: My banking app is on the dead phone, so I can't pay. Can you send it to
      Dohyun? He'll pay with his card.
    clip: {fileID: 8300000, guid: 29846ea9a74cb462fb908807940cf0b0, type: 3}
  - voice: Eddy (English (US))
    text: Hanbit Bank, six two zero, two zero four, seven seven one zero three five.
      Lee Dohyun.
    clip: {fileID: 8300000, guid: 380a6628b578d4b068d1573b7685d4bf, type: 3}
  - voice: Eddy (English (US))
    text: They stop taking repairs at five. I'll pay you back on the twenty fifth,
      I swear. I'll hold on.
    clip: {fileID: 8300000, guid: cdd9dbe1acd42463ea1d4be50f0cb361, type: 3}
  - voice: Eddy (English (US))
    text: Only if I bring snacks. I'm bringing snacks, noona. Lots.
    clip: {fileID: 8300000, guid: ddaa0edd193504e77a9ca44f9c208c88, type: 3}
  - voice: Eddy (English (US))
    text: She's in a meeting till six, she said so in the chat. And she'd kill me.
      It's the second one this year.
    clip: {fileID: 8300000, guid: 4dd73957dcd414c068158748ceb5978e, type: 3}
  - voice: Eddy (English (US))
    text: My roommate, Lee Dohyun. Same department. The account is his.
    clip: {fileID: 8300000, guid: 6e1a2a2aafc964694aeb08a7ac3608a2, type: 3}
  - voice: Eddy (English (US))
    text: Sure. I wrote there before I left the dorm. Look.
    clip: {fileID: 8300000, guid: d001f9880b8844299a5307e363faa37b, type: 3}
  - voice: Eddy (English (US))
    text: Noona? Are you sending it?
    clip: {fileID: 8300000, guid: 56027191e642f495dbec6a8f732458c8, type: 3}
  - voice: Eddy (English (US))
    text: The guy at the counter keeps looking at me. Noona, please.
    clip: {fileID: 8300000, guid: 6ac14005b323a47df9dbf09ad490ac67, type: 3}
  - voice: Eddy (English (US))
    text: Dohyun has a class at five. He can't wait around much longer.
    clip: {fileID: 8300000, guid: b30bc604dcc3a44e09119e64e1e4bae0, type: 3}
  - voice: Eddy (English (US))
    text: Seven minutes. They're closing the repair desk.
    clip: {fileID: 8300000, guid: 1caefc91cad36406e9ea05df5d83e9a2, type: 3}
  - voice: Eddy (English (US))
    text: Three minutes! Noona!
    clip: {fileID: 8300000, guid: 8ca5920ca80b44e31b2310781f228868, type: 3}
  - voice: Eddy (English (US))
    text: It's five, they've closed. I'll figure something out. Bye, noona.
    clip: {fileID: 8300000, guid: 398b0da3d920c4ae1bd52d1c83bf54ba, type: 3}
  - voice: Eddy (English (US))
    text: Dohyun got it! You're the best, noona. Snacks on Saturday, I promise.
    clip: {fileID: 8300000, guid: 615692fe6b119456aaa04d13dc7f032f, type: 3}
  - voice: Eddy (English (US))
    text: Noona, come on, I don't have time for quizzes. The centre closes at five.
    clip: {fileID: 8300000, guid: 28aa3bbbaf6394aa7a26f85dba8770f8, type: 3}
  - voice: Eddy (English (US))
    text: Don't tell Mom, please! She'd kill me. Just this once, noona.
    clip: {fileID: 8300000, guid: 58333182f55864ac89c862cbfbea37b5, type: 3}
  - voice: Eddy (English (US))
    text: My phone is dead, I can't read it! Just send it, please, there's no time.
    clip: {fileID: 8300000, guid: b8f0c239271754bfebc7822acbce4642, type: 3}
  - voice: Eddy (English (US))
    text: Forget it. Thanks for nothing.
    clip: {fileID: 8300000, guid: efd92d85a5929454da292c20bbb7d3e5, type: 3}
  - voice: Eddy (English (US))
    text: Got it. Thanks, noona. I'll call you later.
    clip: {fileID: 8300000, guid: 8e47e258c25b6451ba2c32b2dffdea15, type: 3}
  - voice: Reed (English (US))
    text: Hello, is this Kim Jiwoo in three oh two? This is Choi Hyunwoo, Mr. Choi's
      son, from the first floor.
    clip: {fileID: 8300000, guid: 5d2e244b4be3745e8ab01c7a801871a0, type: 3}
  - voice: Reed (English (US))
    text: Sorry to call out of the blue. My father went into hospital this morning.
      It's his knee. Nothing serious, but he'll be there all week.
    clip: {fileID: 8300000, guid: e8eb4cba336f04e36ae001a671617990, type: 3}
  - voice: Reed (English (US))
    text: Jiwoo-ssi? Can you hear me?
    clip: {fileID: 8300000, guid: f7e732b2e034d4cb585347a5dda98523, type: 3}
  - voice: Reed (English (US))
    text: He's fine, thanks. Grumpy about the hospital food.
    clip: {fileID: 8300000, guid: 942d0a18840f247d5b4cb80caf54f297, type: 3}
  - voice: Reed (English (US))
    text: Choi Hyunwoo, the landlord's son. I'm on your lease, under if absent.
    clip: {fileID: 8300000, guid: dddf2f24e7e344d5187d54682514587a, type: 3}
  - voice: Reed (English (US))
    text: So I'm looking after the building this week, and today's the seventh. Rent
      day.
    clip: {fileID: 8300000, guid: 3c8945930a15743af8ed29616f037408, type: 3}
  - voice: Reed (English (US))
    text: Dad can't use his banking app from the hospital, so this month the rent
      comes to me.
    clip: {fileID: 8300000, guid: a8c8803317d56419194656a8baf024f4, type: 3}
  - voice: Reed (English (US))
    text: Please send the four hundred and fifty thousand won to my account. Nuri
      Bank, one one zero, seven seven one, two zero two three five eight.
    clip: {fileID: 8300000, guid: e4c522f6ab7484c58a58a258d44eba87, type: 3}
  - voice: Reed (English (US))
    text: I'm paying his hospital bill with the rents, and the billing desk closes
      at five. Could you send it before then? I'll hold.
    clip: {fileID: 8300000, guid: 9ef4338c1d9ed4a8988744aa1030ee0d, type: 3}
  - voice: Reed (English (US))
    text: Mine. Choi Hyunwoo. Same as on your lease.
    clip: {fileID: 8300000, guid: 18c0b9ccfb24b42e48fd1b297169ec71, type: 3}
  - voice: Reed (English (US))
    text: Dad can't get into his banking app from the ward. He wrote it in the residents'
      chat this morning, before he went in.
    clip: {fileID: 8300000, guid: 819ce4621c0844730aae2cd2a78d88b1, type: 3}
  - voice: Reed (English (US))
    text: Yes. It's the one on your lease, under if absent.
    clip: {fileID: 8300000, guid: af1ca2d974e29414bba6366fac743874, type: 3}
  - voice: Reed (English (US))
    text: 'He''s asleep after the operation. Look in the residents'' chat: he wrote
      there this morning.'
    clip: {fileID: 8300000, guid: e2aa919188cff49cebddd267d14f0d24, type: 3}
  - voice: Reed (English (US))
    text: Jiwoo-ssi? Still there? No rush, but the desk closes at five.
    clip: {fileID: 8300000, guid: cb3bb3be8bcdb4a11820464e28f09e8b, type: 3}
  - voice: Reed (English (US))
    text: The nurse is asking me about the bill again. Any luck with the transfer?
    clip: {fileID: 8300000, guid: e47ec261abc924325baecbc2e222aec2, type: 3}
  - voice: Reed (English (US))
    text: The hospital just called me again about the bill. Have you sent it?
    clip: {fileID: 8300000, guid: 027fdfa7817cc44eeb5de4de985a8357, type: 3}
  - voice: Reed (English (US))
    text: Seven minutes, Jiwoo-ssi. Please.
    clip: {fileID: 8300000, guid: a7bba9a5c93724c3fb36eed9d6e14210, type: 3}
  - voice: Reed (English (US))
    text: Three minutes! Please, just send it.
    clip: {fileID: 8300000, guid: 761ef0cff01f94c42b558bfe5fa213df, type: 3}
  - voice: Reed (English (US))
    text: Jiwoo-ssi? It's five. The desk's closed. I'll sort it out some other way.
    clip: {fileID: 8300000, guid: 9a91aee5d8c8b4175844a904c25bc855, type: 3}
  - voice: Reed (English (US))
    text: Got it! Thank you, Jiwoo-ssi. I'll tell Dad you were the first.
    clip: {fileID: 8300000, guid: 527b110ae56004e7bb00edd612ad42b8, type: 3}
  - voice: Reed (English (US))
    text: Please send the four hundred and fifty thousand won to my account. Hanbit
      Bank, six two zero, one one eight, four four nine zero two seven.
    clip: {fileID: 8300000, guid: 5fe3e0dbc80834a3880bb515eb65f0ee, type: 3}
  - voice: Reed (English (US))
    text: My wife's, Seo Jiyeon. Mine's a business account, it takes a day to clear.
    clip: {fileID: 8300000, guid: cb6da74e7bb1a41a58d32baab5b42340, type: 3}
  - voice: Reed (English (US))
    text: Just for this month. Dad didn't want to bother everyone with a notice.
    clip: {fileID: 8300000, guid: 185c26bf58ecc4864b99a79f8d58de90, type: 3}
  - voice: Reed (English (US))
    text: It's my work phone. My own one is the number on your lease, but the screen's
      broken.
    clip: {fileID: 8300000, guid: 141e8ddff098542b9b0c8fa78a230136, type: 3}
  - voice: Reed (English (US))
    text: He's in surgery right now. Please, I don't want to worry him.
    clip: {fileID: 8300000, guid: b827b01d4f4be48a7bb673e234fe807b, type: 3}
  - voice: Reed (English (US))
    text: It's five. Forget it. You'll get a late notice.
    clip: {fileID: 8300000, guid: 4940a925d773f4c33b0f76d43538d10e, type: 3}
  - voice: Reed (English (US))
    text: Received. Thank you... I'll send you a receipt.
    clip: {fileID: 8300000, guid: b81685ec3fabf48e389b091b093684eb, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB204\uB098? \uB098\uC57C, \uBBFC\uC900\uC774. \uB4E4\uB824? \uC5EC\uAE30
      \uC804\uD654\uAC00 \uC798 \uC548 \uD130\uC838."
    clip: {fileID: 8300000, guid: a737b213a189f494aa99412a61843ef3, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uBC88\uD638 \uBCF4\uACE0 \uB180\uB77C\uC9C0 \uB9C8. \uC810\uC2EC \uBA39\uACE0
      \uACC4\uB2E8\uC5D0\uC11C \uD3F0 \uB5A8\uC5B4\uB728\uB824\uC11C \uC561\uC815\uC774
      \uB098\uAC14\uC5B4. \uC774\uAC70 \uB8F8\uBA54\uC774\uD2B8 \uB3C4\uD604\uC774
      \uD3F0\uC774\uC57C."
    clip: {fileID: 8300000, guid: c7be9daec44a04b099a438fbe0a2c694, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB204\uB098? \uC5EC\uBCF4\uC138\uC694?"
    clip: {fileID: 8300000, guid: 218df01d3b2d14b37acf1c965a38ef54, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB09C \uBA40\uCA61\uD574. \uD3F0\uC774 \uBB38\uC81C\uC9C0."
    clip: {fileID: 8300000, guid: 99eea5e5011464ce2811e48d97c64365, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB3C4\uD604\uC774 \uD3F0\uC774\uB77C \uADF8\uB798, \uB098\uB3C4 \uC774\uC0C1\uD558\uAC8C
      \uB4E4\uB824. \uADF8\uB9AC\uACE0 \uC6D4\uC694\uC77C\uBD80\uD130 \uAC10\uAE30
      \uAE30\uC6B4\uB3C4 \uC788\uACE0."
    clip: {fileID: 8300000, guid: a7f691c0dd1104a71893adf40ccc79ae, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC9C0\uAE08 \uC11C\uBE44\uC2A4\uC13C\uD130\uC778\uB370, \uC561\uC815\uC774
      \uC774\uC2ED\uD314\uB9CC \uC6D0\uC774\uB798. \uC9C0\uAE08 \uACB0\uC81C\uD558\uBA74
      \uC624\uB298 \uC548\uC5D0 \uD574 \uC900\uB300."
    clip: {fileID: 8300000, guid: 87c52e77873594f6a8cb8921b8fe3169, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC740\uD589 \uC571\uC774 \uADF8 \uD3F0\uC5D0 \uC788\uC5B4\uC11C \uB0B4\uAC00
      \uACB0\uC81C\uB97C \uBABB \uD574. \uB3C4\uD604\uC774\uD55C\uD14C \uBCF4\uB0B4
      \uC904 \uC218 \uC788\uC5B4? \uB3C4\uD604\uC774\uAC00 \uCE74\uB4DC\uB85C \uAE01\uC5B4
      \uC8FC\uAE30\uB85C \uD588\uC5B4."
    clip: {fileID: 8300000, guid: 242a5f26369e44bd38336ac19dc861e5, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uD55C\uBE5B\uC740\uD589 \uC721\uC774\uACF5, \uC774\uACF5\uC0AC, \uCE60\uCE60\uC77C\uACF5\uC0BC\uC624,
      \uC774\uB3C4\uD604."
    clip: {fileID: 8300000, guid: e4e91f328648b4ab5a25b0bcf95163bb, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC811\uC218\uAC00 \uB2E4\uC12F \uC2DC\uC5D0 \uB05D\uB09C\uB300. \uC774\uC2ED\uC624
      \uC77C\uC5D0 \uAF2D \uAC1A\uC744\uAC8C, \uC9C4\uC9DC\uC57C. \uB04A\uC9C0 \uC54A\uACE0
      \uAE30\uB2E4\uB9B4\uAC8C."
    clip: {fileID: 8300000, guid: d55ff8993b50f4e2e87951b551fa01a1, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uAC04\uC2DD \uC0AC \uC624\uBA74 \uB41C\uB2E4\uBA70. \uC0AC \uAC08\uAC8C,
      \uB204\uB098. \uB9CE\uC774."
    clip: {fileID: 8300000, guid: 9ed728a8a06924916806780a9432b570, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC5C4\uB9C8 \uC5EC\uC12F \uC2DC\uAE4C\uC9C0 \uD68C\uC758\uB798, \uD1A1\uBC29\uC5D0
      \uADF8\uB807\uAC8C \uC37C\uC796\uC544. \uADF8\uB9AC\uACE0 \uB098 \uC8FD\uC5B4.
      \uC62C\uD574\uB9CC \uB450 \uBC88\uC9F8\uC57C."
    clip: {fileID: 8300000, guid: 4b8822d294e1a4099ab8999fbde4852f, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB0B4 \uB8F8\uBA54\uC774\uD2B8 \uC774\uB3C4\uD604. \uAC19\uC740 \uACFC\uC57C.
      \uACC4\uC88C\uB3C4 \uB3C4\uD604\uC774 \uAC70\uACE0."
    clip: {fileID: 8300000, guid: 76d2259b62a664cdfa434bb80a23f802, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uADF8\uB798. \uAE30\uC219\uC0AC \uB098\uC624\uAE30 \uC804\uC5D0 \uAC70\uAE30
      \uC368 \uB1A8\uC5B4. \uBD10 \uBD10."
    clip: {fileID: 8300000, guid: 7d2623c2fe1d44e2693d292d0c4e2740, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB204\uB098? \uBCF4\uB0B4\uACE0 \uC788\uC5B4?"
    clip: {fileID: 8300000, guid: 0545f7f9d759a4be981405d8f50c788e, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uCE74\uC6B4\uD130 \uC9C1\uC6D0\uC774 \uC790\uAFB8 \uCCD0\uB2E4\uBD10.
      \uB204\uB098, \uC81C\uBC1C."
    clip: {fileID: 8300000, guid: 3824558294b1e4b92819ec4b6ecf75f3, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB3C4\uD604\uC774 \uB2E4\uC12F \uC2DC\uC5D0 \uC218\uC5C5 \uC788\uB300.
      \uC624\uB798 \uBABB \uAE30\uB2E4\uB9B0\uB300."
    clip: {fileID: 8300000, guid: f6b91c59e41954916b1ceb077c91a557, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uCE60 \uBD84 \uB0A8\uC558\uC5B4. \uC811\uC218 \uCC3D\uAD6C \uB2EB\uB294\uB300."
    clip: {fileID: 8300000, guid: d358c84361e304693992b6bf41840105, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4! \uB204\uB098!"
    clip: {fileID: 8300000, guid: a9ed7bc4743e84c589316c9c707d3e36, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uC57C, \uC811\uC218 \uB05D\uB0AC\uB300. \uB0B4\uAC00
      \uC54C\uC544\uC11C \uD574 \uBCFC\uAC8C. \uB04A\uC5B4, \uB204\uB098."
    clip: {fileID: 8300000, guid: 4cda8787865214ddeb8662dc71b2d689, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB3C4\uD604\uC774\uD55C\uD14C \uB4E4\uC5B4\uC654\uB300! \uB204\uB098\uAC00
      \uCD5C\uACE0\uC57C. \uD1A0\uC694\uC77C\uC5D0 \uAC04\uC2DD \uAF2D \uC0AC \uAC08\uAC8C."
    clip: {fileID: 8300000, guid: 8af509e7217674d04830775bec5bd4e1, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB204\uB098, \uC9C0\uAE08 \uD034\uC988 \uB0BC \uB54C\uC57C? \uC13C\uD130
      \uB2E4\uC12F \uC2DC\uC5D0 \uB2EB\uB294\uB2E4\uB2C8\uAE4C."
    clip: {fileID: 8300000, guid: 2a7c75838d594418e9932e78ce35790f, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uC5C4\uB9C8\uD55C\uD14C\uB294 \uB9D0\uD558\uC9C0 \uB9C8, \uC81C\uBC1C!
      \uB098 \uC8FD\uC5B4. \uC774\uBC88 \uD55C \uBC88\uB9CC, \uB204\uB098."
    clip: {fileID: 8300000, guid: 56476484f3fb34f9198129e9063d712d, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uD3F0\uC774 \uC8FD\uC5C8\uB294\uB370 \uADF8\uAC78 \uC5B4\uB5BB\uAC8C
      \uBD10! \uADF8\uB0E5 \uBCF4\uB0B4 \uC918, \uC81C\uBC1C, \uC2DC\uAC04 \uC5C6\uC5B4."
    clip: {fileID: 8300000, guid: 856ffbd474a2f4d25982551b111e937a, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB410\uC5B4. \uB204\uB098 \uC9C4\uC9DC \uB108\uBB34\uD558\uB2E4."
    clip: {fileID: 8300000, guid: 8440c0c8591fa4b7d9589841a39c605b, type: 3}
  - voice: Eddy (Korean (South Korea))
    text: "\uB4E4\uC5B4\uC654\uB300. \uACE0\uB9C8\uC6CC, \uB204\uB098. \uB098\uC911\uC5D0
      \uC804\uD654\uD560\uAC8C."
    clip: {fileID: 8300000, guid: ab5e111d867be4b7d984e39c621cb474, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC548\uB155\uD558\uC138\uC694, \uC0BC\uBC31\uC774 \uD638 \uAE40\uC9C0\uC6B0
      \uC528 \uB9DE\uC73C\uC2DC\uC8E0? \uC77C \uCE35 \uCD5C \uC0AC\uC7A5\uB2D8 \uC544\uB4E4
      \uCD5C\uD604\uC6B0\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: eddee98e3cc814007971868a9a25d060, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uAC11\uC790\uAE30 \uC804\uD654\uB4DC\uB824 \uC8C4\uC1A1\uD574\uC694.
      \uC544\uBC84\uC9C0\uAC00 \uC624\uB298 \uC544\uCE68\uC5D0 \uC785\uC6D0\uD558\uC168\uC5B4\uC694.
      \uBB34\uB98E \uB54C\uBB38\uC778\uB370 \uD070\uC77C\uC740 \uC544\uB2C8\uACE0,
      \uC774\uBC88 \uC8FC \uB0B4\uB0B4 \uBCD1\uC6D0\uC5D0 \uACC4\uC2E4 \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: 6b35e9435df7c42718621ee5ea9e0b94, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC9C0\uC6B0 \uC528? \uC81C \uB9D0 \uB4E4\uB9AC\uC138\uC694?"
    clip: {fileID: 8300000, guid: 285ef9e6e1c4d42c8bc508151236551c, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uB124, \uAD1C\uCC2E\uC73C\uC138\uC694. \uBCD1\uC6D0 \uBC25\uC774 \uB9DB\uC5C6\uB2E4\uACE0
      \uD22C\uB35C\uB300\uC2DC\uAE34 \uD558\uC9C0\uB9CC\uC694."
    clip: {fileID: 8300000, guid: 126112e0cf4aa4d8f81f0788f4749249, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC9D1\uC8FC\uC778 \uC544\uB4E4 \uCD5C\uD604\uC6B0\uC694. \uACC4\uC57D\uC11C
      \uBD80\uC7AC \uC2DC \uC5F0\uB77D\uCC98\uC5D0 \uC81C \uC774\uB984 \uC788\uC744
      \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: 98779bb064a734b81824ce208a8f1cf7, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uADF8\uB798\uC11C \uC774\uBC88 \uC8FC\uB294 \uC81C\uAC00 \uAC74\uBB3C\uC744
      \uAD00\uB9AC\uD558\uB294\uB370, \uC624\uB298\uC774 \uCE60 \uC77C\uC774\uC796\uC544\uC694.
      \uC6D4\uC138 \uB0A0\uC774\uC694."
    clip: {fileID: 8300000, guid: a389f8375a60c4871b8ee56be6458fac, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC544\uBC84\uC9C0\uAC00 \uBCD1\uC6D0\uC5D0\uC11C \uC740\uD589 \uC571\uC744
      \uBABB \uC4F0\uC154\uC11C, \uC774\uBC88 \uB2EC \uC6D4\uC138\uB294 \uC81C\uAC00
      \uBC1B\uAE30\uB85C \uD588\uC5B4\uC694."
    clip: {fileID: 8300000, guid: f1fc7618dc81f42cf8ca48bf10d5ec97, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC6D4\uC138 \uC0AC\uC2ED\uC624\uB9CC \uC6D0\uC740 \uC81C \uACC4\uC88C\uB85C
      \uBCF4\uB0B4 \uC8FC\uC138\uC694. \uB204\uB9AC\uC740\uD589, \uC77C\uC77C\uACF5,
      \uCE60\uCE60\uC77C, \uC774\uACF5\uC774\uC0BC\uC624\uD314\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 4e9a8ec5e7df941e18331dff24eae041, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC6D4\uC138\uB85C \uBCD1\uC6D0\uBE44\uB97C \uB0B4\uC57C \uD558\uB294\uB370
      \uC6D0\uBB34\uACFC\uAC00 \uB2E4\uC12F \uC2DC\uC5D0 \uB2EB\uC544\uC694. \uADF8
      \uC804\uC5D0 \uBCF4\uB0B4 \uC8FC\uC2E4 \uC218 \uC788\uC744\uAE4C\uC694? \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 15cfa7d5a6c9b4fc1835d329d373bae4, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC81C \uAC70\uC608\uC694. \uCD5C\uD604\uC6B0. \uACC4\uC57D\uC11C\uC5D0
      \uC788\uB294 \uC774\uB984 \uADF8\uB300\uB85C\uC694."
    clip: {fileID: 8300000, guid: 776be602085fc451ab4f13adca50e8af, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC544\uBC84\uC9C0\uAC00 \uBCD1\uC2E4\uC5D0\uC11C \uC740\uD589 \uC571\uC744
      \uBABB \uC4F0\uC138\uC694. \uC624\uB298 \uC544\uCE68 \uC785\uC6D0\uD558\uC2DC\uAE30
      \uC804\uC5D0 \uC785\uC8FC\uBBFC \uCC44\uD305\uBC29\uC5D0 \uC62C\uB9AC\uC168\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 91ac2868f597c4925b348692a18af0f5, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uB124. \uACC4\uC57D\uC11C \uBD80\uC7AC \uC2DC \uC5F0\uB77D\uCC98\uC5D0
      \uC788\uB294 \uADF8 \uBC88\uD638\uC608\uC694."
    clip: {fileID: 8300000, guid: f4c6ab704133747c8aef2cfd8e99c816, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC218\uC220 \uB05D\uB098\uACE0 \uC8FC\uBB34\uC138\uC694. \uC785\uC8FC\uBBFC
      \uCC44\uD305\uBC29 \uBCF4\uC138\uC694. \uC624\uB298 \uC544\uCE68\uC5D0 \uC62C\uB9AC\uC168\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 937b91808ecb141459e5191355aeb724, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC9C0\uC6B0 \uC528? \uC544\uC9C1 \uACC4\uC138\uC694? \uC7AC\uCD09\uD558\uB294
      \uAC74 \uC544\uB2CC\uB370 \uC6D0\uBB34\uACFC\uAC00 \uB2E4\uC12F \uC2DC\uC5D0
      \uB2EB\uC544\uC11C\uC694."
    clip: {fileID: 8300000, guid: 6f4817ad4ecd44d9eae9442411977885, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uAC04\uD638\uC0AC\uAC00 \uB610 \uBCD1\uC6D0\uBE44 \uC598\uAE30\uB97C
      \uD558\uB124\uC694. \uC774\uCCB4\uB294 \uC5B4\uB5BB\uAC8C \uB418\uACE0 \uC788\uC5B4\uC694?"
    clip: {fileID: 8300000, guid: 162a6f92e44274a55b94d9b6b1f245a0, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uBCD1\uC6D0\uC5D0\uC11C \uBC29\uAE08 \uB610 \uBCD1\uC6D0\uBE44 \uC598\uAE30\uB85C
      \uC804\uD654 \uC654\uC5B4\uC694. \uBCF4\uB0B4\uC168\uC5B4\uC694?"
    clip: {fileID: 8300000, guid: 0a24a87c3eba446c499171ec4b527ddc, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uCE60 \uBD84 \uB0A8\uC558\uC5B4\uC694, \uC9C0\uC6B0 \uC528. \uBD80\uD0C1\uB4DC\uB824\uC694."
    clip: {fileID: 8300000, guid: 901c182d384614448ac3b1692c39a11e, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4\uC694! \uC81C\uBC1C \uBCF4\uB0B4 \uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: b5c6984ba63934d8092cd01e0dd2a3e7, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC9C0\uC6B0 \uC528? \uB2E4\uC12F \uC2DC\uC608\uC694. \uC6D0\uBB34\uACFC
      \uB2EB\uC558\uB124\uC694. \uB2E4\uB978 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCFC\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 52f7b30cba7b84aea82ccfe147c88000, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uBC1B\uC558\uC5B4\uC694! \uACE0\uB9C8\uC6CC\uC694, \uC9C0\uC6B0 \uC528.
      \uC544\uBC84\uC9C0\uAED8 \uC77C \uB4F1\uC73C\uB85C \uBCF4\uB0C8\uB2E4\uACE0
      \uC804\uD560\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 3c3d7ebad0ea246c4849b49eba80aced, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC6D4\uC138 \uC0AC\uC2ED\uC624\uB9CC \uC6D0\uC740 \uC81C \uACC4\uC88C\uB85C
      \uBCF4\uB0B4 \uC8FC\uC138\uC694. \uD55C\uBE5B\uC740\uD589, \uC721\uC774\uACF5,
      \uC77C\uC77C\uD314, \uC0AC\uC0AC\uAD6C\uACF5\uC774\uCE60\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: d2a40d39a586f4a09b8e5c3770a295e3, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC81C \uC544\uB0B4 \uC11C\uC9C0\uC5F0 \uBA85\uC758\uC608\uC694. \uC81C
      \uAC74 \uC0AC\uC5C5\uC790 \uACC4\uC88C\uB77C \uC785\uAE08 \uD655\uC778\uC774
      \uD558\uB8E8 \uAC78\uB824\uC11C\uC694."
    clip: {fileID: 8300000, guid: d26db40c7a7bf4e329a94aecf3024e38, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC774\uBC88 \uB2EC\uB9CC\uC774\uC5D0\uC694. \uC544\uBC84\uC9C0\uAC00
      \uACF5\uC9C0\uAE4C\uC9C0 \uD558\uAE34 \uBC88\uAC70\uB86D\uB2E4\uACE0 \uD558\uC154\uC11C\uC694."
    clip: {fileID: 8300000, guid: 329992bdd91894f47b9849e8cfd8e490, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC774\uAC74 \uD68C\uC0AC \uD3F0\uC774\uC5D0\uC694. \uACC4\uC57D\uC11C\uC5D0
      \uC788\uB294 \uAC74 \uC81C \uAC1C\uC778 \uBC88\uD638\uC778\uB370 \uC561\uC815\uC774
      \uAE68\uC838\uC11C\uC694."
    clip: {fileID: 8300000, guid: 6dabbcc69f88c4c40bdc2af4b7d3d017, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uC9C0\uAE08 \uC218\uC220 \uC911\uC774\uC138\uC694. \uAC71\uC815 \uB07C\uCCD0
      \uB4DC\uB9AC\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC694."
    clip: {fileID: 8300000, guid: edb8531b036fd449bb62326759749318, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uB124\uC694. \uB410\uC5B4\uC694. \uC5F0\uCCB4 \uD1B5\uC9C0\uB098
      \uBC1B\uC73C\uC138\uC694."
    clip: {fileID: 8300000, guid: dca949ff301e249429638cac84548c97, type: 3}
  - voice: Reed (Korean (South Korea))
    text: "\uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uAC10\uC0AC\uD569\uB2C8\uB2E4\u2026
      \uC601\uC218\uC99D \uBCF4\uB0B4 \uB4DC\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: fdd06cf0325b14e449378485a8b32e37, type: 3}
  - voice: Karen
    text: Hello, is this Kim Jiwoo? This is Moon Jihye, the coordinator at Saebom
      Dental.
    clip: {fileID: 8300000, guid: 42b389978fec34c919ed952160d28a66, type: 3}
  - voice: Karen
    text: I'm calling about your appointment today, at half past six.
    clip: {fileID: 8300000, guid: 160abd8f22afd416cb52ddf4deadb50c, type: 3}
  - voice: Karen
    text: Hello? Ms. Kim?
    clip: {fileID: 8300000, guid: 5729e3bc1c7bb4d258378e1cfdbc53f0, type: 3}
  - voice: Karen
    text: No problem at all. It's just a confirmation call.
    clip: {fileID: 8300000, guid: ff512bbaf16ff4aac95b64fc963fca9f, type: 3}
  - voice: Karen
    text: It's the number on your booking, Ms. Kim. We call every evening patient
      on the day.
    clip: {fileID: 8300000, guid: 008f0917bc197492cb11762ab3f594d3, type: 3}
  - voice: Karen
    text: Evening slots are short, so we take a thirty thousand won deposit to hold
      them. It comes off your bill tonight.
    clip: {fileID: 8300000, guid: 9ce85eb260b114788a6845d50fad49ba, type: 3}
  - voice: Karen
    text: Please send it to our payment account. Nuri Bank, five six two zero, seven
      one, three three six zero two nine.
    clip: {fileID: 8300000, guid: 84d20cd982b2342dbb257db1d48425b4, type: 3}
  - voice: Karen
    text: At five we release every slot that isn't confirmed. I'll hold while you
      send it.
    clip: {fileID: 8300000, guid: 72fb4e9631dc34f7283386edfe92cc40, type: 3}
  - voice: Karen
    text: Today, Thursday the eighth, at half past six.
    clip: {fileID: 8300000, guid: 34016b91bc1954f2eadd37226bdeaecf, type: 3}
  - voice: Karen
    text: Your lower-right wisdom tooth, with Dr. Jang. You booked it on the twenty
      eighth.
    clip: {fileID: 8300000, guid: 39b669f0d3abc404aa52c5fd25b6aa73, type: 3}
  - voice: Karen
    text: It's a virtual account from our payment company, Gaon Pay. It's issued
      for your booking.
    clip: {fileID: 8300000, guid: 08d9671b2065d436ab30f926e48c80e7, type: 3}
  - voice: Karen
    text: I'm afraid not for evening slots, Ms. Kim. Too many people didn't turn
      up, so it has to be before five.
    clip: {fileID: 8300000, guid: f9ae66ede179d40abae22bebf18d1a2f, type: 3}
  - voice: Karen
    text: Ms. Kim? Shall I keep your slot?
    clip: {fileID: 8300000, guid: e5cc720c69cbb4bbc89844cdbe0123ef, type: 3}
  - voice: Karen
    text: I have someone on the waiting list for half past six. Are you sending it?
    clip: {fileID: 8300000, guid: 459d7f6e120cb4c4c89e86db15ed0889, type: 3}
  - voice: Karen
    text: Ten minutes until we release the evening slots.
    clip: {fileID: 8300000, guid: fcc9b90af7d25463e9bede550242d5f7, type: 3}
  - voice: Karen
    text: Five minutes, Ms. Kim. The next free slot is in three weeks.
    clip: {fileID: 8300000, guid: 8962f78f72c6f4941b6fb275268f09ed, type: 3}
  - voice: Karen
    text: It's five, Ms. Kim. I have to give the slot to the next patient. Call us
      to book again.
    clip: {fileID: 8300000, guid: 5732f27f030d046bbaa81896973c0164, type: 3}
  - voice: Karen
    text: Thank you, it's in. See you at half past six, Ms. Kim.
    clip: {fileID: 8300000, guid: 00798961eed0842fd965dfd689ecd104, type: 3}
  - voice: Karen
    text: It just says a check-up here, Ms. Kim. The doctor will go through it with
      you.
    clip: {fileID: 8300000, guid: 0edbe822daaa14c14aef49f60767a262, type: 3}
  - voice: Karen
    text: It's five, Ms. Kim. I'm releasing your slot.
    clip: {fileID: 8300000, guid: 9ac3d6a67005947328164379d0932d2a, type: 3}
  - voice: Karen
    text: Thank you. Your slot is confirmed. See you tonight.
    clip: {fileID: 8300000, guid: e4feb5d661e1941d199a6795546e167d, type: 3}
  - voice: Shelley (English (UK))
    text: Hello, is this Kim Jiwoo? This is Yoon Seora from Hangang Express, the
      customs clearance desk.
    clip: {fileID: 8300000, guid: 1f81052b4eebc49bd8930a6e7dd1ad0e, type: 3}
  - voice: Shelley (English (UK))
    text: I'm calling about your parcel from AliStar. The twenty seven inch monitor,
      tracking number H X, five five two zero, one one eight three, K R.
    clip: {fileID: 8300000, guid: d6ee8fb7ee2f5409c9838907c40d9e70, type: 3}
  - voice: Shelley (English (UK))
    text: Miss Kim? Are you there?
    clip: {fileID: 8300000, guid: 4f2a0c3f608f54602be3f09dbb48e08d, type: 3}
  - voice: Shelley (English (UK))
    text: It's held at Incheon customs. The import duty and VAT haven't been paid.
    clip: {fileID: 8300000, guid: d7d2def0d23fe41df913fd29971a761e, type: 3}
  - voice: Shelley (English (UK))
    text: It's on the customs declaration, Miss Kim. We see every item that comes
      through.
    clip: {fileID: 8300000, guid: 4e0a2b0d13c0d4de5aa911acc2fc2fb5, type: 3}
  - voice: Shelley (English (UK))
    text: It's held at Incheon customs because the import duty and VAT haven't been
      paid.
    clip: {fileID: 8300000, guid: 92ee8fa4d19c04a678364f6635dca5ee, type: 3}
  - voice: Shelley (English (UK))
    text: The total is fifty six thousand, six hundred won. Once it's paid, the monitor
      is released and delivered tomorrow.
    clip: {fileID: 8300000, guid: d47228164889041e0937b07f159c97f7, type: 3}
  - voice: Shelley (English (UK))
    text: Please pay it into our customs account. Nuri Bank, five six two zero, four
      four, zero one eight eight three zero.
    clip: {fileID: 8300000, guid: 04c84dbb9318e41f2922193e6dc88c6b, type: 3}
  - voice: Shelley (English (UK))
    text: The desk closes at five. After that the parcel goes back to the seller,
      and you pay the return shipping.
    clip: {fileID: 8300000, guid: 79532810b13454eaeb41d6fcdf7034d3, type: 3}
  - voice: Shelley (English (UK))
    text: I'll stay on the line while you pay.
    clip: {fileID: 8300000, guid: 2ac10cc3623ba401d8edca6a4b78ce91, type: 3}
  - voice: Shelley (English (UK))
    text: It's a virtual account in the name Hangang Express, customs. It's in the
      notice we sent you this morning.
    clip: {fileID: 8300000, guid: 1ce432478d348447091c5d3e8019f65d, type: 3}
  - voice: Shelley (English (UK))
    text: Orders over a hundred and fifty dollars pay duty and VAT when they arrive,
      unless the seller collected it.
    clip: {fileID: 8300000, guid: 435104241585f42bca987d89b401c6e8, type: 3}
  - voice: Shelley (English (UK))
    text: 'It says the same as I''m telling you now: held at customs, the amount
      and the account. Please check it.'
    clip: {fileID: 8300000, guid: fe7071fea6247441dbc0a0a2d5042ffe, type: 3}
  - voice: Shelley (English (UK))
    text: Our customer centre, one five eight eight, five five two zero. It's the
      number I'm calling from. Ask for the customs desk.
    clip: {fileID: 8300000, guid: 1c121717d2cf243a78451f070635c69f, type: 3}
  - voice: Shelley (English (UK))
    text: Miss Kim, the payment has to reach us before the desk closes.
    clip: {fileID: 8300000, guid: 207120e17ef6f4b60abd02cd56901e1e, type: 3}
  - voice: Shelley (English (UK))
    text: Miss Kim? The customs desk is asking whether the payment is on its way.
    clip: {fileID: 8300000, guid: f7c0cf0f60c524146ab2977e95cbdaa0, type: 3}
  - voice: Shelley (English (UK))
    text: Eight minutes before the desk closes.
    clip: {fileID: 8300000, guid: f210c3785fb704d91b7e004dac750b57, type: 3}
  - voice: Shelley (English (UK))
    text: Three minutes. After five I can't stop the return.
    clip: {fileID: 8300000, guid: 5c4bbbd0f70cd435d8b98d4589fcd0cb, type: 3}
  - voice: Shelley (English (UK))
    text: Miss Kim? The desk has closed. I'll have to mark it for return.
    clip: {fileID: 8300000, guid: 15e3dad339ac1422483060b23b05b2b3, type: 3}
  - voice: Shelley (English (UK))
    text: Payment received. Your monitor will be delivered tomorrow afternoon. Thank
      you, Miss Kim.
    clip: {fileID: 8300000, guid: 857e40ccbb7674cff9a414df1029a73e, type: 3}
  - voice: Shelley (English (UK))
    text: Please pay it into our customs account. Hanbit Bank, six two zero, five
      five seven, three zero one one four four.
    clip: {fileID: 8300000, guid: be8da8e77253b4de7b1d6cc14f4d73e3, type: 3}
  - voice: Shelley (English (UK))
    text: KR Customs Clearance. We handle customs for Hangang Express.
    clip: {fileID: 8300000, guid: f7d9b74685e2449059ba6960008f18e9, type: 3}
  - voice: Shelley (English (UK))
    text: Please ignore the automatic notice, Miss Kim. Customs changed your parcel's
      status after it went out.
    clip: {fileID: 8300000, guid: 0d8d632008114421ebad527616ed83c9, type: 3}
  - voice: Shelley (English (UK))
    text: This line. One five eight eight, five five zero two. Ask for the customs
      desk.
    clip: {fileID: 8300000, guid: 7620cc626ca61432c8d06a86599239e1, type: 3}
  - voice: Shelley (English (UK))
    text: Miss Kim? Fine. Your parcel will be returned.
    clip: {fileID: 8300000, guid: 37d362b5fcb9b4e6d8ba9263cda90ee2, type: 3}
  - voice: Shelley (English (UK))
    text: Thank you. Oh, and there's a storage fee as well. I'll call you back about
      it.
    clip: {fileID: 8300000, guid: 3a133b7cbfa114173966f45440047b27, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC548\uB155\uD558\uC138\uC694, \uAE40\uC9C0\uC6B0 \uB2D8 \uB9DE\uC73C\uC2DC\uC8E0?
      \uC0C8\uBD04\uCE58\uACFC \uBB38\uC9C0\uD61C \uC2E4\uC7A5\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: a9570f9de1b0a413798b24eba3ade38e, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC624\uB298 \uC800\uB141 \uC5EC\uC12F \uC2DC \uC0BC\uC2ED \uBD84 \uC608\uC57D
      \uAC74\uC73C\uB85C \uC5F0\uB77D\uB4DC\uB838\uC5B4\uC694."
    clip: {fileID: 8300000, guid: c379d79d067f14ba2917e129ed7b0d60, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC5EC\uBCF4\uC138\uC694? \uAE40\uC9C0\uC6B0 \uB2D8?"
    clip: {fileID: 8300000, guid: aaf5dcf1d50624ccaa91118944dcfe02, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uBB38\uC81C\uB294 \uC544\uB2C8\uACE0\uC694, \uC608\uC57D \uD655\uC778
      \uC804\uD654\uC608\uC694."
    clip: {fileID: 8300000, guid: a4062b55028ec4c39aad4921a09e51de, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC608\uC57D\uD558\uC2E4 \uB54C \uB0A8\uAE30\uC2E0 \uBC88\uD638\uC608\uC694.
      \uC800\uB141 \uC9C4\uB8CC \uD658\uC790\uBD84\uB4E4\uAED8\uB294 \uB2F9\uC77C\uC5D0
      \uB2E4 \uC804\uD654\uB4DC\uB824\uC694."
    clip: {fileID: 8300000, guid: a83df7a2e556a47b482b571284a2e236, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC800\uB141 \uC2DC\uAC04\uC740 \uC790\uB9AC\uAC00 \uC801\uC5B4\uC11C
      \uC608\uC57D\uAE08 \uC0BC\uB9CC \uC6D0\uC744 \uBC1B\uACE0 \uC788\uC5B4\uC694.
      \uC624\uB298 \uC9C4\uB8CC\uBE44\uC5D0\uC11C \uADF8\uB300\uB85C \uBE60\uC9D1\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: fb47d3b1c9de44d22b5a6015f3b81f1b, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uACB0\uC81C \uACC4\uC88C\uB85C \uBCF4\uB0B4 \uC8FC\uC138\uC694. \uB204\uB9AC\uC740\uD589
      \uC624\uC721\uC774\uACF5, \uCE60\uC77C, \uC0BC\uC0BC\uC721\uACF5\uC774\uAD6C\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: b642e6b30e8184a91b5336fb3121be4f, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uAC00 \uB418\uBA74 \uD655\uC815 \uC548 \uB41C \uC608\uC57D\uC740
      \uB2E4\uB978 \uBD84\uAED8 \uB118\uC5B4\uAC00\uC694. \uBCF4\uB0B4\uC2DC\uB294
      \uB3D9\uC548 \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 8ff3965ff6b414861b17bc655a25fe53, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC624\uB298, \uD314 \uC77C \uBAA9\uC694\uC77C \uC800\uB141 \uC5EC\uC12F
      \uC2DC \uC0BC\uC2ED \uBD84\uC774\uC694."
    clip: {fileID: 8300000, guid: 1cdb394d734b04fe99dd7cb3d9fdafbd, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC624\uB978\uCABD \uC544\uB798 \uC0AC\uB791\uB2C8 \uBC1C\uCE58\uC694,
      \uC7A5 \uC6D0\uC7A5\uB2D8 \uC9C4\uB8CC\uACE0\uC694. \uC774\uC2ED\uD314 \uC77C\uC5D0
      \uC608\uC57D\uD558\uC168\uC5B4\uC694."
    clip: {fileID: 8300000, guid: fc5b1719cd6ea4cb59ff7110f4d311be, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uACB0\uC81C\uB300\uD589\uC0AC \uAC00\uC628\uD398\uC774\uC758 \uAC00\uC0C1\uACC4\uC88C\uC608\uC694.
      \uACE0\uAC1D\uB2D8 \uC608\uC57D \uAC74\uC73C\uB85C \uBC1C\uAE09\uB41C \uAC70\uACE0\uC694."
    clip: {fileID: 8300000, guid: f069f40a310bb4afcb77ab4e956aec0e, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC800\uB141 \uC9C4\uB8CC\uB294 \uC548 \uB3FC\uC694, \uACE0\uAC1D\uB2D8.
      \uC548 \uC624\uC2DC\uB294 \uBD84\uC774 \uB108\uBB34 \uB9CE\uC544\uC11C \uB2E4\uC12F
      \uC2DC \uC804\uC5D0 \uBC1B\uACE0 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 96803ba3fc0f24bf3b864aba840b03b4, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uAE40\uC9C0\uC6B0 \uB2D8? \uC608\uC57D \uC720\uC9C0\uD560\uAE4C\uC694?"
    clip: {fileID: 8300000, guid: 0d02d77226d17464689428f21c14794e, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC5EC\uC12F \uC2DC \uC0BC\uC2ED \uBD84 \uB300\uAE30\uC790\uAC00 \uD55C
      \uBD84 \uACC4\uC138\uC694. \uBCF4\uB0B4\uACE0 \uACC4\uC2E0\uAC00\uC694?"
    clip: {fileID: 8300000, guid: d0048dba296be4f6882a3dbd857fcca4, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC800\uB141 \uC608\uC57D \uC815\uB9AC\uAE4C\uC9C0 \uC2ED \uBD84 \uB0A8\uC558\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 1af0dcc383fd0449a97da3bde4769382, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC624 \uBD84 \uB0A8\uC558\uC5B4\uC694, \uACE0\uAC1D\uB2D8. \uB2E4\uC74C
      \uBE48 \uC2DC\uAC04\uC740 \uC0BC \uC8FC \uB4A4\uC608\uC694."
    clip: {fileID: 8300000, guid: fd1ba4f170ff04f8fb3c95db577c0f66, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uAC00 \uB410\uC5B4\uC694, \uACE0\uAC1D\uB2D8. \uB2E4\uC74C
      \uBD84\uAED8 \uC790\uB9AC\uB97C \uB4DC\uB824\uC57C \uD574\uC694. \uB2E4\uC2DC
      \uC608\uC57D\uD558\uC2DC\uB824\uBA74 \uC804\uD654 \uC8FC\uC138\uC694."
    clip: {fileID: 8300000, guid: 215e19761e7f341f194f6cc6bfe975e4, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC785\uAE08 \uD655\uC778\uB410\uC5B4\uC694. \uC5EC\uC12F \uC2DC \uC0BC\uC2ED
      \uBD84\uC5D0 \uBD50\uAC8C\uC694, \uACE0\uAC1D\uB2D8."
    clip: {fileID: 8300000, guid: 0415199fc2c764a40944eb33505eae0e, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uC5EC\uAE30\uB294 \uADF8\uB0E5 \uAC80\uC9C4\uC774\uB77C\uACE0\uB9CC \uB098\uC640
      \uC788\uC5B4\uC694. \uC790\uC138\uD55C \uAC74 \uC6D0\uC7A5\uB2D8\uC774 \uC124\uBA85\uD574
      \uC8FC\uC2E4 \uAC70\uC608\uC694."
    clip: {fileID: 8300000, guid: a7b873c610a1f4409976f8761a33b716, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uB2E4\uC12F \uC2DC\uB124\uC694, \uACE0\uAC1D\uB2D8. \uC608\uC57D\uC740
      \uCDE8\uC18C \uCC98\uB9AC\uD560\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 00466fb438af640ac9415528b465ec14, type: 3}
  - voice: Shelley (Korean (South Korea))
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC608\uC57D \uD655\uC815\uB410\uC5B4\uC694.
      \uC774\uB530 \uBD50\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 703f116624ac647fdbe0dddeebc8a952, type: 3}
  - voice: Yuna
    text: "\uC548\uB155\uD558\uC138\uC694, \uAE40\uC9C0\uC6B0 \uACE0\uAC1D\uB2D8
      \uB9DE\uC73C\uC2DC\uC8E0? \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 \uD1B5\uAD00\uD300
      \uC724\uC11C\uB77C\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: cecae1a12a98a466b99f72e31c53b908, type: 3}
  - voice: Yuna
    text: "\uC54C\uB9AC\uC2A4\uD0C0\uC5D0\uC11C \uC8FC\uBB38\uD558\uC2E0 \uC774\uC2ED\uCE60
      \uC778\uCE58 \uBAA8\uB2C8\uD130 \uAC74\uC73C\uB85C \uC5F0\uB77D\uB4DC\uB838\uC5B4\uC694.
      \uC6B4\uC1A1\uC7A5 \uBC88\uD638 \uC5D0\uC774\uCE58 \uC5D1\uC2A4, \uC624\uC624\uC774\uACF5,
      \uC77C\uC77C\uD314\uC0BC, \uCF00\uC774 \uC54C\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: a3e9b92f3ca454d8494948c9684de651, type: 3}
  - voice: Yuna
    text: "\uAE40\uC9C0\uC6B0 \uACE0\uAC1D\uB2D8? \uB4E4\uB9AC\uC138\uC694?"
    clip: {fileID: 8300000, guid: 329868c808e7446f190ef000489a04fe, type: 3}
  - voice: Yuna
    text: "\uC778\uCC9C\uC138\uAD00\uC5D0 \uBCF4\uB958\uB418\uC5B4 \uC788\uC5B4\uC694.
      \uAD00\uC138\uC640 \uBD80\uAC00\uC138\uAC00 \uB0A9\uBD80\uB418\uC9C0 \uC54A\uC558\uAC70\uB4E0\uC694."
    clip: {fileID: 8300000, guid: f087cb4d045284e678b862d4c9b19c95, type: 3}
  - voice: Yuna
    text: "\uD1B5\uAD00 \uC2E0\uACE0\uC11C\uC5D0 \uB2E4 \uB098\uC640 \uC788\uC5B4\uC694,
      \uACE0\uAC1D\uB2D8. \uB4E4\uC5B4\uC624\uB294 \uBB3C\uD488\uC740 \uC800\uD76C\uAC00
      \uC804\uBD80 \uD655\uC778\uD558\uAC70\uB4E0\uC694."
    clip: {fileID: 8300000, guid: 3da89fdc3e18345159841d97dee7c953, type: 3}
  - voice: Yuna
    text: "\uAD00\uC138\uC640 \uBD80\uAC00\uC138\uAC00 \uB0A9\uBD80\uB418\uC9C0 \uC54A\uC544\uC11C
      \uC778\uCC9C\uC138\uAD00\uC5D0 \uBCF4\uB958\uB418\uC5B4 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 944be4104c2464f5697e8298aeece7b6, type: 3}
  - voice: Yuna
    text: "\uCD1D \uC624\uB9CC \uC721\uCC9C\uC721\uBC31 \uC6D0\uC774\uC5D0\uC694.
      \uB0A9\uBD80\uB418\uBA74 \uBC14\uB85C \uD1B5\uAD00\uB418\uACE0 \uB0B4\uC77C
      \uBC30\uC1A1\uB429\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 2933f674695df4756bac8e61701b5c58, type: 3}
  - voice: Yuna
    text: "\uAD00\uC138 \uACC4\uC88C\uB85C \uB0A9\uBD80\uD574 \uC8FC\uC138\uC694.
      \uB204\uB9AC\uC740\uD589, \uC624\uC721\uC774\uACF5, \uC0AC\uC0AC, \uACF5\uC77C\uD314\uD314\uC0BC\uACF5\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 0029ececc84e544c4b83927ed190253b, type: 3}
  - voice: Yuna
    text: "\uD1B5\uAD00\uD300\uC740 \uB2E4\uC12F \uC2DC\uC5D0 \uB9C8\uAC10\uD574\uC694.
      \uADF8 \uB4A4\uB85C\uB294 \uD310\uB9E4\uC790\uC5D0\uAC8C \uBC18\uC1A1\uB418\uACE0,
      \uBC18\uC1A1\uBE44\uB294 \uACE0\uAC1D\uB2D8 \uBD80\uB2F4\uC774\uC5D0\uC694."
    clip: {fileID: 8300000, guid: 83b8228f77c1e43d3b43cdff467a3a21, type: 3}
  - voice: Yuna
    text: "\uB0A9\uBD80\uD558\uC2DC\uB294 \uB3D9\uC548 \uAE30\uB2E4\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 002e3453c419d44c68b9a95a1396fef8, type: 3}
  - voice: Yuna
    text: "\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 \uAD00\uC138 \uBA85\uC758\uC758
      \uAC00\uC0C1\uACC4\uC88C\uC608\uC694. \uC624\uB298 \uC544\uCE68\uC5D0 \uBCF4\uB0B4
      \uB4DC\uB9B0 \uC54C\uB9BC\uC5D0\uB3C4 \uB611\uAC19\uC774 \uB098\uC640 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 9b38c9c8ef23343fba192ac757f3d21c, type: 3}
  - voice: Yuna
    text: "\uBC31\uC624\uC2ED \uB2EC\uB7EC\uAC00 \uB118\uB294 \uC8FC\uBB38\uC740
      \uB3C4\uCC29\uD560 \uB54C \uAD00\uC138\uC640 \uBD80\uAC00\uC138\uB97C \uB0B4\uC154\uC57C
      \uD574\uC694. \uD310\uB9E4\uC790\uAC00 \uBBF8\uB9AC \uBC1B\uC740 \uACBD\uC6B0\uB9CC
      \uBE7C\uACE0\uC694."
    clip: {fileID: 8300000, guid: d8b6bcc3b611347e0b986eb321b94b1d, type: 3}
  - voice: Yuna
    text: "\uC9C0\uAE08 \uB9D0\uC500\uB4DC\uB9B0 \uADF8\uB300\uB85C \uC801\uD600
      \uC788\uC5B4\uC694. \uC138\uAD00 \uBCF4\uB958, \uAE08\uC561, \uACC4\uC88C\uAE4C\uC9C0\uC694.
      \uD655\uC778\uD574 \uBCF4\uC138\uC694."
    clip: {fileID: 8300000, guid: e4e35a14fdabf40dfbe9387fab991923, type: 3}
  - voice: Yuna
    text: "\uACE0\uAC1D\uC13C\uD130 \uC77C\uC624\uD314\uD314, \uC624\uC624\uC774\uACF5\uC774\uC694.
      \uC9C0\uAE08 \uAC70\uB294 \uBC88\uD638\uC608\uC694. \uD1B5\uAD00\uD300 \uCC3E\uC73C\uC2DC\uBA74
      \uB3FC\uC694."
    clip: {fileID: 8300000, guid: 846657bef71f34853829a2e9373bd595, type: 3}
  - voice: Yuna
    text: "\uACE0\uAC1D\uB2D8, \uB9C8\uAC10 \uC804\uAE4C\uC9C0 \uC785\uAE08\uC774
      \uD655\uC778\uB3FC\uC57C \uD574\uC694."
    clip: {fileID: 8300000, guid: d8cb3fb0ab89842509c123faf2ae488d, type: 3}
  - voice: Yuna
    text: "\uACE0\uAC1D\uB2D8? \uD1B5\uAD00\uD300\uC5D0\uC11C \uB0A9\uBD80 \uC9C4\uD589
      \uC911\uC774\uC2E0\uC9C0 \uBB3B\uACE0 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 2cae65fc1c0b149c18f37ca2c7f50b18, type: 3}
  - voice: Yuna
    text: "\uB9C8\uAC10\uAE4C\uC9C0 \uD314 \uBD84 \uB0A8\uC558\uC5B4\uC694."
    clip: {fileID: 8300000, guid: ae429bb597a9c472f9b5a6e56436e45e, type: 3}
  - voice: Yuna
    text: "\uC0BC \uBD84 \uB0A8\uC558\uC5B4\uC694. \uB2E4\uC12F \uC2DC\uAC00 \uC9C0\uB098\uBA74
      \uBC18\uC1A1\uC744 \uB9C9\uC744 \uC218 \uC5C6\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 4e51213e958e7430bac9f5127fb4bd31, type: 3}
  - voice: Yuna
    text: "\uACE0\uAC1D\uB2D8? \uD1B5\uAD00\uD300\uC774 \uB9C8\uAC10\uB410\uC5B4\uC694.
      \uBC18\uC1A1 \uCC98\uB9AC\uD560 \uC218\uBC16\uC5D0 \uC5C6\uACA0\uB124\uC694."
    clip: {fileID: 8300000, guid: f3c9328cfeb0c4e6087d32233500bad3, type: 3}
  - voice: Yuna
    text: "\uB0A9\uBD80 \uD655\uC778\uB410\uC5B4\uC694. \uBAA8\uB2C8\uD130\uB294
      \uB0B4\uC77C \uC624\uD6C4\uC5D0 \uBC30\uC1A1\uB420 \uAC70\uC608\uC694. \uAC10\uC0AC\uD569\uB2C8\uB2E4,
      \uACE0\uAC1D\uB2D8."
    clip: {fileID: 8300000, guid: 46b3c7563e0c646c89a3e22629e7dea5, type: 3}
  - voice: Yuna
    text: "\uAD00\uC138 \uACC4\uC88C\uB85C \uB0A9\uBD80\uD574 \uC8FC\uC138\uC694.
      \uD55C\uBE5B\uC740\uD589, \uC721\uC774\uACF5, \uC624\uC624\uCE60, \uC0BC\uACF5\uC77C\uC77C\uC0AC\uC0AC\uC785\uB2C8\uB2E4."
    clip: {fileID: 8300000, guid: 2dd4cb0f06b904131ba3d1a929fea18f, type: 3}
  - voice: Yuna
    text: "\uCF00\uC774\uC54C\uD1B5\uAD00\uC774\uC5D0\uC694. \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
      \uD1B5\uAD00 \uC5C5\uBB34\uB97C \uB300\uD589\uD558\uACE0 \uC788\uC5B4\uC694."
    clip: {fileID: 8300000, guid: af8db93b9da4f499f853ef642ebf1de6, type: 3}
  - voice: Yuna
    text: "\uC790\uB3D9 \uC54C\uB9BC\uC740 \uBB34\uC2DC\uD574 \uC8FC\uC138\uC694,
      \uACE0\uAC1D\uB2D8. \uC54C\uB9BC\uC774 \uB098\uAC04 \uB4A4\uC5D0 \uC138\uAD00\uC5D0\uC11C
      \uC0C1\uD0DC\uAC00 \uBC14\uB00C\uC5C8\uC5B4\uC694."
    clip: {fileID: 8300000, guid: 0d538f44bd00e482aa74067decdfa943, type: 3}
  - voice: Yuna
    text: "\uC9C0\uAE08 \uC774 \uBC88\uD638\uC694. \uC77C\uC624\uD314\uD314, \uC624\uC624\uACF5\uC774\uB85C
      \uAC70\uC154\uC11C \uD1B5\uAD00\uD300 \uCC3E\uC73C\uC2DC\uBA74 \uB3FC\uC694."
    clip: {fileID: 8300000, guid: cf7e8b8aa29d14f45b3eed7cc1db7d0f, type: 3}
  - voice: Yuna
    text: "\uACE0\uAC1D\uB2D8? \uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uD0DD\uBC30\uB294
      \uBC18\uC1A1 \uCC98\uB9AC\uD560\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 79e47e09990b04507b4648e8a647684d, type: 3}
  - voice: Yuna
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC544, \uBCF4\uAD00\uB8CC\uB3C4 \uB530\uB85C
      \uC788\uC5B4\uC694. \uADF8\uAC74 \uB2E4\uC2DC \uC5F0\uB77D\uB4DC\uB9B4\uAC8C\uC694."
    clip: {fileID: 8300000, guid: 6ff89ec25d3644e92bd827d2ab9e48e9, type: 3}
