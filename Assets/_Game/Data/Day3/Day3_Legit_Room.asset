      value: 18,420 won
      isFact: 0
      factKind: 6
    - label: Paid
      value: 28 Sep (auto-pay)
      isFact: 0
      factKind: 6
    body: 'Safety inspection this month: Wednesday 14 October. Our inspectors carry
      an ID card and never ask for money.'
