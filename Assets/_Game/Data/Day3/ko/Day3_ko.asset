      headline: "\uD574\uC678\uC9C1\uAD6C, \uC9C4\uC9DC \uAD00\uC138\uC77C \uB54C"
      subhead: "\uD0DD\uBC30\uC0AC\uB4E4\uC740 \uAD00\uC138 \uBCF4\uB958 \uD0DD\uBC30\uAC00
        \uB298\uACE0 \uC788\uB2E4\uBA70, \uB0B4\uAE30 \uC804\uC5D0 \uD655\uC778\uD558\uB294
        \uAC83\uC774 \uC633\uB2E4\uACE0 \uB9D0\uD55C\uB2E4."
      body: "\uD574\uC678\uC9C1\uAD6C\uAC00 \uB298\uBA74\uC11C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uB294
        \uAD00\uC138\xB7\uBD80\uAC00\uC138 \uBBF8\uB0A9\uC73C\uB85C \uC778\uCC9C\uC5D0
        \uBCF4\uB958\uB418\uB294 \uD0DD\uBC30\uAC00 \uD558\uB8E8 \uC218\uBC31 \uAC74\uC5D0
        \uC774\uB978\uB2E4\uACE0 \uBC1D\uD614\uB2E4. \uB300\uBD80\uBD84 \uD310\uB9E4\uC790\uAC00
        \uACB0\uC81C \uB54C \uC138\uAE08\uC744 \uBC1B\uC9C0 \uC54A\uC740 \uACBD\uC6B0\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uD1B5\uAD00\uD300 \uC724\uC11C\uB77C \uC528\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74
        \uC54C\uB9BC\uC744 \uBCF4\uB0B4\uACE0 1588-5520\uC73C\uB85C \uC804\uD654\uD55C\uB2E4\"\uBA70
        \"\uACC4\uC88C\uB294 \uC5B8\uC81C\uB098 \uC800\uD76C \uBA85\uC758\uC758 \uAC00\uC0C1\uACC4\uC88C\"\uB77C\uACE0
        \uB9D0\uD588\uB2E4. \uADF8\uB294 \"\uC774\uAC78 \uBA3C\uC800 \uD655\uC778\uD558\uB294
        \uACE0\uAC1D\uC774\uC57C\uB9D0\uB85C \uC81C\uB300\uB85C \uD558\uB294 \uAC83\"\uC774\uB77C\uACE0
        \uB367\uBD99\uC600\uB2E4.\n\n\uAC1C\uC778 \uD574\uC678\uC9C1\uAD6C\uB294
        \uBBF8\uD654 150\uB2EC\uB7EC\uAE4C\uC9C0 \uBA74\uC138\uB2E4. \uADF8 \uC774\uC0C1\uC774\uBA74
        \uD310\uB9E4\uC790\uAC00 \uBBF8\uB9AC \uBC1B\uC9C0 \uC54A\uC740 \uD55C \uB3C4\uCC29
        \uC2DC \uAD00\uC138\uC640 \uBD80\uAC00\uC138\uB97C \uB0B4\uC57C \uD55C\uB2E4."
      verdictNote: "\uAD00\uC138\uB294 \uC9C4\uC9DC\uC600\uACE0, \uB2F9\uC2E0\uC740
        \uD655\uC778\uD588\uB2E4. \uD0DD\uBC30\uC0AC \uC54C\uB9BC, \uC54C\uB9AC\uC2A4\uD0C0
        \uBA54\uC2DC\uC9C0, \uACF5\uC2DD \uBC88\uD638, \uC608\uAE08\uC8FC \uC774\uB984\uC774
        \uBAA8\uB450 \uC77C\uCE58\uD588\uB2E4."
      print: {fileID: 0}
    - outcome: 1
      headline: "\uC0AC\uAE30 \uAE30\uC2B9\uC5D0 \uC9C4\uC9DC \uAD00\uC138 \uC548\uB0B4\uB3C4
        \uC678\uBA74"
      subhead: "\uACE0\uAC1D\uB4E4\uC774 \uC9C4\uC9DC \uD1B5\uAD00 \uC804\uD654\uB9C8\uC800
        \uB04A\uC73C\uBA74\uC11C \uC778\uCC9C\uC5D0 \uD0DD\uBC30\uAC00 \uC313\uC774\uACE0
        \uC788\uB2E4."
      body: "\uD574\uC678\uC9C1\uAD6C\uAC00 \uB298\uBA74\uC11C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uB294
        \uAD00\uC138\xB7\uBD80\uAC00\uC138 \uBBF8\uB0A9\uC73C\uB85C \uC778\uCC9C\uC5D0
        \uBCF4\uB958\uB418\uB294 \uD0DD\uBC30\uAC00 \uD558\uB8E8 \uC218\uBC31 \uAC74\uC5D0
        \uC774\uB978\uB2E4\uACE0 \uBC1D\uD614\uB2E4. \uB300\uBD80\uBD84 \uD310\uB9E4\uC790\uAC00
        \uACB0\uC81C \uB54C \uC138\uAE08\uC744 \uBC1B\uC9C0 \uC54A\uC740 \uACBD\uC6B0\uB2E4.
        \uBA87 \uC8FC\uC9F8 \uAC00\uC9DC \uAD00\uC138 \uBB38\uC790\uAC00 \uC774\uC5B4\uC9C0\uC790
        \uC9C4\uC9DC \uC548\uB0B4 \uC804\uD654\uAE4C\uC9C0 \uB04A\uB294 \uACE0\uAC1D\uC774
        \uB9CE\uC544\uC84C\uACE0, \uC5B4\uC81C\uB9CC \uC218\uC2ED \uAC74\uC758 \uD0DD\uBC30\uAC00
        \uBC18\uC1A1\uB410\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 \uD1B5\uAD00\uD300
        \uC724\uC11C\uB77C \uC528\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74 \uC54C\uB9BC\uC744
        \uBCF4\uB0B4\uACE0 1588-5520\uC73C\uB85C \uC804\uD654\uD55C\uB2E4\"\uBA70
        \"\uACC4\uC88C\uB294 \uC5B8\uC81C\uB098 \uC800\uD76C \uBA85\uC758\uC758 \uAC00\uC0C1\uACC4\uC88C\"\uB77C\uACE0
        \uB9D0\uD588\uB2E4. \uADF8\uB294 \"\uD655\uC778\uC740 \uAF2D \uD558\uC2DC\uB77C.
        \uB2E4\uB9CC \uBD88\uC548\uD55C \uB9C8\uC74C\uC774 \uC544\uB2C8\uB77C \uC0AC\uC2E4\uB85C
        \uD655\uC778\uD558\uC2DC\uB77C\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uAC1C\uC778
        \uD574\uC678\uC9C1\uAD6C\uB294 \uBBF8\uD654 150\uB2EC\uB7EC\uAE4C\uC9C0 \uBA74\uC138\uB2E4.
        \uADF8 \uC774\uC0C1\uC774\uBA74 \uD310\uB9E4\uC790\uAC00 \uBBF8\uB9AC \uBC1B\uC9C0
        \uC54A\uC740 \uD55C \uB3C4\uCC29 \uC2DC \uAD00\uC138\uC640 \uBD80\uAC00\uC138\uB97C
        \uB0B4\uC57C \uD55C\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uD0DD\uBC30\uC0AC
        \uC54C\uB9BC\uC5D0 \uAC19\uC740 \uAD00\uC138\uC640 \uACC4\uC88C\uAC00 \uB098\uC640
        \uC788\uC5C8\uACE0, \uC804\uD654\uB3C4 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uACF5\uC2DD \uBC88\uD638\uC600\uB2E4."
      print: {fileID: 0}
    - outcome: 3
      headline: "\uAD00\uC138 \uBBF8\uB0A9\uC73C\uB85C \uBC18\uC1A1\uB418\uB294 \uD0DD\uBC30\uB4E4"
      subhead: "\uACB0\uC815\uC744 \uBBF8\uB8EC \uACE0\uAC1D\uB4E4\uC758 \uC8FC\uBB38\uD488\uC774
        \uBC18\uC1A1 \uB300\uAE30\uC5F4\uB85C \uB118\uC5B4\uAC14\uB2E4."
      body: "\uD574\uC678\uC9C1\uAD6C\uAC00 \uB298\uBA74\uC11C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uB294
        \uAD00\uC138\xB7\uBD80\uAC00\uC138 \uBBF8\uB0A9\uC73C\uB85C \uC778\uCC9C\uC5D0
        \uBCF4\uB958\uB418\uB294 \uD0DD\uBC30\uAC00 \uD558\uB8E8 \uC218\uBC31 \uAC74\uC5D0
        \uC774\uB978\uB2E4\uACE0 \uBC1D\uD614\uB2E4. \uB300\uBD80\uBD84 \uD310\uB9E4\uC790\uAC00
        \uACB0\uC81C \uB54C \uC138\uAE08\uC744 \uBC1B\uC9C0 \uC54A\uC740 \uACBD\uC6B0\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uD1B5\uAD00\uD300 \uC724\uC11C\uB77C \uC528\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74
        \uC54C\uB9BC\uC744 \uBCF4\uB0B4\uACE0 1588-5520\uC73C\uB85C \uC804\uD654\uD55C\uB2E4\"\uBA70
        \"\uACC4\uC88C\uB294 \uC5B8\uC81C\uB098 \uC800\uD76C \uBA85\uC758\uC758 \uAC00\uC0C1\uACC4\uC88C\"\uB77C\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uAC1C\uC778 \uD574\uC678\uC9C1\uAD6C\uB294 \uBBF8\uD654
        150\uB2EC\uB7EC\uAE4C\uC9C0 \uBA74\uC138\uB2E4. \uADF8 \uC774\uC0C1\uC774\uBA74
        \uD310\uB9E4\uC790\uAC00 \uBBF8\uB9AC \uBC1B\uC9C0 \uC54A\uC740 \uD55C \uB3C4\uCC29
        \uC2DC \uAD00\uC138\uC640 \uBD80\uAC00\uC138\uB97C \uB0B4\uC57C \uD55C\uB2E4."
      verdictNote: "\uAD00\uC138\uB294 \uC9C4\uC9DC\uC600\uACE0, \uC99D\uAC70\uB294
        \uD0DD\uBC30\uC0AC \uC54C\uB9BC\uACFC \uC54C\uB9AC\uC2A4\uD0C0 \uBA54\uC2DC\uC9C0\uC5D0
        \uC788\uC5C8\uB2E4. \uC81C\uB54C \uACB0\uC815\uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 0}
    ruleTitle: "\uAD00\uC138\uB294 \uD0DD\uBC30\uC0AC\uC5D0\uB9CC"
    rule: "\uC9C4\uC9DC \uAD00\uC138\uB294 \uD0DD\uBC30\uC0AC\uAC00 \uC9C1\uC811
      \uBCF4\uB0B8 \uC54C\uB9BC\uC5D0 \uD0DD\uBC30\uC0AC \uBA85\uC758 \uACC4\uC88C\uC640
      \uD568\uAED8 \uB098\uC628\uB2E4. \uC804\uD654 \uB0B4\uC6A9\uACFC \uC77C\uCE58\uD558\uBA74
      \uB0B4\uB3C4 \uC548\uC804\uD558\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 9\uC77C"
  - id: dentist_scam
    scenario: dentist
    intro: "\uC911\uAC04\uACE0\uC0AC\uB294 \uB2E4\uC74C \uC8FC. \uB2E8\uC218\uB294
      \uC815\uC624\uC5D0 \uB05D\uB0AC\uACE0, \uB2EC\uB825\uC5D0\uB294 \uC77C\uC8FC\uC77C
      \uB0B4\uB0B4 \uCE58\uACFC \uC608\uC57D\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    conversation: {fileID: 11400000, guid: eda2ec711ecdb43088ad005ce2ebcfb0, type: 2}
    phone: {fileID: 11400000, guid: 9e30795f117ba496aa097c630864376a, type: 2}
    room: {fileID: 11400000, guid: 967828ac03b2a4eb2b80a733a282e455, type: 2}
    directory: {fileID: 11400000, guid: 67ac74b5d5bd5474fa4acbf6f1744023, type: 2}
    clues:
    - id: calendar
      text: "\uB2EC\uB825\uC744 \uBCF4\uB2C8 \uC624\uB298 \uC544\uCE68 \uCE58\uACFC
        \uC608\uC57D\uC744 22\uC77C(\uBAA9)\uB85C \uC62E\uACBC\uB2E4. \uC624\uB298\uC740
        \uC608\uC57D\uAE08\uC744 \uB0BC \uC608\uC57D \uC790\uCCB4\uAC00 \uC5C6\uB2E4."
      where: "\uBCBD\uC5D0 \uAC78\uB9B0 \uB2EC\uB825"
      guide: 
      when:
      - kind: 0
        target: Calendar
    papers:
    - outcome: 1
      headline: "\uC608\uC57D \uC571 \uC720\uCD9C \uB4A4 \uAC00\uC9DC '\uC608\uC57D\uAE08'
        \uC804\uD654"
      subhead: "\uC0C1\uB300\uB294 \uC608\uC57D\uC744 \uC54C\uACE0 \uC788\uC5C8\uB2E4.
        \uC608\uC57D\uC774 \uC62E\uACA8\uC9C4 \uAC74 \uBAB0\uB790\uB2E4."
      body: "\uBAA9\uC694\uC77C, \uB9C8\uD3EC \uC77C\uB300 \uBCD1\uC6D0 \uD658\uC790\uB4E4\uC5D0\uAC8C
        \uC774\uB984\uACFC \uC608\uC57D \uC2DC\uAC04\uC744 \uC544\uB294 '\uC2E4\uC7A5'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uADF8\uB294 \uC800\uB141 \uC9C4\uB8CC\uB294
        \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uC608\uC57D\uAE08 3\uB9CC \uC6D0\uC744
        \uB0B4\uC57C \uD55C\uB2E4\uACE0 \uD588\uB2E4.\n\n\uC774 \uC815\uBCF4\uB294
        \uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774\uC5D0\uC11C \uC720\uCD9C\uB41C
        \uAC83\uC774\uC5C8\uB2E4. \uBA85\uB2E8\uC740 \uC77C\uC8FC\uC77C \uC804 \uAC83\uC774\uC5B4\uC11C,
        \uADF8\uC0AC\uC774 \uC608\uC57D\uC744 \uC62E\uAE30\uAC70\uB098 \uCDE8\uC18C\uD55C
        \uD658\uC790\uB4E4\uB3C4 \uC774\uBBF8 \uC5C6\uB294 \uC608\uC57D\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC558\uB2E4. \uC608\uC57D\uAE08\uC740 \uB4A4\uC5D0
        \uB204\uAC00 \uC788\uB294\uC9C0 \uB4DC\uB7EC\uB098\uC9C0 \uC54A\uB294 \uACB0\uC81C\uB300\uD589\uC0AC
        \uAC00\uC0C1\uACC4\uC88C\uB85C \uB4E4\uC5B4\uAC14\uB2E4.\n\n\uB9C8\uD3EC\uC758
        \uD55C \uCE58\uACFC \uC6D0\uC7A5\uC740 \"\uC608\uC57D\uAE08\uC744 \uBC1B\uAE34
        \uD55C\uB2E4\"\uBA74\uC11C \"\uB2E4\uB9CC \uC608\uC57D\uD560 \uB54C \uD658\uC790\uC5D0\uAC8C
        \uBBF8\uB9AC \uB9D0\uC500\uB4DC\uB9B0\uB2E4. \uBCF8\uC778\uC774 \uC815\uD55C
        \uC801 \uC5C6\uB294 \uC608\uC57D\uAE08\uC774\uB77C\uBA74 \uC800\uD76C \uAC83\uC774
        \uC544\uB2C8\uB2E4\"\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uB2EC\uB825\uC5D0\uB294
        \uC608\uC57D\uC744 22\uC77C\uB85C \uC62E\uACBC\uB2E4\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 0
      headline: "\uC62E\uACA8\uC9C4 \uC608\uC57D\uC5D0 \uB0B8 \uC608\uC57D\uAE08"
      subhead: "\uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD, \uC774\uBBF8 \uC5C6\uB294
        \uC608\uC57D\uC5D0 3\uB9CC \uC6D0 \uC1A1\uAE08"
      body: "\uBAA9\uC694\uC77C, \uB9C8\uD3EC \uC77C\uB300 \uBCD1\uC6D0 \uD658\uC790\uB4E4\uC5D0\uAC8C
        \uC774\uB984\uACFC \uC608\uC57D \uC2DC\uAC04\uC744 \uC544\uB294 '\uC2E4\uC7A5'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uADF8\uB294 \uC800\uB141 \uC9C4\uB8CC\uB294
        \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uC608\uC57D\uAE08 3\uB9CC \uC6D0\uC744
        \uB0B4\uC57C \uD55C\uB2E4\uACE0 \uD588\uB2E4.\n\n22\uC138 \uB300\uD559\uC0DD
        \uD55C \uBA85\uC740 \uB3C8\uC744 \uBCF4\uB0C8\uB2E4. \uADF8\uB294 \uBC14\uB85C
        \uADF8\uB0A0 \uC544\uCE68 \uC608\uC57D\uC744 \uC62E\uAE30\uACE0 \uC0C8 \uB0A0\uC9DC\uB97C
        \uB2EC\uB825\uC5D0 \uC801\uC5B4 \uB454 \uC0C1\uD0DC\uC600\uB2E4. \uC774 \uC815\uBCF4\uB294
        \uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774\uC5D0\uC11C \uC720\uCD9C\uB41C
        \uAC83\uC774\uC5C8\uB2E4. \uBA85\uB2E8\uC740 \uC77C\uC8FC\uC77C \uC804 \uAC83\uC774\uC5B4\uC11C,
        \uADF8\uC0AC\uC774 \uC608\uC57D\uC744 \uC62E\uAE30\uAC70\uB098 \uCDE8\uC18C\uD55C
        \uD658\uC790\uB4E4\uB3C4 \uC774\uBBF8 \uC5C6\uB294 \uC608\uC57D\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC558\uB2E4. \uC608\uC57D\uAE08\uC740 \uB4A4\uC5D0
        \uB204\uAC00 \uC788\uB294\uC9C0 \uB4DC\uB7EC\uB098\uC9C0 \uC54A\uB294 \uACB0\uC81C\uB300\uD589\uC0AC
        \uAC00\uC0C1\uACC4\uC88C\uB85C \uB4E4\uC5B4\uAC14\uB2E4.\n\n\uB9C8\uD3EC\uC758
        \uD55C \uCE58\uACFC \uC6D0\uC7A5\uC740 \"\uC608\uC57D\uAE08\uC744 \uBC1B\uAE34
        \uD55C\uB2E4\"\uBA74\uC11C \"\uB2E4\uB9CC \uC608\uC57D\uD560 \uB54C \uD658\uC790\uC5D0\uAC8C
        \uBBF8\uB9AC \uB9D0\uC500\uB4DC\uB9B0\uB2E4. \uBCF8\uC778\uC774 \uC815\uD55C
        \uC801 \uC5C6\uB294 \uC608\uC57D\uAE08\uC774\uB77C\uBA74 \uC800\uD76C \uAC83\uC774
        \uC544\uB2C8\uB2E4\"\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uB2EC\uB825\uC5D0 \uC801\uD600 \uC788\uC5C8\uB2E4. \uADF8\uB0A0
        \uC544\uCE68 \uCE58\uACFC \uC608\uC57D\uC744 22\uC77C\uB85C \uC62E\uACBC\uB2E4\uACE0."
      print: {fileID: 0}
    - outcome: 3
      headline: "'5\uC2DC\uAE4C\uC9C0 \uC548 \uB0B4\uBA74 \uC608\uC57D \uCDE8\uC18C'"
      subhead: "\uC77C\uC8FC\uC77C \uC804 \uC608\uC57D \uC815\uBCF4\uB85C \uD658\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4."
      body: "\uBAA9\uC694\uC77C, \uB9C8\uD3EC \uC77C\uB300 \uBCD1\uC6D0 \uD658\uC790\uB4E4\uC5D0\uAC8C
        \uC774\uB984\uACFC \uC608\uC57D \uC2DC\uAC04\uC744 \uC544\uB294 '\uC2E4\uC7A5'\uC758
        \uC804\uD654\uAC00 \uAC78\uB824 \uC654\uB2E4. \uADF8\uB294 \uC800\uB141 \uC9C4\uB8CC\uB294
        \uC624\uD6C4 5\uC2DC \uC804\uC5D0 \uC608\uC57D\uAE08 3\uB9CC \uC6D0\uC744
        \uB0B4\uC57C \uD55C\uB2E4\uACE0 \uD588\uB2E4.\n\n\uC774 \uC815\uBCF4\uB294
        \uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774\uC5D0\uC11C \uC720\uCD9C\uB41C
        \uAC83\uC774\uC5C8\uB2E4. \uBA85\uB2E8\uC740 \uC77C\uC8FC\uC77C \uC804 \uAC83\uC774\uC5B4\uC11C,
        \uADF8\uC0AC\uC774 \uC608\uC57D\uC744 \uC62E\uAE30\uAC70\uB098 \uCDE8\uC18C\uD55C
        \uD658\uC790\uB4E4\uB3C4 \uC774\uBBF8 \uC5C6\uB294 \uC608\uC57D\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC558\uB2E4. \uC608\uC57D\uAE08\uC740 \uB4A4\uC5D0
        \uB204\uAC00 \uC788\uB294\uC9C0 \uB4DC\uB7EC\uB098\uC9C0 \uC54A\uB294 \uACB0\uC81C\uB300\uD589\uC0AC
        \uAC00\uC0C1\uACC4\uC88C\uB85C \uB4E4\uC5B4\uAC14\uB2E4.\n\n\uB9C8\uD3EC\uC758
        \uD55C \uCE58\uACFC \uC6D0\uC7A5\uC740 \"\uC608\uC57D\uAE08\uC744 \uBC1B\uAE34
        \uD55C\uB2E4\"\uBA74\uC11C \"\uB2E4\uB9CC \uC608\uC57D\uD560 \uB54C \uD658\uC790\uC5D0\uAC8C
        \uBBF8\uB9AC \uB9D0\uC500\uB4DC\uB9B0\uB2E4. \uBCF8\uC778\uC774 \uC815\uD55C
        \uC801 \uC5C6\uB294 \uC608\uC57D\uAE08\uC774\uB77C\uBA74 \uC800\uD76C \uAC83\uC774
        \uC544\uB2C8\uB2E4\"\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uACB0\uC815\uB3C4
        \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4. \uB2EC\uB825\uB9CC \uD55C \uBC88 \uBD24\uC5B4\uB3C4
        \uC54C \uC218 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
    ruleTitle: "\uB0B4\uAC00 \uC815\uD55C \uAC74 \uBB34\uC5C7\uC774\uC5C8\uB098"
    rule: "\uB0B4 \uC608\uC57D\uC744 \uC544\uB294 \uC804\uD654\uB77C\uACE0 \uD574\uC11C
      \uBBFF\uC744 \uC218\uB294 \uC5C6\uB2E4. \uB0B4\uAC00 \uBB34\uC5C7\uC744 \uC815\uD588\uB294\uC9C0\uB294
      \uB0B4 \uBA54\uBAA8\uAC00 \uC54C\uB824 \uC900\uB2E4. \uC804\uD654 \uB0B4\uC6A9\uACFC
      \uB2E4\uB974\uBA74 \uB0B4\uC9C0 \uB9C8\uB77C."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 9\uC77C"
  - id: dentist_legit
    scenario: dentist
    intro: "\uC911\uAC04\uACE0\uC0AC\uB294 \uB2E4\uC74C \uC8FC. \uB2E8\uC218\uB294
      \uC815\uC624\uC5D0 \uB05D\uB0AC\uACE0, \uB2EC\uB825\uC5D0\uB294 \uC77C\uC8FC\uC77C
      \uB0B4\uB0B4 \uCE58\uACFC \uC608\uC57D\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    conversation: {fileID: 11400000, guid: 164dd2515a2b74a7f9f92015f2dcd9c1, type: 2}
    phone: {fileID: 11400000, guid: 6ba2934883afa47f2a3d00d399874761, type: 2}
    room: {fileID: 11400000, guid: 7b8494c71621e455ba7c16b9b7a6b9fb, type: 2}
    directory: {fileID: 11400000, guid: 8f598edddc61f4ceeb5b9ef6571023fa, type: 2}
    clues:
    - id: calendar
      text: "\uC624\uB298 \uB0A0\uC9DC\uC5D0 \uB0B4\uAC00 \uC9C1\uC811 \uC801\uC5B4
        \uB450\uC5C8\uB2E4. \uCE58\uACFC 18:30, \uADF8\uB9AC\uACE0 \uC624\uD6C4\uC5D0
        \uC608\uC57D\uAE08 3\uB9CC \uC6D0 \uC804\uD654\uAC00 \uC628\uB2E4\uACE0."
      where: "\uBCBD\uC5D0 \uAC78\uB9B0 \uB2EC\uB825"
      guide: 
      when:
      - kind: 0
        target: Calendar
    papers:
    - outcome: 0
      headline: "\uB3D9\uB124 \uCE58\uACFC\uAE4C\uC9C0 \uC628 \uB178\uC1FC \uC608\uC57D\uAE08"
      subhead: "\uC800\uB141 \uC9C4\uB8CC \uC608\uC57D\uAE08\uC744 \uC804\uD654\uB85C
        \uBC1B\uB294 \uBCD1\uC6D0\uB4E4, \uC608\uC57D\uD560 \uB54C \uBBF8\uB9AC \uC54C\uB9B0\uB2E4"
      body: "\uB9C8\uD3EC \uC9C0\uC5ED \uCE58\uACFC\uB4E4\uC5D0 \uB530\uB974\uBA74
        \uC9C0\uB09C\uD574 \uC800\uB141 \uC608\uC57D \uD658\uC790 \uB2E4\uC12F \uBA85
        \uC911 \uD55C \uBA85\uC740 \uB098\uD0C0\uB098\uC9C0 \uC54A\uC558\uB2E4. 9\uC6D4\uBD80\uD130\uB294
        \uB2F9\uC77C\uC5D0 \uC804\uD654\uB85C \uC608\uC57D\uAE08\uC744 \uBC1B\uB294
        \uB3D9\uB124 \uBCD1\uC6D0\uC774 \uB9CE\uC544\uC84C\uB2E4. \uBCF4\uD1B5 3\uB9CC
        \uC6D0\uC774\uACE0, \uC9C4\uB8CC\uBE44\uC5D0\uC11C \uBE80\uB2E4.\n\n\uB9DD\uC6D0\uB3D9
        \uC0C8\uBD04\uCE58\uACFC \uBB38\uC9C0\uD61C \uC2E4\uC7A5\uC740 \"\uC608\uC57D\uD558\uC2E4
        \uB54C \uC804\uD654\uB4DC\uB9B0\uB2E4\uACE0 \uBAA8\uB4E0 \uD658\uC790\uBD84\uAED8
        \uB9D0\uC500\uB4DC\uB9B0\uB2E4\"\uBA70 \"\uC801\uC5B4 \uB450\uC2E0 \uBD84\uC740
        1\uBD84\uC774\uBA74 \uB0B4\uC2DC\uACE0, \uC548 \uC801\uC5B4 \uB450\uC2E0
        \uBD84\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C \uC544\uC2E0\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774
        \uC720\uCD9C \uC774\uD6C4, \uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uB0B4 \uC608\uC57D\uC744 \uC548\uB2E4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
        \uC544\uBB34\uAC83\uB3C4 \uC99D\uBA85\uB418\uC9C0 \uC54A\uB294\uB2E4\uACE0
        \uB9D0\uD55C\uB2E4. \uC911\uC694\uD55C \uAC74 \uB0B4\uAC00 \uC9C1\uC811 \uC815\uD55C
        \uB0B4\uC6A9\uC774\uB2E4."
      verdictNote: "\uB2E4\uB2C8\uB294 \uCE58\uACFC\uAC00 \uB9DE\uC558\uACE0, \uB2F9\uC2E0\uC740
        \uD655\uC778\uD588\uB2E4. \uB0B4 \uBA54\uBAA8\uC5D0 \uC2DC\uAC04\uACFC \uAE08\uC561,
        \uC804\uD654\uAC00 \uC628\uB2E4\uB294 \uAC83\uAE4C\uC9C0 \uC801\uD600 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 1
      headline: "\uC0AC\uAE30 \uAC71\uC815\uC5D0 \uB04A\uAE30\uB294 \uBCD1\uC6D0
        \uC804\uD654"
      subhead: "\uC9C4\uC9DC \uC608\uC57D\uAE08 \uC804\uD654\uB3C4 \uAC00\uC9DC\uCC98\uB7FC
        \uB4E4\uB9B0\uB2E4."
      body: "\uB9C8\uD3EC \uC9C0\uC5ED \uCE58\uACFC\uB4E4\uC5D0 \uB530\uB974\uBA74
        \uC9C0\uB09C\uD574 \uC800\uB141 \uC608\uC57D \uD658\uC790 \uB2E4\uC12F \uBA85
        \uC911 \uD55C \uBA85\uC740 \uB098\uD0C0\uB098\uC9C0 \uC54A\uC558\uB2E4. 9\uC6D4\uBD80\uD130\uB294
        \uB2F9\uC77C\uC5D0 \uC804\uD654\uB85C \uC608\uC57D\uAE08\uC744 \uBC1B\uB294
        \uB3D9\uB124 \uBCD1\uC6D0\uC774 \uB9CE\uC544\uC84C\uB2E4. \uBCF4\uD1B5 3\uB9CC
        \uC6D0\uC774\uACE0, \uC9C4\uB8CC\uBE44\uC5D0\uC11C \uBE80\uB2E4.\n\n\uB9DD\uC6D0\uB3D9
        \uC0C8\uBD04\uCE58\uACFC \uBB38\uC9C0\uD61C \uC2E4\uC7A5\uC740 \"\uC608\uC57D\uD558\uC2E4
        \uB54C \uC804\uD654\uB4DC\uB9B0\uB2E4\uACE0 \uBAA8\uB4E0 \uD658\uC790\uBD84\uAED8
        \uB9D0\uC500\uB4DC\uB9B0\uB2E4\"\uBA70 \"\uC801\uC5B4 \uB450\uC2E0 \uBD84\uC740
        1\uBD84\uC774\uBA74 \uB0B4\uC2DC\uACE0, \uC548 \uC801\uC5B4 \uB450\uC2E0
        \uBD84\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C \uC544\uC2E0\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4. \uBAA9\uC694\uC77C\uC5D0\uB294 \uC800\uB141 \uC608\uC57D
        \uD658\uC790 \uC138 \uBA85\uC774 \uC804\uD654\uB97C \uB04A\uC5B4 \uC608\uC57D\uC774
        \uCDE8\uC18C\uB410\uB2E4.\n\n\uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774
        \uC720\uCD9C \uC774\uD6C4, \uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uB0B4 \uC608\uC57D\uC744 \uC548\uB2E4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
        \uC544\uBB34\uAC83\uB3C4 \uC99D\uBA85\uB418\uC9C0 \uC54A\uB294\uB2E4\uACE0
        \uB9D0\uD55C\uB2E4. \uC911\uC694\uD55C \uAC74 \uB0B4\uAC00 \uC9C1\uC811 \uC815\uD55C
        \uB0B4\uC6A9\uC774\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uB2EC\uB825 \uBA54\uBAA8\uC5D0
        \uCE58\uACFC\uC5D0\uC11C \uC608\uC57D\uAE08 3\uB9CC \uC6D0 \uC804\uD654\uAC00
        \uC628\uB2E4\uACE0 \uC801\uD600 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 3
      headline: "\uC800\uB141 \uC608\uC57D\uC740 5\uC2DC\uC5D0 \uC815\uB9AC\uB410\uB2E4"
      subhead: "\uACB0\uC815\uC744 \uBBF8\uB8EC \uD658\uC790\uB4E4\uC758 \uC608\uC57D\uC740
        3\uC8FC \uB4A4\uB85C \uBC00\uB838\uB2E4."
      body: "\uB9C8\uD3EC \uC9C0\uC5ED \uCE58\uACFC\uB4E4\uC5D0 \uB530\uB974\uBA74
        \uC9C0\uB09C\uD574 \uC800\uB141 \uC608\uC57D \uD658\uC790 \uB2E4\uC12F \uBA85
        \uC911 \uD55C \uBA85\uC740 \uB098\uD0C0\uB098\uC9C0 \uC54A\uC558\uB2E4. 9\uC6D4\uBD80\uD130\uB294
        \uB2F9\uC77C\uC5D0 \uC804\uD654\uB85C \uC608\uC57D\uAE08\uC744 \uBC1B\uB294
        \uB3D9\uB124 \uBCD1\uC6D0\uC774 \uB9CE\uC544\uC84C\uB2E4. \uBCF4\uD1B5 3\uB9CC
        \uC6D0\uC774\uACE0, \uC9C4\uB8CC\uBE44\uC5D0\uC11C \uBE80\uB2E4.\n\n\uB9DD\uC6D0\uB3D9
        \uC0C8\uBD04\uCE58\uACFC \uBB38\uC9C0\uD61C \uC2E4\uC7A5\uC740 \"\uC608\uC57D\uD558\uC2E4
        \uB54C \uC804\uD654\uB4DC\uB9B0\uB2E4\uACE0 \uBAA8\uB4E0 \uD658\uC790\uBD84\uAED8
        \uB9D0\uC500\uB4DC\uB9B0\uB2E4\"\uBA70 \"\uC801\uC5B4 \uB450\uC2E0 \uBD84\uC740
        1\uBD84\uC774\uBA74 \uB0B4\uC2DC\uACE0, \uC548 \uC801\uC5B4 \uB450\uC2E0
        \uBD84\uC740 \uC800\uB97C \uC0AC\uAE30\uAFBC\uC73C\uB85C \uC544\uC2E0\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uC9C0\uB09C\uC8FC \uC608\uC57D \uC571 \uB2E5\uB370\uC774
        \uC720\uCD9C \uC774\uD6C4, \uB9C8\uD3EC\uC18C\uBE44\uC790\uC13C\uD130\uB294
        \uB0B4 \uC608\uC57D\uC744 \uC548\uB2E4\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294
        \uC544\uBB34\uAC83\uB3C4 \uC99D\uBA85\uB418\uC9C0 \uC54A\uB294\uB2E4\uACE0
        \uB9D0\uD55C\uB2E4. \uC911\uC694\uD55C \uAC74 \uB0B4\uAC00 \uC9C1\uC811 \uC815\uD55C
        \uB0B4\uC6A9\uC774\uB2E4."
      verdictNote: "\uB2E4\uB2C8\uB294 \uCE58\uACFC\uAC00 \uB9DE\uC558\uACE0, \uBA54\uBAA8\uB294
        \uB2EC\uB825\uC5D0 \uC788\uC5C8\uB2E4. \uC81C\uB54C \uACB0\uC815\uD558\uB294
        \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 0}
    ruleTitle: "\uB0B4 \uBA54\uBAA8\uB3C4 \uC99D\uAC70\uB2E4"
    rule: "\uB0B4 \uBA54\uBAA8\uAC00 \uC804\uD654 \uB0B4\uC6A9\uACFC \uAC19\uB2E4\uBA74(\uC2DC\uAC04,
