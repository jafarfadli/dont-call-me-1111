  ringDelay: 6
  help: 3
  level: 3
  newToday: "\uC8FC\uC7A5\uC744 \uC9C1\uC811 \uC801\uC5B4\uC57C \uD55C\uB2E4. \uB300\uD654
    \uAE30\uB85D\uC5D0\uC11C \uC0C1\uB300\uAC00 \uD55C \uB9D0\uC744 \uD074\uB9AD\uD558\uBA74
