  dateLabel: "10\uC6D4 8\uC77C \uBAA9\uC694\uC77C"
  weekday: "\uBAA9\uC694\uC77C"
  shortLabel: "3\uC77C\uCC28 \xB7 10\uC6D4 8\uC77C (\uBAA9)"
  place: "\uC11C\uC6B8 \uB9C8\uD3EC\uAD6C \uB9DD\uC6D0\uB3D9"
  startTime: 16:25
  intro: "\uC911\uAC04\uACE0\uC0AC\uB294 \uB2E4\uC74C \uC8FC. \uB2E8\uC218\uB294
    \uC815\uC624\uC5D0 \uB05D\uB0AC\uACE0, \uC8FC\uBB38\uD55C \uBAA8\uB2C8\uD130\uB294
    \uACE7 \uB3C4\uCC29\uD560 \uAC83\uC774\uB2E4."
  ringDelay: 6
  variants:
  - id: scam
    scenario: parcel
    intro: 
    conversation: {fileID: 11400000, guid: b5b9324a78d1f42beaedfbd49c289e51, type: 2}
    phone: {fileID: 11400000, guid: 6db6c9b29f5864f9d997be305a6ad6e0, type: 2}
    room: {fileID: 11400000, guid: d3d8909235ee84e81b92381035145bac, type: 2}
    directory: {fileID: 11400000, guid: 89f568e629d394512a6d78ce2250d3ad, type: 2}
    clues:
    - id: courier_notice
      text: "\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uAC00 \uC9C1\uC811 \uBCF4\uB0B8
        \uC54C\uB9BC\uC5D0\uB294 \uBAA8\uB2C8\uD130\uAC00 \uD1B5\uAD00\uC744 \uB9C8\uCCE4\uACE0
        \uAE08\uC694\uC77C\uC5D0 \uB3C4\uCC29\uD558\uBA70, \uB0BC \uB3C8\uC740 \uC5C6\uB2E4\uACE0
        \uC801\uD600 \uC788\uB2E4."
      where: "\uCC44\uD305 \u2192 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4, \uB610\uB294
        \uBCBD\uC5D0 \uAC78\uB9B0 \uB2EC\uB825"
      guide: 
      when:
      - kind: 4
        target: hangang
      - kind: 0
        target: Calendar
    - id: taxes
      text: "\uC54C\uB9AC\uC2A4\uD0C0 \uBA54\uC2DC\uC9C0\uC5D0\uB294 \uC218\uC785
        \uC138\uAE08\uC774 \uACB0\uC81C \uB54C \uD3EC\uD568\uB410\uB2E4\uACE0 \uC801\uD600
        \uC788\uB2E4."
      where: "\uCC44\uD305 \u2192 \uC54C\uB9AC\uC2A4\uD0C0"
      guide: 
      when:
      - kind: 4
        target: alistar
    - id: number
      text: "\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 \uBC88\uD638\uB294 1588-5520\uC774\uB2E4.
        \uBC1C\uC2E0 \uBC88\uD638 1588-5502\uB294 \uD55C \uC790\uB9AC\uAC00 \uB2E4\uB974\uACE0,
        '\uCF00\uC774\uC54C\uD1B5\uAD00\uC11C\uBE44\uC2A4' \uBA85\uC758\uB2E4."
      where: "\uCC45\uC0C1 \uC11C\uB78D \u2192 \uD0DD\uBC30 \uC1A1\uC7A5, \uB610\uB294
        \uCEF4\uD4E8\uD130 \u2192 \uC804\uD654\uBC88\uD638 \uC870\uD68C"
      guide: 
      when:
      - kind: 1
        target: "\uD0DD\uBC30 \uC1A1\uC7A5"
      - kind: 2
        target: 1588-5502
    - id: account_owner
      text: "\uACC4\uC88C \uC8FC\uC778\uC740 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uAC00
        \uC544\uB2C8\uB77C '(\uC8FC)\uCF00\uC774\uC54C\uD1B5\uAD00'\uC774\uB2E4."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uACC4\uC88C \uC870\uD68C"
      guide: 
      when:
      - kind: 2
        target: 620-557-301144
      - kind: 3
        target: 620-557-301144
    papers:
    - outcome: 1
      headline: "\uAC00\uC9DC \uD1B5\uAD00\uD300, \uC720\uCD9C\uB41C \uC54C\uB9AC\uC2A4\uD0C0
        \uC8FC\uBB38 \uC815\uBCF4 \uC545\uC6A9"
      subhead: "\uC0C1\uB300\uB294 \uC0C1\uD488\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uAE4C\uC9C0
        \uC54C\uACE0 \uC788\uC5C8\uB2E4. \uD0DD\uBC30\uB294 \uC774\uBBF8 \uD1B5\uAD00\uC744
        \uB9C8\uCE5C \uC0C1\uD0DC\uC600\uB2E4."
      body: "\uC5B4\uC81C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 '\uD1B5\uAD00\uD300'\uC744
        \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00 \uB9C8\uD3EC\uC758 \uC54C\uB9AC\uC2A4\uD0C0
        \uACE0\uAC1D\uB4E4\uC5D0\uAC8C \uAC78\uB824 \uC654\uB2E4. \uC774\uB4E4\uC740
        \uACE0\uAC1D\uC758 \uC8FC\uBB38 \uB0B4\uC5ED\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uB97C
        \uC74A\uC73C\uBA70 '\uBBF8\uB0A9 \uAD00\uC138'\uB97C \uC624\uD6C4 5\uC2DC
        \uC804\uAE4C\uC9C0 \uACC4\uC88C\uB85C \uB0B4\uB77C\uACE0 \uC694\uAD6C\uD588\uB2E4.\n\n\uC774
        \uC815\uBCF4\uB294 \uC9C0\uB09C\uB2EC \uC54C\uB9AC\uC2A4\uD0C0 \uAC1C\uC778\uC815\uBCF4
        \uC720\uCD9C\uC5D0\uC11C \uB098\uC628 \uAC83\uC774\uC5C8\uB2E4. \uD0DD\uBC30\uB294
        \uC774\uBBF8 \uC138\uAE08\uC774 \uB0A9\uBD80\uB41C \uCC44 \uD1B5\uAD00\uC744
        \uB9C8\uCCE4\uACE0, \uC804\uD654\uB294 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uC758
        \uC9C4\uC9DC \uBC88\uD638 1588-5520\uACFC \uD55C \uC790\uB9AC \uB2E4\uB978
        1588-5502\uC5D0\uC11C \uAC78\uB824 \uC654\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uAD00\uACC4\uC790\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74 \uC800\uD76C\uAC00
        \uBCF4\uB0B4\uB294 \uC54C\uB9BC\uC5D0 \uC800\uD76C \uBA85\uC758 \uACC4\uC88C\uC640
        \uD568\uAED8 \uC548\uB0B4\uB41C\uB2E4\"\uBA70 \"\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C
        \uB3C8\uC744 \uB0B4\uB77C\uACE0 \uD558\uB294 \uC77C\uC740 \uC808\uB300 \uC5C6\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uD0DD\uBC30\uB294 \uD1B5\uAD00\uC744
        \uB9C8\uCCE4\uACE0, \uC138\uAE08\uC740 \uD3EC\uD568\uB418\uC5B4 \uC788\uC5C8\uC73C\uBA70,
        \uBC88\uD638\uB294 \uD55C \uC790\uB9AC\uAC00 \uB2EC\uB790\uB2E4."
      print: {fileID: 0}
    - outcome: 0
      headline: "\uC774\uBBF8 \uC138\uAE08 \uB0B8 \uD0DD\uBC30\uC5D0 '\uAD00\uC138'
        5\uB9CC 6,600\uC6D0"
      subhead: "\uC720\uCD9C\uB41C \uC54C\uB9AC\uC2A4\uD0C0 \uC8FC\uBB38 \uC815\uBCF4\uB97C
        \uC190\uC5D0 \uB123\uC740 \uC0AC\uAE30\uBC94\uB4E4\uC774 \uD0DD\uBC30\uC0AC
        \uD1B5\uAD00\uD300\uC744 \uC0AC\uCE6D\uD588\uB2E4."
      body: "\uC5B4\uC81C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 '\uD1B5\uAD00\uD300'\uC744
        \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00 \uB9C8\uD3EC\uC758 \uC54C\uB9AC\uC2A4\uD0C0
        \uACE0\uAC1D\uB4E4\uC5D0\uAC8C \uAC78\uB824 \uC654\uB2E4. \uC774\uB4E4\uC740
        \uACE0\uAC1D\uC758 \uC8FC\uBB38 \uB0B4\uC5ED\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uB97C
        \uC74A\uC73C\uBA70 '\uBBF8\uB0A9 \uAD00\uC138'\uB97C \uC624\uD6C4 5\uC2DC
        \uC804\uAE4C\uC9C0 \uACC4\uC88C\uB85C \uB0B4\uB77C\uACE0 \uC694\uAD6C\uD588\uB2E4.\n\n\uB9DD\uC6D0\uB3D9\uC758
        \uD55C \uB300\uD559\uC0DD\uC740 \uC77C\uC8FC\uC77C \uC804 \uAC1C\uC124\uB41C
        '\uCF00\uC774\uC54C\uD1B5\uAD00' \uBA85\uC758 \uACC4\uC88C\uB85C 5\uB9CC
        6,600\uC6D0\uC744 \uBCF4\uB0C8\uB2E4. \uADF8\uC758 \uBAA8\uB2C8\uD130\uB294
        \uD310\uB9E4\uC790\uAC00 \uACB0\uC81C \uB54C \uC138\uAE08\uC744 \uB0B8 \uC0C1\uD0DC\uB85C
        \uC218\uC694\uC77C\uC5D0 \uC774\uBBF8 \uD1B5\uAD00\uC744 \uB9C8\uCCE4\uACE0,
        \uC624\uB298 \uC544\uCE68 \uB3C4\uCC29\uD588\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uAD00\uACC4\uC790\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74 \uC800\uD76C\uAC00
        \uBCF4\uB0B4\uB294 \uC54C\uB9BC\uC5D0 \uC800\uD76C \uBA85\uC758 \uACC4\uC88C\uC640
        \uD568\uAED8 \uC548\uB0B4\uB41C\uB2E4\"\uBA70 \"\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C
        \uB3C8\uC744 \uB0B4\uB77C\uACE0 \uD558\uB294 \uC77C\uC740 \uC808\uB300 \uC5C6\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uD0DD\uBC30\uC0AC \uC54C\uB9BC\uACFC \uC54C\uB9AC\uC2A4\uD0C0
        \uBA54\uC2DC\uC9C0 \uBAA8\uB450 \uC138\uAE08\uC774 \uB0A9\uBD80\uB410\uB2E4\uACE0
        \uD588\uACE0, \uACC4\uC88C\uB3C4 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uBA85\uC758\uAC00 \uC544\uB2C8\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 3
      headline: "\uD1B5\uAD00\uD300 \uC804\uD654? \uD0DD\uBC30\uC0AC \uC54C\uB9BC\uBD80\uD130
        \uD655\uC778\uD558\uB77C"
      subhead: "\uC720\uCD9C\uB41C \uC8FC\uBB38 \uC815\uBCF4\uB85C \uC0AC\uAE30\uBC94\uB4E4\uC774
        \uC5B4\uC81C \uC54C\uB9AC\uC2A4\uD0C0 \uACE0\uAC1D\uB4E4\uC5D0\uAC8C \uC804\uD654\uB97C
        \uAC78\uC5C8\uB2E4."
      body: "\uC5B4\uC81C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 '\uD1B5\uAD00\uD300'\uC744
        \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00 \uB9C8\uD3EC\uC758 \uC54C\uB9AC\uC2A4\uD0C0
        \uACE0\uAC1D\uB4E4\uC5D0\uAC8C \uAC78\uB824 \uC654\uB2E4. \uC774\uB4E4\uC740
        \uACE0\uAC1D\uC758 \uC8FC\uBB38 \uB0B4\uC5ED\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uB97C
        \uC74A\uC73C\uBA70 '\uBBF8\uB0A9 \uAD00\uC138'\uB97C \uC624\uD6C4 5\uC2DC
        \uC804\uAE4C\uC9C0 \uACC4\uC88C\uB85C \uB0B4\uB77C\uACE0 \uC694\uAD6C\uD588\uB2E4.\n\n\uC774
        \uC815\uBCF4\uB294 \uC9C0\uB09C\uB2EC \uC54C\uB9AC\uC2A4\uD0C0 \uAC1C\uC778\uC815\uBCF4
        \uC720\uCD9C\uC5D0\uC11C \uB098\uC628 \uAC83\uC774\uC5C8\uB2E4. \uD0DD\uBC30\uB294
        \uC774\uBBF8 \uC138\uAE08\uC774 \uB0A9\uBD80\uB41C \uCC44 \uD1B5\uAD00\uC744
        \uB9C8\uCCE4\uACE0, \uC804\uD654\uB294 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uC758
        \uC9C4\uC9DC \uBC88\uD638 1588-5520\uACFC \uD55C \uC790\uB9AC \uB2E4\uB978
        1588-5502\uC5D0\uC11C \uAC78\uB824 \uC654\uB2E4.\n\n\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4
        \uAD00\uACC4\uC790\uB294 \"\uAD00\uC138\uAC00 \uC788\uC73C\uBA74 \uC800\uD76C\uAC00
        \uBCF4\uB0B4\uB294 \uC54C\uB9BC\uC5D0 \uC800\uD76C \uBA85\uC758 \uACC4\uC88C\uC640
        \uD568\uAED8 \uC548\uB0B4\uB41C\uB2E4\"\uBA70 \"\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C
        \uB3C8\uC744 \uB0B4\uB77C\uACE0 \uD558\uB294 \uC77C\uC740 \uC808\uB300 \uC5C6\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uB2E4. \uD0DD\uBC30\uC0AC
        \uC54C\uB9BC\uB9CC \uBD24\uC5B4\uB3C4 \uBAA8\uB2C8\uD130\uAC00 \uC774\uBBF8
        \uD1B5\uAD00\uB41C \uAC78 \uC54C \uC218 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
    ruleTitle: "\uB0BC \uB3C8\uC774 \uC788\uB098? \uD0DD\uBC30\uC0AC \uC54C\uB9BC\uC744
      \uBCF4\uB77C"
    rule: "\uD0DD\uBC30\uC0AC\uB098 \uC138\uAD00\uC774 \uB3C8\uC744 \uC694\uAD6C\uD558\uBA74
      \uD0DD\uBC30\uC0AC\uAC00 \uC9C1\uC811 \uBCF4\uB0B8 \uC54C\uB9BC\uC744 \uC77D\uACE0,
      \uBC88\uD638\uC640 \uACC4\uC88C\uC758 \uC8FC\uC778\uC744 \uC870\uD68C\uD558\uB77C.
      \uD0DD\uBC30\uC0AC\uAC00 \uB0BC \uB3C8\uC774 \uC5C6\uB2E4\uACE0 \uD558\uBA74,
      \uB0BC \uB3C8\uC740 \uC5C6\uB294 \uAC83\uC774\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 9\uC77C"
