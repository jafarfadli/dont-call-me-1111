    papers:
    - outcome: 0
      headline: "\uC544\uBC84\uC9C0 \uB300\uC2E0 \uAC74\uBB3C\uC744 \uC9C0\uD0A4\uB294
        \uC544\uB4E4"
      subhead: "\uB9DD\uC6D0\uD558\uC774\uCE20 \uC9D1\uC8FC\uC778\uC774 \uC218\uC220
        \uD6C4 \uD68C\uBCF5\uD558\uB294 \uB3D9\uC548, \uC544\uB4E4\uC774 \uCC44\uD305\uBC29
        \uACF5\uC9C0\uB97C \uAC70\uCCD0 \uC6D4\uC138\uB97C \uAC77\uACE0 \uC788\uB2E4."
      body: "\uD3EC\uC740\uB85C \uB9DD\uC6D0\uD558\uC774\uCE20\uC758 \uAC74\uBB3C\uC8FC
        \uCD5C\uC601\uC2DD(71) \uC528\uAC00 \uC5B4\uC81C \uC138\uBE0C\uB780\uC2A4\uBCD1\uC6D0\uC5D0\uC11C
        \uBB34\uB98E \uC218\uC220\uC744 \uBC1B\uC558\uB2E4. \uADF8\uAC00 \uD68C\uBCF5\uD558\uB294
        \uB3D9\uC548 \uC544\uB4E4 \uCD5C\uD604\uC6B0 \uC528\uAC00 \uC6D4\uC138\uB97C
        \uAC77\uACE0 \uC788\uB294\uB370, \uC774\uAC8C \uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uC9C0
        \uC54A\uC558\uB2E4.\n\n\uD604\uC6B0 \uC528\uB294 \"\uC544\uBC84\uC9C0\uAC00
        \uC785\uC6D0\uD558\uC2DC\uAE30 \uC804\uC5D0 \uC785\uC8FC\uBBFC \uCC44\uD305\uBC29\uC5D0
        \uC0C8 \uACC4\uC88C\uB97C \uC62C\uB9AC\uC168\uB2E4\"\uBA70 \"\uBAA8\uB4E0
        \uAC78 \uD655\uC778\uD558\uACE0 \uBCF4\uB0B4 \uC900 \uC138\uC785\uC790\uB3C4
        \uC788\uC5C8\uB294\uB370, \uADF8\uAC8C \uC624\uD788\uB824 \uBC18\uAC00\uC6E0\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uC11C\uC6B8\uC8FC\uAC70\uD3EC\uD138\uC740 \uC138\uC785\uC790\uAC00
        \uC0C8 \uC6D4\uC138 \uACC4\uC88C\uB97C \uACC4\uC57D\uC11C, \uC9D1\uC8FC\uC778\uC774
        \uC9C1\uC811 \uC4F4 \uAE00, \uC608\uAE08\uC8FC \uC774\uB984\uACFC \uB300\uC870\uD558\uB294
        \uAC83\uC774 \uC633\uB2E4\uACE0 \uB9D0\uD55C\uB2E4. \uAD00\uACC4\uC790\uB294
        \"\uD655\uC778\uC740 \uC591\uCABD \uBAA8\uB450\uB97C \uC704\uD55C \uAC83\"\uC774\uB77C\uBA70
        \"\uBAA8\uB450 \uC77C\uCE58\uD558\uBA74 \uBCC0\uACBD\uC740 \uC9C4\uC9DC\"\uB77C\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uBCC0\uACBD\uC740 \uC9C4\uC9DC\uC600\uACE0, \uB2F9\uC2E0\uC740
        \uD655\uC778\uD588\uB2E4. \uACC4\uC57D\uC11C\uC758 \uBC88\uD638, \uC608\uAE08\uC8FC
        \uC774\uB984, \uC9D1\uC8FC\uC778\uC774 \uC9C1\uC811 \uC4F4 \uAE00\uC774 \uBAA8\uB450
        \uC77C\uCE58\uD588\uB2E4."
      print: {fileID: 2800000, guid: 39ed75581c59849d1adf1dd079c3f300, type: 3}
    - outcome: 1
      headline: "\uC9C4\uC9DC \uC804\uD654\uAC00 \uC0AC\uAE30\uCC98\uB7FC \uB4E4\uB9B4
        \uB54C"
      subhead: "\uC9D1\uC8FC\uC778 \uC544\uB4E4 \"\uC6D4\uC138 \uB0A0 \uC138\uC785\uC790
        \uC808\uBC18\uC774 \uC804\uD654\uB97C \uB04A\uC5C8\uB2E4\""
      body: "\uD3EC\uC740\uB85C \uB9DD\uC6D0\uD558\uC774\uCE20\uC758 \uAC74\uBB3C\uC8FC
        \uCD5C\uC601\uC2DD(71) \uC528\uAC00 \uC5B4\uC81C \uC138\uBE0C\uB780\uC2A4\uBCD1\uC6D0\uC5D0\uC11C
        \uBB34\uB98E \uC218\uC220\uC744 \uBC1B\uC558\uB2E4. \uADF8\uAC00 \uD68C\uBCF5\uD558\uB294
        \uB3D9\uC548 \uC544\uB4E4 \uCD5C\uD604\uC6B0 \uC528\uAC00 \uC6D4\uC138\uB97C
        \uAC77\uACE0 \uC788\uB294\uB370, \uC774\uAC8C \uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uC9C0
        \uC54A\uC558\uB2E4.\n\n\uD604\uC6B0 \uC528\uB294 \"\uC0AC\uAE30 \uC804\uD654\uAC00
        \uD558\uB3C4 \uB9CE\uC73C\uB2C8 \uC774\uD574\uD55C\uB2E4\"\uBA74\uC11C\uB3C4
        \"\uC544\uBC84\uC9C0\uAC00 \uADF8\uB0A0 \uC544\uCE68 \uCC44\uD305\uBC29\uC5D0
        \uC0C8 \uACC4\uC88C\uB97C \uC62C\uB9AC\uC168\uACE0, \uC81C \uBC88\uD638\uB294
        \uBAA8\uB4E0 \uACC4\uC57D\uC11C\uC5D0 \uC788\uB2E4. \uB2E4 \uAC70\uAE30 \uC788\uC5C8\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uC11C\uC6B8\uC8FC\uAC70\uD3EC\uD138\uC740 \uC138\uC785\uC790\uAC00
        \uC0C8 \uC6D4\uC138 \uACC4\uC88C\uB97C \uACC4\uC57D\uC11C, \uC9D1\uC8FC\uC778\uC774
        \uC9C1\uC811 \uC4F4 \uAE00, \uC608\uAE08\uC8FC \uC774\uB984\uACFC \uB300\uC870\uD558\uB294
        \uAC83\uC774 \uC633\uB2E4\uACE0 \uB9D0\uD55C\uB2E4. \uAD00\uACC4\uC790\uB294
        \"\uD655\uC778\uC740 \uC591\uCABD \uBAA8\uB450\uB97C \uC704\uD55C \uAC83\"\uC774\uB77C\uBA70
        \"\uBAA8\uB450 \uC77C\uCE58\uD558\uBA74 \uBCC0\uACBD\uC740 \uC9C4\uC9DC\"\uB77C\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uACC4\uC57D\uC11C\uC758
        \uBC88\uD638, \uC9D1\uC8FC\uC778\uC774 \uC9C1\uC811 \uC4F4 \uAE00, \uC608\uAE08\uC8FC
        \uC774\uB984\uC774 \uBAA8\uB450 \uC77C\uCE58\uD588\uB2E4."
      print: {fileID: 2800000, guid: 185dd238c92ad4e18a20507783da05a0, type: 3}
    - outcome: 3
      headline: "\uC6D4\uC138 \uB0A0, \uC785\uC6D0\uD55C \uB0A0"
      subhead: "\uC9D1\uC8FC\uC778 \uC544\uB4E4\uC740 \uB05D\uB0B4 \uACB0\uC815\uD558\uC9C0
        \uBABB\uD55C \uC138\uC785\uC790\uB97C \uC804\uD654\uB85C \uAE30\uB2E4\uB838\uB2E4."
      body: "\uD3EC\uC740\uB85C \uB9DD\uC6D0\uD558\uC774\uCE20\uC758 \uAC74\uBB3C\uC8FC
        \uCD5C\uC601\uC2DD(71) \uC528\uAC00 \uC5B4\uC81C \uC138\uBE0C\uB780\uC2A4\uBCD1\uC6D0\uC5D0\uC11C
        \uBB34\uB98E \uC218\uC220\uC744 \uBC1B\uC558\uB2E4. \uADF8\uAC00 \uD68C\uBCF5\uD558\uB294
        \uB3D9\uC548 \uC544\uB4E4 \uCD5C\uD604\uC6B0 \uC528\uAC00 \uC6D4\uC138\uB97C
        \uAC77\uACE0 \uC788\uB294\uB370, \uC774\uAC8C \uC0DD\uAC01\uBCF4\uB2E4 \uC27D\uC9C0
        \uC54A\uC558\uB2E4.\n\n\uD604\uC6B0 \uC528\uB294 \"\uD55C\uCC38\uC744 \uC804\uD654\uB85C
        \uAE30\uB2E4\uB838\uB2E4\"\uBA70 \"\uCC44\uD305\uBC29 \uAE00\uACFC \uACC4\uC57D\uC11C\uC5D0
        \uD544\uC694\uD55C \uAC74 \uB2E4 \uC788\uC5C8\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uC11C\uC6B8\uC8FC\uAC70\uD3EC\uD138\uC740
        \uC138\uC785\uC790\uAC00 \uC0C8 \uC6D4\uC138 \uACC4\uC88C\uB97C \uACC4\uC57D\uC11C,
        \uC9D1\uC8FC\uC778\uC774 \uC9C1\uC811 \uC4F4 \uAE00, \uC608\uAE08\uC8FC \uC774\uB984\uACFC
        \uB300\uC870\uD558\uB294 \uAC83\uC774 \uC633\uB2E4\uACE0 \uB9D0\uD55C\uB2E4.
        \uAD00\uACC4\uC790\uB294 \"\uD655\uC778\uC740 \uC591\uCABD \uBAA8\uB450\uB97C
        \uC704\uD55C \uAC83\"\uC774\uB77C\uBA70 \"\uBAA8\uB450 \uC77C\uCE58\uD558\uBA74
        \uBCC0\uACBD\uC740 \uC9C4\uC9DC\"\uB77C\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uBCC0\uACBD\uC740 \uC9C4\uC9DC\uC600\uACE0, \uC99D\uAC70\uB294
        \uACC4\uC57D\uC11C\uC640 \uCC44\uD305\uBC29, \uC608\uAE08\uC8FC \uC774\uB984\uC5D0
        \uC788\uC5C8\uB2E4. \uC81C\uB54C \uACB0\uC815\uD558\uB294 \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 2800000, guid: b0ea4c8f2a0b7485090a31719663ea1c, type: 3}
    ruleTitle: "\uD655\uC778\uC740 \uC591\uCABD \uBAA8\uB450\uB97C \uC704\uD55C \uAC83"
    rule: "\uACC4\uC57D\uC11C\uC758 \uBC88\uD638, \uC9D1\uC8FC\uC778\uC774 \uC9C1\uC811
      \uC4F4 \uAE00, \uC608\uAE08\uC8FC \uC774\uB984\uC774 \uBAA8\uB450 \uB9DE\uC73C\uBA74
