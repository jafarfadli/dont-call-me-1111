  weekday: "\uC218\uC694\uC77C"
  shortLabel: "2\uC77C\uCC28 \xB7 10\uC6D4 7\uC77C (\uC218)"
  place: "\uC11C\uC6B8 \uB9C8\uD3EC\uAD6C \uB9DD\uC6D0\uB3D9"
  startTime: 16:20
  intro: "\uC6D4\uC138 \uB0B4\uB294 \uB0A0. \uB9E4\uB2EC \uADF8\uB7AC\uB4EF \uC218\uC5C5
    \uB05D\uB098\uACE0 \uCD5C \uC0AC\uC7A5\uB2D8\uAED8 \uBCF4\uB0BC \uC0DD\uAC01\uC774\uC5C8\uB2E4."
  ringDelay: 7
  variants:
  - id: scam
    conversation: {fileID: 11400000, guid: 7d60525c4d12646d9b2a30d6830223a7, type: 2}
    phone: {fileID: 11400000, guid: a232c996df79e4822b5b79a29ffa335a, type: 2}
    room: {fileID: 11400000, guid: c5eb52fc378664720af172cfb373f6f4, type: 2}
    directory: {fileID: 11400000, guid: 1ae2bbe1167e54883acd4b1c157a9598, type: 2}
    clues:
    - id: number
      text: "\uBC1C\uC2E0 \uBC88\uD638\uB294 \uC544\uB4E4 \uBC88\uD638\uAC00 \uC544\uB2C8\uB2E4.
        \uACC4\uC57D\uC11C\uC758 \uC544\uB4E4 \uBC88\uD638\uB294 010-2280-6614\uC774\uACE0,
        \uCCB4\uD06C\uD37C\uC2A4\uD2B8\uC5D0\uB294 \uBC1C\uC2E0 \uBC88\uD638\uAC00
        6\uC77C \uC804 \uAC1C\uD1B5\uB41C \uC120\uBD88\uD3F0\uC73C\uB85C \uB098\uC628\uB2E4."
      where: "\uCC45\uC0C1 \uC11C\uB78D \u2192 \uC784\uB300\uCC28 \uACC4\uC57D\uC11C,
        \uB610\uB294 \uCEF4\uD4E8\uD130 \u2192 \uC804\uD654\uBC88\uD638 \uC870\uD68C"
      guide: 
      when:
      - kind: 1
        target: "\uC784\uB300\uCC28 \uACC4\uC57D\uC11C \xB7 302\uD638"
      - kind: 2
        target: 010-4127-8830
    - id: account_owner
      text: "'\uC0C8 \uC6D4\uC138 \uACC4\uC88C'\uB294 \uBAA8\uB974\uB294 \uC0AC\uB78C
        \uBA85\uC758\uB2E4: \uC11C\uC9C0\uC5F0."
      where: "\uCEF4\uD4E8\uD130 \u2192 \uACC4\uC88C \uC870\uD68C"
      guide: 
      when:
      - kind: 2
        target: 620-118-449027
      - kind: 3
        target: 620-118-449027
    - id: landlord
      text: "\uCD5C \uC0AC\uC7A5\uB2D8\uC740 \uC624\uD6C4\uC5D0 \uC785\uC8FC\uBBFC
        \uCC44\uD305\uC5D0 \uAE00\uC744 \uC62C\uB838\uB2E4. \uC9D1\uC5D0\uC11C \uC804\uB4F1\uC744
        \uACE0\uCE58\uACE0 \uC788\uC5C8\uACE0, \uC6D4\uC138\uB294 \uB298 \uBCF4\uB0B4\uB358
        \uACC4\uC88C\uB85C \uB2EC\uB77C\uACE0 \uD588\uB2E4."
      where: "\uCC44\uD305 \u2192 \uB9DD\uC6D0\uD558\uC774\uCE20 \uC785\uC8FC\uBBFC"
      guide: 
      when:
      - kind: 4
        target: villa
    papers:
    - outcome: 1
      headline: "\uC6D4\uC138 \uB0A0 '\uAC00\uC9DC \uC9D1\uC8FC\uC778 \uC544\uB4E4'
        \uC804\uD654"
      subhead: "\uC9D1\uC8FC\uC778\uC740 \uB0B4\uB0B4 \uC9D1\uC5D0 \uC788\uC5C8\uB2E4.
        \uACC4\uC57D\uC11C\uB97C \uD655\uC778\uD55C \uC138\uC785\uC790\uB4E4\uC740
        \uC6D4\uC138\uB97C \uC9C0\uCF30\uB2E4."
      body: "\uC5B4\uC81C \uC6D4\uC138 \uB0A0, \uB9DD\uC6D0\uB3D9\uC758 \uD55C \uC9D1\uC8FC\uC778
        \uC544\uB4E4\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uC138\uC785\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 \uC544\uBC84\uC9C0\uAC00
        \uC785\uC6D0\uD588\uB2E4\uBA70 \uC774\uBC88 \uB2EC \uC6D4\uC138\uB97C \uC624\uD6C4
        5\uC2DC \uC804\uAE4C\uC9C0 \uC0C8 \uACC4\uC88C\uB85C \uBCF4\uB0B4 \uB2EC\uB77C\uACE0
        \uD588\uB2E4.\n\n\uC9C4\uC9DC \uC9D1\uC8FC\uC778 \uCD5C\uC601\uC2DD(71) \uC528\uB294
        \uC785\uC6D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB294 \uC624\uD6C4 \uB0B4\uB0B4
        \uBB3C\uD0F1\uD06C \uCCAD\uC18C\uB97C \uC900\uBE44\uD558\uACE0 \uC788\uC5C8\uB2E4.
        \uCD5C \uC528\uB294 \"\uC544\uB4E4 \uBC88\uD638\uB294 \uBAA8\uB4E0 \uACC4\uC57D\uC11C\uC5D0
        \uC801\uD600 \uC788\uB2E4\"\uBA70 \"\uC6D4\uC138 \uACC4\uC88C\uB294 \uB0B4\uAC00
        \uAE00\uB85C \uC368\uC11C \uC54C\uB9B4 \uB54C\uB9CC \uBC14\uB010\uB2E4\"\uACE0
        \uB9D0\uD588\uB2E4.\n\n\uACBD\uCC30\uC5D0 \uB530\uB974\uBA74 \uB0A8\uC131\uC774
        \uBD88\uB7EC \uC900 \uD55C\uBE5B\uC740\uD589 620-118-449027\uC740 \uC628\uB77C\uC778\uC5D0\uC11C
        \uD1B5\uC7A5\uC744 \uD310 \uC5EC\uC131\uC758 \uBA85\uC758\uB2E4. 010-4127-8830\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uC5D0 \uC2E0\uACE0\uD574
        \uB2EC\uB77C\uACE0 \uACBD\uCC30\uC740 \uB2F9\uBD80\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uACE0 \uC6D4\uC138\uB97C \uC9C0\uCF30\uB2E4.
        \uACC4\uC57D\uC11C\uC5D0\uB294 \uC544\uB4E4\uC758 \uC9C4\uC9DC \uBC88\uD638\uAC00
        \uC788\uC5C8\uACE0, \uCC44\uD305\uBC29\uC740 \uCD5C \uC0AC\uC7A5\uB2D8\uC774
        \uC9D1\uC5D0 \uC788\uB2E4\uB294 \uAC78 \uBCF4\uC5EC \uC92C\uB2E4."
      print: {fileID: 2800000, guid: a06f1c739f7134d4791f730c22576dd0, type: 3}
    - outcome: 0
      headline: "\uC138\uC785\uC790, \uAC00\uC9DC \uC9D1\uC8FC\uC778 \uC544\uB4E4\uC5D0\uAC8C
        \uD55C \uB2EC \uCE58 \uC6D4\uC138 \uB0A0\uB824"
      subhead: "45\uB9CC \uC6D0\uC774 \uBAA8\uB974\uB294 \uC0AC\uB78C \uACC4\uC88C\uB85C
        \uB4E4\uC5B4\uAC14\uB2E4. \uC9D1\uC8FC\uC778\uC740 \uADF8\uB7F0 \uC694\uCCAD\uC744
        \uD55C \uC801\uC774 \uC5C6\uB2E4."
      body: "\uC5B4\uC81C \uC6D4\uC138 \uB0A0, \uB9DD\uC6D0\uB3D9\uC758 \uD55C \uC9D1\uC8FC\uC778
        \uC544\uB4E4\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uC138\uC785\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 \uC544\uBC84\uC9C0\uAC00
        \uC785\uC6D0\uD588\uB2E4\uBA70 \uC774\uBC88 \uB2EC \uC6D4\uC138\uB97C \uC624\uD6C4
        5\uC2DC \uC804\uAE4C\uC9C0 \uC0C8 \uACC4\uC88C\uB85C \uBCF4\uB0B4 \uB2EC\uB77C\uACE0
        \uD588\uB2E4.\n\n22\uC138 \uB300\uD559\uC0DD \uD55C \uBA85\uC774 \uD55C\uBE5B\uC740\uD589
        620-118-449027\uB85C 45\uB9CC \uC6D0\uC744 \uBCF4\uB0C8\uB2E4. \uC774 \uACC4\uC88C\uB294
        \uC628\uB77C\uC778\uC5D0\uC11C \uD1B5\uC7A5\uC744 \uD310 \uC5EC\uC131\uC758
        \uBA85\uC758\uB85C, \uB3C8\uC740 \uBA87 \uBD84 \uB9CC\uC5D0 \uC778\uCD9C\uB410\uB2E4.\n\n\uC9C4\uC9DC
        \uC9D1\uC8FC\uC778 \uCD5C\uC601\uC2DD(71) \uC528\uB294 \uC785\uC6D0\uD558\uC9C0
        \uC54A\uC558\uB2E4. \uADF8\uB294 \uC624\uD6C4 \uB0B4\uB0B4 \uBB3C\uD0F1\uD06C
        \uCCAD\uC18C\uB97C \uC900\uBE44\uD558\uACE0 \uC788\uC5C8\uB2E4. \uCD5C \uC528\uB294
        \"\uC544\uB4E4 \uBC88\uD638\uB294 \uBAA8\uB4E0 \uACC4\uC57D\uC11C\uC5D0 \uC801\uD600
        \uC788\uB2E4\"\uBA70 \"\uC6D4\uC138 \uACC4\uC88C\uB294 \uB0B4\uAC00 \uAE00\uB85C
        \uC368\uC11C \uC54C\uB9B4 \uB54C\uB9CC \uBC14\uB010\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uACBD\uCC30\uC740
        010-4127-8830\uC73C\uB85C \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740
        112\uC5D0 \uC2E0\uACE0\uD574 \uB2EC\uB77C\uACE0 \uB2F9\uBD80\uD588\uB2E4."
      verdictNote: "\uACC4\uC88C\uB294 '\uC11C\uC9C0\uC5F0' \uBA85\uC758\uC600\uACE0,
        \uBC1C\uC2E0 \uBC88\uD638\uB294 \uACC4\uC57D\uC11C\uC758 \uBC88\uD638\uAC00
        \uC544\uB2C8\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: ea57a939011f04348a395ee087c03de5, type: 3}
    - outcome: 3
      headline: "\uC6D4\uC138 \uB0A0 \uC804\uD654: '\uC0C8 \uACC4\uC88C\uB85C \uBCF4\uB0B4
        \uC8FC\uC138\uC694'"
      subhead: "\uB9DD\uC6D0\uB3D9 \uC138\uC785\uC790\uB4E4\uC740 \uC6D4\uC138\uB97C
        \uC9C0\uCF30\uC9C0\uB9CC \uC2E0\uACE0\uB294 \uC801\uC5C8\uB2E4."
      body: "\uC5B4\uC81C \uC6D4\uC138 \uB0A0, \uB9DD\uC6D0\uB3D9\uC758 \uD55C \uC9D1\uC8FC\uC778
        \uC544\uB4E4\uC744 \uC790\uCE6D\uD55C \uB0A8\uC131\uC774 \uC138\uC785\uC790\uB4E4\uC5D0\uAC8C
        \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uADF8\uB294 \uC544\uBC84\uC9C0\uAC00
        \uC785\uC6D0\uD588\uB2E4\uBA70 \uC774\uBC88 \uB2EC \uC6D4\uC138\uB97C \uC624\uD6C4
        5\uC2DC \uC804\uAE4C\uC9C0 \uC0C8 \uACC4\uC88C\uB85C \uBCF4\uB0B4 \uB2EC\uB77C\uACE0
        \uD588\uB2E4.\n\n\uB300\uBD80\uBD84\uC758 \uC138\uC785\uC790\uB294 \uC0C1\uB300\uAC00
        \uD3EC\uAE30\uD560 \uB54C\uAE4C\uC9C0 \uC804\uD654\uB97C \uBD99\uB4E4\uACE0\uB9CC
        \uC788\uC5C8\uB2E4. \uC9C4\uC9DC \uC9D1\uC8FC\uC778 \uCD5C\uC601\uC2DD(71)
        \uC528\uB294 \uC785\uC6D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB294 \uC624\uD6C4
        \uB0B4\uB0B4 \uBB3C\uD0F1\uD06C \uCCAD\uC18C\uB97C \uC900\uBE44\uD558\uACE0
        \uC788\uC5C8\uB2E4. \uCD5C \uC528\uB294 \"\uC544\uB4E4 \uBC88\uD638\uB294
        \uBAA8\uB4E0 \uACC4\uC57D\uC11C\uC5D0 \uC801\uD600 \uC788\uB2E4\"\uBA70 \"\uC6D4\uC138
        \uACC4\uC88C\uB294 \uB0B4\uAC00 \uAE00\uB85C \uC368\uC11C \uC54C\uB9B4 \uB54C\uB9CC
        \uBC14\uB010\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uACBD\uCC30\uC740 010-4127-8830\uC73C\uB85C
        \uC804\uD654\uB97C \uBC1B\uC740 \uC0AC\uB78C\uC740 112\uC5D0 \uC2E0\uACE0\uD574
        \uB2EC\uB77C\uACE0 \uB2F9\uBD80\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uACB0\uC815\uB3C4
        \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4. \uB2F5\uC740 \uACC4\uC57D\uC11C\uC640
        \uC785\uC8FC\uBBFC \uCC44\uD305\uBC29\uC5D0 \uC788\uC5C8\uB2E4."
      print: {fileID: 2800000, guid: b50c7feb78cca44bda836bf6ed090715, type: 3}
    ruleTitle: "\uC0C8 \uC6D4\uC138 \uACC4\uC88C? \uACC4\uC57D\uC11C\uB97C \uD655\uC778\uD558\uB77C"
    rule: "\uC2E0\uACE0\uAC00 \uC5C6\uB2E4\uACE0 \uC548\uC804\uD55C \uAC74 \uC544\uB2C8\uB2E4.
      \uBC1C\uC2E0 \uBC88\uD638\uC640 \uC608\uAE08\uC8FC \uC774\uB984\uC744 \uACC4\uC57D\uC11C\uC640
      \uB300\uC870\uD558\uACE0, \uC9D1\uC8FC\uC778\uC774 \uC9C1\uC811 \uC4F4 \uAE00\uC744
      \uD655\uC778\uD558\uB77C."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 8\uC77C"
