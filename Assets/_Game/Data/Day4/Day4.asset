    directory: {fileID: 11400000, guid: 68e872ffd2e7f432fad22e5aa2f4742d, type: 2}
    clues:
    - id: face
      text: Her lips moved with her words, and the picture held steady.
      where: "Video call \u2192 circle her face"
      guide: 
      when:
      - kind: 7
        target: video_face
    - id: wave
      text: When she waved, her hand covered her face as it passed.
      where: "Video call \u2192 ask her to wave, then circle it"
      guide: 
      when:
      - kind: 7
        target: video_wave
    - id: yuna_chat
      text: 'Yuna wrote to you from the hotel lobby PC at 15:47: her bag was snatched,
        and she would call from Somin''s phone.'
      where: "Chats \u2192 Yuna"
      guide: 
      when:
      - kind: 7
        target: chat_yuna
    - id: quiz
      text: 'She knew what you ate after class yesterday: tteokbokki, and your burnt
        tongue.'
      where: "The call \u2192 ask what you ate yesterday"
      guide: 
      when:
      - kind: 7
        target: call_quiz
