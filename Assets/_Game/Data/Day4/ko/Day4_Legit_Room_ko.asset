  m_Script: {fileID: 11500000, guid: b53d3a7811bb8498d9ae0485fd422ad9, type: 3}
  m_Name: Day4_Legit_Room_ko
  m_EditorClassIdentifier: DontCallMe::DontCallMe.Data.RoomContent
  newspaper:
    masthead: "\uC11C\uC6B8\uB370\uC77C\uB9AC"
    issue: "\uC81C12,411\uD638"
    dateLine: "2026\uB144 10\uC6D4 9\uC77C \uAE08\uC694\uC77C"
    price: "1,000\uC6D0"
    headline: "\uAC00\uC9DC \uD1B5\uAD00\uD300, \uC720\uCD9C\uB41C \uC54C\uB9AC\uC2A4\uD0C0
      \uC8FC\uBB38 \uC815\uBCF4 \uC545\uC6A9"
    subhead: "\uC0C1\uB300\uB294 \uC0C1\uD488\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uAE4C\uC9C0
      \uC54C\uACE0 \uC788\uC5C8\uB2E4. \uD0DD\uBC30\uB294 \uC774\uBBF8 \uD1B5\uAD00\uC744
      \uB9C8\uCE5C \uC0C1\uD0DC\uC600\uB2E4."
    photo: {fileID: 2800000, guid: 4c63c0d2cf38942db834f06de02c655f, type: 3}
    caption: "\uC774\uCCB4 \uC804, \uC740\uD589\uC740 \uB3C8\uC744 \uC2E4\uC81C\uB85C
      \uBC1B\uB294 \uC0AC\uB78C\uC744 \uBCF4\uC5EC \uC900\uB2E4. \uC0AC\uC9C4: \uC11C\uC6B8\uB370\uC77C\uB9AC"
    body:
    - "\uC5B4\uC81C \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 '\uD1B5\uAD00\uD300'\uC744
      \uC0AC\uCE6D\uD55C \uC804\uD654\uAC00 \uB9C8\uD3EC\uC758 \uC54C\uB9AC\uC2A4\uD0C0
      \uACE0\uAC1D\uB4E4\uC5D0\uAC8C \uAC78\uB824 \uC654\uB2E4. \uC774\uB4E4\uC740
      \uACE0\uAC1D\uC758 \uC8FC\uBB38 \uB0B4\uC5ED\uACFC \uC6B4\uC1A1\uC7A5 \uBC88\uD638\uB97C
      \uC74A\uC73C\uBA70 '\uBBF8\uB0A9 \uAD00\uC138'\uB97C \uC624\uD6C4 5\uC2DC \uC804\uAE4C\uC9C0
      \uACC4\uC88C\uB85C \uB0B4\uB77C\uACE0 \uC694\uAD6C\uD588\uB2E4."
    - "\uC774 \uC815\uBCF4\uB294 \uC9C0\uB09C\uB2EC \uC54C\uB9AC\uC2A4\uD0C0 \uAC1C\uC778\uC815\uBCF4
      \uC720\uCD9C\uC5D0\uC11C \uB098\uC628 \uAC83\uC774\uC5C8\uB2E4. \uD0DD\uBC30\uB294
      \uC774\uBBF8 \uC138\uAE08\uC774 \uB0A9\uBD80\uB41C \uCC44 \uD1B5\uAD00\uC744
      \uB9C8\uCCE4\uACE0, \uC804\uD654\uB294 \uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4\uC758
      \uC9C4\uC9DC \uBC88\uD638 1588-5520\uACFC \uD55C \uC790\uB9AC \uB2E4\uB978
      1588-5502\uC5D0\uC11C \uAC78\uB824 \uC654\uB2E4."
    - "\uD55C\uAC15\uC775\uC2A4\uD504\uB808\uC2A4 \uAD00\uACC4\uC790\uB294 \"\uAD00\uC138\uAC00
      \uC788\uC73C\uBA74 \uC800\uD76C\uAC00 \uBCF4\uB0B4\uB294 \uC54C\uB9BC\uC5D0
      \uC800\uD76C \uBA85\uC758 \uACC4\uC88C\uC640 \uD568\uAED8 \uC548\uB0B4\uB41C\uB2E4\"\uBA70
      \"\uB2E4\uB978 \uC0AC\uB78C\uC5D0\uAC8C \uB3C8\uC744 \uB0B4\uB77C\uACE0 \uD558\uB294
      \uC77C\uC740 \uC808\uB300 \uC5C6\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4."
    warningTitle: "\uC601\uC0C1\uD1B5\uD654\uB3C4 \uAC00\uC9DC\uC77C \uC218 \uC788\uB2E4"
    warningText: "\uC0AC\uAE30\uBC94\uB4E4\uC740 \uC774\uC81C \uACF5\uAC1C\uB41C
      \uC601\uC0C1 \uBA87 \uAC1C\uB85C \uCE5C\uAD6C\uC758 \uC5BC\uAD74\uC744 \uB9CC\uB4E4\uC5B4
      \uC2E4\uC2DC\uAC04 \uC601\uC0C1\uD1B5\uD654\uC5D0 \uC50C\uC6B4\uB2E4. \uC785
      \uBAA8\uC591\uC774 \uBAA9\uC18C\uB9AC\uC640 \uB9DE\uB294\uC9C0 \uBCF4\uACE0,
      \uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744 \uD754\uB4E4\uC5B4
      \uB2EC\uB77C\uACE0 \uD558\uB77C. \uC50C\uC6B4 \uC5BC\uAD74\uC740 \uC190 \uC704\uC5D0
      \uADF8\uB300\uB85C \uB5A0 \uC788\uB2E4. \uADF8\uB9AC\uACE0 \uB298 \uC5F0\uB77D\uD558\uB358
      \uACF3\uC5D0\uC11C \uBCF8\uC778\uC5D0\uAC8C \uBB3C\uC5B4\uBCF4\uB77C."
    print: {fileID: 0}
    local:
    - title: "\uB9DD\uC6D0\uC2DC\uC7A5\uC758 \uD55C\uAE00\uB0A0"
      text: "\uC815\uBB38 \uC55E \uBB34\uB8CC \uBD93\uAE00\uC528 \uCCB4\uD5D8, 11:00~17:00."
    - title: "\uB3C4\uC11C\uAD00 \uC6B4\uC601 \uC2DC\uAC04"
      text: "\uB9C8\uD3EC\uC911\uC559\uB3C4\uC11C\uAD00\uC740 \uC624\uB298 \uD734\uAD00\uD558\uACE0
        \uD1A0\uC694\uC77C 9\uC2DC\uC5D0 \uBB38\uC744 \uC5F0\uB2E4."
    - title: "\uC5F0\uD734 \uACF5\uD56D \uD63C\uC7A1"
      text: "\uAE40\uD3EC\uC640 \uC778\uCC9C \uACF5\uD56D\uC740 \uC5EC\uB984 \uC774\uD6C4
        \uAC00\uC7A5 \uBD90\uBE44\uB294 \uAE08\uC694\uC77C\uC744 \uC608\uC0C1\uD55C\uB2E4."
    ads:
    - title: "24\uC2DC \uCE58\uD0A8"
      text: "\uD6C4\uB77C\uC774\uB4DC & \uAC04\uC7A5\uB9C8\uB298. 2\uB9CC \uC6D0
        \uC774\uC0C1 \uBB34\uB8CC \uBC30\uB2EC. 02-555-0147"
    - title: "\uCCB4\uD06C\uD37C\uC2A4\uD2B8"
      text: "\uADF8 \uBC88\uD638\uC758 \uC8FC\uC778\uC740? \uADF8 \uACC4\uC88C\uC758
        \uC608\uAE08\uC8FC\uB294? \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uC870\uD68C\uD558\uC138\uC694.
        checkfirst.kr"
    - title: "\uD55C\uBE5B\uD559\uC6D0"
      text: "\uD1A0\uC775 \uC8FC\uB9D0\uBC18, \uB300\uD559\uC0DD 30% \uD560\uC778.
        02-555-0166"
  drawer:
  - title: "\uC784\uB300\uCC28 \uACC4\uC57D\uC11C \xB7 302\uD638"
