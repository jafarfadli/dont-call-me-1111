    papers:
    - outcome: 1
      headline: "'\uB098\uC57C': \uCE5C\uAD6C \uC5BC\uAD74\uC744 \uC50C\uC6B4 \uC601\uC0C1\uD1B5\uD654"
      subhead: "\uC5BC\uAD74\uC740 \uC775\uC219\uD588\uB2E4. \uC9C4\uC9DC \uCE5C\uAD6C\uB4E4\uC740
        \uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C \uB77C\uBA58\uC744 \uBA39\uACE0 \uC788\uC5C8\uB2E4."
      body: "\"\uBCF4\uC5EC? \uB098\uC57C.\" \uD55C\uAE00\uB0A0, \uB9C8\uD3EC\uC758
        \uB300\uD559\uC0DD\uB4E4\uC774 \uD574\uC678\uC5EC\uD589 \uC911\uC778 \uCE5C\uAD6C\uB4E4\uC758
        \uC601\uC0C1\uD1B5\uD654\uB97C \uBC1B\uC558\uB2E4. \uC775\uC219\uD55C \uC5BC\uAD74,
        \uB3C4\uB09C\uB2F9\uD55C \uAC00\uBC29, 5\uC2DC \uC804\uC5D0 \uB0B4\uC57C
        \uD558\uB294 \uD638\uD154\uBE44, \uADF8\uB9AC\uACE0 \uC0AC\uCD0C \uBA85\uC758\uC758
        \uACC4\uC88C.\n\n\uACBD\uCC30\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uC62C\uB9B0
        \uC5EC\uD589 \uC601\uC0C1\uC73C\uB85C \uC5BC\uAD74\uC744 \uB9CC\uB4E4\uC5B4
        \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC50C\uC6B4 \uAC83\uC73C\uB85C \uBCF4\uACE0
        \uC788\uB2E4. \uC804\uD654\uC640 \uACC4\uC88C\uB294 '\uBD80\uC5C5'\uC774\uB77C\uB294
        \uB9D0\uC5D0 \uC18D\uC544 \uBA85\uC758\uB97C \uBE4C\uB824\uC900 \uC2E4\uC81C
        \uC5EC\uC131\uC758 \uAC83\uC774\uC5B4\uC11C, \uC870\uD68C\uD574\uB3C4 \uC774\uC0C1\uD55C
        \uC810\uC774 \uB098\uC624\uC9C0 \uC54A\uC558\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C
        \uAD00\uACC4\uC790\uB294 \"\uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788
        \uC190\uC744 \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uB77C. \uC50C\uC6B4
        \uC5BC\uAD74\uC740 \uC190 \uC704\uC5D0 \uADF8\uB300\uB85C \uB5A0 \uC788\uB2E4.
        \uADF8\uB9AC\uACE0 \uC6D0\uB798 \uC4F0\uB358 \uCC44\uD305\uBC29\uC5D0\uC11C
        \uCE5C\uAD6C\uC5D0\uAC8C \uBB3C\uC5B4\uBCF4\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC804\uD654\uB97C \uB04A\uC5C8\uB2E4. \uC9C4\uC9DC \uC720\uB098\uB294
        \uBC29\uAE08 \uC790\uAE30 \uD3F0\uC73C\uB85C \uC0AC\uC9C4\uC744 \uBCF4\uB0B8
        \uCC38\uC774\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 0
      headline: "\uB3C4\uB09C\uB2F9\uD55C \uC801 \uC5C6\uB294 \uAC00\uBC29\uC5D0
        65\uB9CC \uC6D0"
      subhead: "\uB9DD\uC6D0\uB3D9 \uB300\uD559\uC0DD, '\uCE5C\uAD6C' \uD638\uD154\uBE44
        \uC1A1\uAE08\u2026 \uCE5C\uAD6C\uB294 \uB77C\uBA58 \uC904\uC5D0 \uC11C \uC788\uC5C8\uB2E4"
      body: "\"\uBCF4\uC5EC? \uB098\uC57C.\" \uD55C\uAE00\uB0A0, \uB9C8\uD3EC\uC758
        \uB300\uD559\uC0DD\uB4E4\uC774 \uD574\uC678\uC5EC\uD589 \uC911\uC778 \uCE5C\uAD6C\uB4E4\uC758
        \uC601\uC0C1\uD1B5\uD654\uB97C \uBC1B\uC558\uB2E4. \uC775\uC219\uD55C \uC5BC\uAD74,
        \uB3C4\uB09C\uB2F9\uD55C \uAC00\uBC29, 5\uC2DC \uC804\uC5D0 \uB0B4\uC57C
        \uD558\uB294 \uD638\uD154\uBE44, \uADF8\uB9AC\uACE0 \uC0AC\uCD0C \uBA85\uC758\uC758
        \uACC4\uC88C.\n\n22\uC138 \uB300\uD559\uC0DD \uD55C \uBA85\uC740 65\uB9CC
        \uC6D0\uC744 \uBCF4\uB0C8\uB2E4. \uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C \uD734\uAC00
        \uC911\uC774\uB358 \uCE5C\uAD6C\uB294 \uC804\uD654 20\uBD84 \uC804\uC5D0
        \uB77C\uBA58 \uC904 \uC0AC\uC9C4\uC744 \uBCF4\uB0B8 \uC0C1\uD0DC\uC600\uB2E4.
        \uACBD\uCC30\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uC62C\uB9B0 \uC5EC\uD589 \uC601\uC0C1\uC73C\uB85C
        \uC5BC\uAD74\uC744 \uB9CC\uB4E4\uC5B4 \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC50C\uC6B4
        \uAC83\uC73C\uB85C \uBCF4\uACE0 \uC788\uB2E4. \uC804\uD654\uC640 \uACC4\uC88C\uB294
        '\uBD80\uC5C5'\uC774\uB77C\uB294 \uB9D0\uC5D0 \uC18D\uC544 \uBA85\uC758\uB97C
        \uBE4C\uB824\uC900 \uC2E4\uC81C \uC5EC\uC131\uC758 \uAC83\uC774\uC5B4\uC11C,
        \uC870\uD68C\uD574\uB3C4 \uC774\uC0C1\uD55C \uC810\uC774 \uB098\uC624\uC9C0
        \uC54A\uC558\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C \uAD00\uACC4\uC790\uB294
        \"\uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744 \uD754\uB4E4\uC5B4
        \uB2EC\uB77C\uACE0 \uD558\uB77C. \uC50C\uC6B4 \uC5BC\uAD74\uC740 \uC190 \uC704\uC5D0
        \uADF8\uB300\uB85C \uB5A0 \uC788\uB2E4. \uADF8\uB9AC\uACE0 \uC6D0\uB798 \uC4F0\uB358
        \uCC44\uD305\uBC29\uC5D0\uC11C \uCE5C\uAD6C\uC5D0\uAC8C \uBB3C\uC5B4\uBCF4\uB77C\"\uACE0
        \uB9D0\uD588\uB2E4."
      verdictNote: "\uB2F5\uC740 \uCC44\uD305\uBC29\uC5D0 \uC788\uC5C8\uB2E4. \uC720\uB098\uB294
        15:58\uC5D0 \uC790\uAE30 \uD3F0\uC73C\uB85C \uC0AC\uC9C4\uC744 \uBCF4\uB0C8\uB2E4."
      print: {fileID: 0}
    - outcome: 3
      headline: "\uC5BC\uAD74\uC740 \uCE5C\uAD6C, \uC804\uD654\uB294 \uB0A8"
      subhead: "\uD55C\uAE00\uB0A0, \uBCF5\uC81C\uB41C \uC5BC\uAD74\uC774 \uB9C8\uD3EC\uC758
        \uB300\uD559\uC0DD\uB4E4\uC5D0\uAC8C \uC601\uC0C1\uD1B5\uD654\uB97C \uAC78\uC5C8\uB2E4."
      body: "\"\uBCF4\uC5EC? \uB098\uC57C.\" \uD55C\uAE00\uB0A0, \uB9C8\uD3EC\uC758
        \uB300\uD559\uC0DD\uB4E4\uC774 \uD574\uC678\uC5EC\uD589 \uC911\uC778 \uCE5C\uAD6C\uB4E4\uC758
        \uC601\uC0C1\uD1B5\uD654\uB97C \uBC1B\uC558\uB2E4. \uC775\uC219\uD55C \uC5BC\uAD74,
        \uB3C4\uB09C\uB2F9\uD55C \uAC00\uBC29, 5\uC2DC \uC804\uC5D0 \uB0B4\uC57C
        \uD558\uB294 \uD638\uD154\uBE44, \uADF8\uB9AC\uACE0 \uC0AC\uCD0C \uBA85\uC758\uC758
        \uACC4\uC88C.\n\n\uACBD\uCC30\uC740 \uCE5C\uAD6C\uB4E4\uC774 \uC62C\uB9B0
        \uC5EC\uD589 \uC601\uC0C1\uC73C\uB85C \uC5BC\uAD74\uC744 \uB9CC\uB4E4\uC5B4
        \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC50C\uC6B4 \uAC83\uC73C\uB85C \uBCF4\uACE0
        \uC788\uB2E4. \uC804\uD654\uC640 \uACC4\uC88C\uB294 '\uBD80\uC5C5'\uC774\uB77C\uB294
        \uB9D0\uC5D0 \uC18D\uC544 \uBA85\uC758\uB97C \uBE4C\uB824\uC900 \uC2E4\uC81C
        \uC5EC\uC131\uC758 \uAC83\uC774\uC5B4\uC11C, \uC870\uD68C\uD574\uB3C4 \uC774\uC0C1\uD55C
        \uC810\uC774 \uB098\uC624\uC9C0 \uC54A\uC558\uB2E4.\n\n\uB9C8\uD3EC\uACBD\uCC30\uC11C
        \uAD00\uACC4\uC790\uB294 \"\uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788
        \uC190\uC744 \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uB77C. \uC50C\uC6B4
        \uC5BC\uAD74\uC740 \uC190 \uC704\uC5D0 \uADF8\uB300\uB85C \uB5A0 \uC788\uB2E4.
        \uADF8\uB9AC\uACE0 \uC6D0\uB798 \uC4F0\uB358 \uCC44\uD305\uBC29\uC5D0\uC11C
        \uCE5C\uAD6C\uC5D0\uAC8C \uBB3C\uC5B4\uBCF4\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uB3C8\uC740 \uBCF4\uB0B4\uC9C0 \uC54A\uC558\uC9C0\uB9CC \uACB0\uC815\uB3C4
        \uB0B4\uB9AC\uC9C0 \uBABB\uD588\uB2E4. \uC190 \uD55C \uBC88, \uCC44\uD305\uBC29
        \uD55C \uBC88\uC774\uBA74 \uC54C \uC218 \uC788\uC5C8\uB2E4."
      print: {fileID: 0}
