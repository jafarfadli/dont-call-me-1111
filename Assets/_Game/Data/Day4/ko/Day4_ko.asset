    papers:
    - outcome: 0
      headline: "\uB3C4\uB09C\uB2F9\uD55C \uAC00\uBC29, \uADF8\uB9AC\uACE0 \uBA3C\uC800
        \uD655\uC778\uD55C \uCE5C\uAD6C"
      subhead: "\uADF8\uB140\uB294 \uC804\uD654\uD558\uAE30 \uC804\uC5D0 \uD638\uD154
        \uB85C\uBE44\uC5D0\uC11C \uAE00\uC744 \uB0A8\uACBC\uB2E4. \uCE5C\uAD6C\uB294
        \uADF8\uAC78 \uC77D\uACE0 \uB098\uC11C \uB3C8\uC744 \uBCF4\uB0C8\uB2E4."
      body: "\uAC00\uC9DC \uC5BC\uAD74 \uC0AC\uAE30\uAC00 \uD55C \uB2EC\uC9F8 \uC774\uC5B4\uC9C0\uBA74\uC11C,
        \uC9C4\uC9DC \uB3C4\uC6C0 \uC694\uCCAD \uC601\uC0C1\uD1B5\uD654\uB3C4 \uAC00\uC9DC\uC640
        \uB611\uAC19\uC544 \uBCF4\uC774\uAC8C \uB410\uB2E4. \uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C
        \uD734\uAC00\uB97C \uBCF4\uB0B4\uB358 \uD55C \uB300\uD559\uC0DD\uC740 \uD55C\uAE00\uB0A0
        \uADF8\uAC78 \uC2E4\uAC10\uD588\uB2E4. \uD558\uCE74\uD0C0\uC5ED\uC5D0\uC11C
        \uAC00\uBC29\uC744 \uB0A0\uCE58\uAE30 \uB2F9\uD574 \uC0AC\uCD0C\uC758 \uD3F0\uC73C\uB85C
        \uC11C\uC6B8\uC758 \uCE5C\uAD6C\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uC744
        \uB54C\uC600\uB2E4.\n\n\uADF8\uB140\uB294 \"\uCE5C\uAD6C\uAC00 \uC5BC\uAD74
        \uC55E\uC5D0\uC11C \uC190\uC744 \uD754\uB4E4\uC5B4 \uBCF4\uB77C\uACE0 \uD558\uB354\uB2C8,
        \uB0B4 \uBA54\uC2DC\uC9C0\uB97C \uC77D\uACE0 \uB3C8\uC744 \uBCF4\uB0B4 \uC92C\uB2E4\"\uBA70
        \"\uB355\uBD84\uC5D0 \uBC29\uC744 \uC9C0\uCF30\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4.\n\n\uACBD\uCC30\uC740
        \uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uD558\uB77C\uACE0
        \uAD8C\uD55C\uB2E4. \uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744
        \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uACE0, \uCE5C\uAD6C \uBCF8\uC778
        \uACC4\uC815\uC5D0\uC11C \uC628 \uBA54\uC2DC\uC9C0\uB97C \uCC3E\uC544\uBCF4\uB77C\uB294
        \uAC83\uC774\uB2E4. \uACBD\uCC30 \uAD00\uACC4\uC790\uB294 \"\uB458 \uB2E4
        \uB9DE\uC73C\uBA74 \uB3C4\uC640\uC8FC\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC815\uB9D0 \uC720\uB098\uC600\uACE0, \uB2F9\uC2E0\uC740 \uD655\uC778\uD588\uB2E4.
        \uC190\uC744 \uD754\uB4E4\uC5B4\uB3C4 \uC5BC\uAD74\uC740 \uADF8\uB300\uB85C\uC600\uACE0,
        \uC720\uB098\uAC00 \uC9C1\uC811 \uB0A8\uAE34 \uAE00\uC774 \uBAA8\uB974\uB294
        \uBC88\uD638\uB97C \uC124\uBA85\uD574 \uC8FC\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 1
      headline: "'\uCE5C\uAD6C\uAC00 \uB04A\uC5C8\uC5B4\uC694': \uC9C4\uC9DC \uCE5C\uAD6C\uAC00
        \uC804\uD654\uD588\uC744 \uB54C"
      subhead: "\uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C \uAC00\uBC29\uC744 \uB3C4\uB09C\uB2F9\uD55C
        \uB300\uD559\uC0DD\uC740 \uAC00\uC7A5 \uCE5C\uD55C \uCE5C\uAD6C\uB97C \uC124\uB4DD\uD558\uC9C0
        \uBABB\uD588\uB2E4."
      body: "\uAC00\uC9DC \uC5BC\uAD74 \uC0AC\uAE30\uAC00 \uD55C \uB2EC\uC9F8 \uC774\uC5B4\uC9C0\uBA74\uC11C,
        \uC9C4\uC9DC \uB3C4\uC6C0 \uC694\uCCAD \uC601\uC0C1\uD1B5\uD654\uB3C4 \uAC00\uC9DC\uC640
        \uB611\uAC19\uC544 \uBCF4\uC774\uAC8C \uB410\uB2E4. \uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C
        \uD734\uAC00\uB97C \uBCF4\uB0B4\uB358 \uD55C \uB300\uD559\uC0DD\uC740 \uD55C\uAE00\uB0A0
        \uADF8\uAC78 \uC2E4\uAC10\uD588\uB2E4. \uD558\uCE74\uD0C0\uC5ED\uC5D0\uC11C
        \uAC00\uBC29\uC744 \uB0A0\uCE58\uAE30 \uB2F9\uD574 \uC0AC\uCD0C\uC758 \uD3F0\uC73C\uB85C
        \uC11C\uC6B8\uC758 \uCE5C\uAD6C\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uC744
        \uB54C\uC600\uB2E4.\n\n\uADF8\uB140\uB294 \"\uCE5C\uAD6C\uAC00 \uC804\uD654\uB97C
        \uB04A\uC5C8\uB2E4\"\uBA74\uC11C\uB3C4 \"\uD0D3\uD560 \uC218\uB294 \uC5C6\uB2E4.
        \uB2E4\uB9CC \uC804\uD654\uD558\uAE30 \uC804\uC5D0 \uC6B0\uB9AC \uCC44\uD305\uBC29\uC5D0
        \uC368 \uB480\uC5C8\uB2E4\"\uACE0 \uB9D0\uD588\uB2E4. \uB3C8\uC740 \uC0AC\uCD0C\uC774
        \uD638\uD154 \uC8FC\uC778\uC5D0\uAC8C \uBE4C\uB838\uB2E4.\n\n\uACBD\uCC30\uC740
        \uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uD558\uB77C\uACE0
        \uAD8C\uD55C\uB2E4. \uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744
        \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uACE0, \uCE5C\uAD6C \uBCF8\uC778
        \uACC4\uC815\uC5D0\uC11C \uC628 \uBA54\uC2DC\uC9C0\uB97C \uCC3E\uC544\uBCF4\uB77C\uB294
        \uAC83\uC774\uB2E4. \uACBD\uCC30 \uAD00\uACC4\uC790\uB294 \"\uB458 \uB2E4
        \uB9DE\uC73C\uBA74 \uB3C4\uC640\uC8FC\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC774\uBC88\uC5D4 \uC9C4\uC9DC\uC600\uB2E4. \uC785 \uBAA8\uC591\uC740
        \uBAA9\uC18C\uB9AC\uC640 \uB9DE\uC558\uACE0, \uC720\uB098\uB294 \uC18C\uBBFC\uC774
        \uD3F0\uC73C\uB85C \uC804\uD654\uD558\uACA0\uB2E4\uACE0 \uCC44\uD305\uBC29\uC5D0
        \uC368 \uB450\uC5C8\uB2E4."
      print: {fileID: 0}
    - outcome: 3
      headline: "\uBC29\uC740 5\uC2DC\uC5D0 \uB118\uC5B4\uAC14\uB2E4"
      subhead: "\uD6C4\uCFE0\uC624\uCE74\uC758 \uB300\uD559\uC0DD\uC740 \uB05D\uB0B4
        \uACB0\uC815\uD558\uC9C0 \uBABB\uD55C \uCE5C\uAD6C\uB97C \uC601\uC0C1\uD1B5\uD654\uB85C
        \uAE30\uB2E4\uB838\uB2E4."
      body: "\uAC00\uC9DC \uC5BC\uAD74 \uC0AC\uAE30\uAC00 \uD55C \uB2EC\uC9F8 \uC774\uC5B4\uC9C0\uBA74\uC11C,
        \uC9C4\uC9DC \uB3C4\uC6C0 \uC694\uCCAD \uC601\uC0C1\uD1B5\uD654\uB3C4 \uAC00\uC9DC\uC640
        \uB611\uAC19\uC544 \uBCF4\uC774\uAC8C \uB410\uB2E4. \uD6C4\uCFE0\uC624\uCE74\uC5D0\uC11C
        \uD734\uAC00\uB97C \uBCF4\uB0B4\uB358 \uD55C \uB300\uD559\uC0DD\uC740 \uD55C\uAE00\uB0A0
        \uADF8\uAC78 \uC2E4\uAC10\uD588\uB2E4. \uD558\uCE74\uD0C0\uC5ED\uC5D0\uC11C
        \uAC00\uBC29\uC744 \uB0A0\uCE58\uAE30 \uB2F9\uD574 \uC0AC\uCD0C\uC758 \uD3F0\uC73C\uB85C
        \uC11C\uC6B8\uC758 \uCE5C\uAD6C\uC5D0\uAC8C \uC804\uD654\uB97C \uAC78\uC5C8\uC744
        \uB54C\uC600\uB2E4.\n\n\uADF8\uB140\uB294 \"5\uC2DC\uAE4C\uC9C0 \uC804\uD654\uB97C
        \uBD99\uB4E4\uACE0 \uC788\uC5C8\uB2E4\"\uBA70 \"\uCC44\uD305\uBC29\uC5D0
        \uB2E4 \uC368 \uB480\uB294\uB370\"\uB77C\uACE0 \uB9D0\uD588\uB2E4. \uADF8\uB140\uC640
        \uC0AC\uCD0C\uC740 \uADF8\uB0A0 \uBC24\uC744 PC\uBC29\uC5D0\uC11C \uBCF4\uB0C8\uB2E4.\n\n\uACBD\uCC30\uC740
        \uB3C8\uC744 \uBCF4\uB0B4\uAE30 \uC804\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uD558\uB77C\uACE0
        \uAD8C\uD55C\uB2E4. \uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744
        \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uACE0, \uCE5C\uAD6C \uBCF8\uC778
        \uACC4\uC815\uC5D0\uC11C \uC628 \uBA54\uC2DC\uC9C0\uB97C \uCC3E\uC544\uBCF4\uB77C\uB294
        \uAC83\uC774\uB2E4. \uACBD\uCC30 \uAD00\uACC4\uC790\uB294 \"\uB458 \uB2E4
        \uB9DE\uC73C\uBA74 \uB3C4\uC640\uC8FC\uB77C\"\uACE0 \uB9D0\uD588\uB2E4."
      verdictNote: "\uC815\uB9D0 \uC720\uB098\uC600\uACE0, \uB2F5\uC740 \uCC44\uD305\uBC29\uACFC
        \uADF8\uB140\uC758 \uC5BC\uAD74\uC5D0 \uC788\uC5C8\uB2E4. \uC81C\uB54C \uACB0\uC815\uD558\uB294
        \uAC83\uB3C4 \uC911\uC694\uD558\uB2E4."
      print: {fileID: 0}
    ruleTitle: "\uC5BC\uAD74\uC744 \uC2DC\uD5D8\uD558\uACE0, \uADF8\uB2E4\uC74C\uC5D0
      \uB3C4\uC640\uC8FC\uB77C"
    rule: "\uAC19\uC740 \uD655\uC778\uC774 \uC9C4\uC9DC \uC804\uD654\uB3C4 \uAC00\uB824
      \uC900\uB2E4. \uC785 \uBAA8\uC591\uC740 \uBAA9\uC18C\uB9AC\uC640 \uB9DE\uC558\uACE0,
      \uC190\uC740 \uC5BC\uAD74\uC744 \uAC00\uB838\uACE0, \uBCF8\uC778\uC774 \uCC44\uD305\uBC29\uC5D0
      \uC9C1\uC811 \uC368 \uB450\uC5C8\uB2E4."
    ruleSource: "\uC11C\uC6B8\uB370\uC77C\uB9AC, 10\uC6D4 10\uC77C"
