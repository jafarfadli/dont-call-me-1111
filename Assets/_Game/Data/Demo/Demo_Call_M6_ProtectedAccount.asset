      text: Hello, is this Kim Jiwoo? This is Manager Jeon from Nuri Bank's account
        protection team.
      facts: []
      deliver: []
      pauseAfter: 0.4
    - speaker: 0
      text: Twenty minutes ago someone logged into your account from an unregistered
        device in Busan.
      facts: []
      deliver: []
      pauseAfter: 0.4
    hasDecision: 1
    decision:
      kind: 0
      prompt: How do you answer?
      patienceSeconds: 60
      a:
        label: Busan? I've been home all day. What happened?
        playerLine: Busan? I've been home all day. What happened?
        next: story
