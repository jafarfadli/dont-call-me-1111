  tricks:
  - id: borrowed_name
    name: "\uBE4C\uB9B0 \uC774\uB984"
    how: "\uAC00\uC2A4 \uD68C\uC0AC, \uD0DD\uBC30\uC0AC, \uC2E0\uBB38\uC0AC, \uBCD1\uC6D0\uCC98\uB7FC
      \uC2E4\uC81C\uB85C \uAC70\uB798\uD558\uB294 \uACF3\uC758 \uC774\uB984\uC744
      \uB304\uB2E4."
    tell: "\uBC88\uD638\uB97C \uC870\uD68C\uD558\uACE0, \uACE0\uC9C0\uC11C\uC640
      \uC1A1\uC7A5, \uC5F0\uB77D\uCC98\uC5D0 \uC801\uD78C \uBC88\uD638\uC640 \uBE44\uAD50\uD558\uB77C."
  - id: bank_call
    name: "\uC740\uD589\uC758 \uC804\uD654"
    how: "'\uC740\uD589 \uBCF4\uC548\uD300'\uC774\uB77C\uBA70 \uB0B4 \uB3C8 \uBB38\uC81C\uB85C
      \uC804\uD654\uAC00 \uC628\uB2E4."
    tell: "\uC740\uD589\uC740 \uC790\uAE30 \uB300\uD45C\uBC88\uD638\uB85C \uC804\uD654\uD55C\uB2E4.
      \uB04A\uACE0 \uC5F0\uB77D\uCC98\uC5D0 \uC788\uB294 \uBC88\uD638\uB85C \uC9C1\uC811
      \uAC78\uC5B4\uB77C."
  - id: break_in
    name: "\uCE68\uC785 \uACBD\uBCF4"
    how: "\uB204\uAD70\uAC00 \uBA3C \uACF3\uC5D0\uC11C \uB0B4 \uACC4\uC88C\uC5D0
      \uB4E4\uC5B4\uC654\uC73C\uB2C8 \uC9C0\uAE08 \uB2F9\uC7A5 \uC6C0\uC9C1\uC5EC\uC57C
      \uD55C\uB2E4\uACE0 \uD55C\uB2E4."
    tell: "\uAC81\uC774 \uC218\uB2E8\uC774\uB2E4. \uC815\uB9D0 \uBB34\uC2A8 \uC77C\uC774
      \uC788\uC5C8\uB294\uC9C0\uB294 \uB0B4 \uC740\uD589 \uB0B4\uC5ED\uC774 \uBCF4\uC5EC
      \uC900\uB2E4."
  - id: safe_account
    name: "\uC548\uC804\uACC4\uC88C"
    how: "\uC608\uAE08\uC744 \uC9C0\uD0A4\uB824\uBA74 \uC7A0\uC2DC '\uBCF4\uD638\uACC4\uC88C'\uB85C
      \uC62E\uACA8\uC57C \uD55C\uB2E4\uACE0 \uD55C\uB2E4."
    tell: "\uADF8\uB7F0 \uACC4\uC88C\uB294 \uC5B4\uB290 \uC740\uD589\uC5D0\uB3C4,
      \uACBD\uCC30\uC5D0\uB3C4 \uC5C6\uB2E4. \uC9C0\uD0A4\uB824\uBA74 \uC62E\uAE30\uB77C\uB294
      \uB9D0\uC774 \uB098\uC624\uBA74 \uBA48\uCDB0\uB77C."
  - id: paid_bill
    name: "\uC774\uBBF8 \uB0B8 \uC694\uAE08"
    how: "\uC694\uAE08\uC774 '\uBBF8\uB0A9'\uC774\uB77C\uBA70 \uC9C0\uAE08 \uB0B4\uC9C0
      \uC54A\uC73C\uBA74 \uC624\uB298 \uB04A\uAE34\uB2E4\uACE0 \uD55C\uB2E4."
    tell: "\uB0C8\uB294\uC9C0 \uC548 \uB0C8\uB294\uC9C0\uB294 \uC740\uD589 \uB0B4\uC5ED\uACFC
      \uACE0\uC9C0\uC11C\uAC00 \uC548\uB2E4."
  - id: new_account
    name: "\uC0C8 \uACC4\uC88C"
    how: "\uC774\uBC88\uC5D0\uB294 \uB2E4\uB978 \uACC4\uC88C\uB85C \uBCF4\uB0B4\uB77C\uACE0
      \uD55C\uB2E4. \uAC1C\uC778 \uC774\uB984\uC774\uAC70\uB098 \uCC98\uC74C \uB4E3\uB294
      \uD68C\uC0AC\uB2E4."
    tell: "\uACC4\uC88C \uC8FC\uC778\uC744 \uC870\uD68C\uD558\uB77C. \uC9C4\uC9DC
      \uD68C\uC0AC\uB294 \uACC4\uC88C\uB97C \uBC14\uAFC0 \uB54C \uC804\uD654\uAC00
      \uC544\uB2C8\uB77C \uAE00\uB85C \uC54C\uB9B0\uB2E4."
  - id: stand_in
    name: "\uB300\uB9AC\uC778"
    how: "\uBBFF\uB294 \uC0AC\uB78C \uB300\uC2E0 \uC804\uD654\uD588\uB2E4\uACE0 \uD55C\uB2E4.
      \uC544\uB4E4, \uBE44\uC11C, \uC0C8 \uB2F4\uB2F9\uC790."
    tell: "\uB300\uB9AC\uC778\uC758 \uBC88\uD638\uB97C \uB0B4 \uC11C\uB958\uC640
      \uBE44\uAD50\uD558\uAC70\uB098, \uADF8 \uC0AC\uB78C\uC5D0\uAC8C \uC9C1\uC811
      \uBB3C\uC5B4\uB77C."
  - id: emergency
    name: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uC0AC\uACE0"
    how: "\uC785\uC6D0, \uACE0\uC7A5 \uB09C \uD3F0, \uC0AC\uACE0. \uC624\uB298 \uC544\uCE68
      \uC77C\uC774 \uC0DD\uACA8 \uC9C0\uAE08 \uB3C8\uC774 \uD544\uC694\uD558\uB2E4\uACE0
      \uD55C\uB2E4."
    tell: "\uADF8 \uC0AC\uB78C\uC774\uB098 \uAC00\uAE4C\uC6B4 \uC0AC\uB78C\uC774
      \uC624\uB298 \uB0A8\uAE34 \uB9D0\uC744 \uCC3E\uC544\uB77C. \uC0AC\uB78C\uB4E4\uC740
      \uAE00\uC744 \uC62C\uB9AC\uACE0 \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0B8\uB2E4."
  - id: borrowed_phone
    name: "\uBE4C\uB9B0 \uD3F0"
    how: "\uAC00\uC871\uC774 \uD3F0\uC774 \uACE0\uC7A5 \uB098\uC11C \uCE5C\uAD6C
      \uD3F0\uC73C\uB85C \uC804\uD654\uD55C\uB2E4\uACE0 \uD55C\uB2E4."
    tell: "\uBCF8\uC778 \uBC88\uD638\uB098 \uAC00\uC871 \uCC44\uD305\uBC29\uC5D0
      \uBB3C\uC5B4\uB77C. \uBCF8\uC778 \uD3F0\uC774 \uB2F5\uD558\uBA74 \uACE0\uC7A5
      \uB09C \uAC8C \uC544\uB2C8\uB2E4."
  - id: extra_zero
    name: "\uC798\uBABB \uBCF4\uB0B8 \uB3C8"
    how: "\uC2E4\uC218\uB85C \uB3C8\uC744 \uB354 \uBCF4\uB0C8\uC73C\uB2C8 \uCC28\uC561\uC744
      \uBC14\uB85C \uB3CC\uB824 \uB2EC\uB77C\uACE0 \uD55C\uB2E4."
    tell: "\uC0C1\uB300\uC758 \uCEA1\uCC98\uAC00 \uC544\uB2C8\uB77C \uB0B4 \uC740\uD589
      \uB0B4\uC5ED\uC744 \uBCF4\uB77C. \uC815\uB9D0 \uB4E4\uC5B4\uC628 \uB3C8\uB9CC
      \uB3CC\uB824\uC918\uB77C."
  - id: held_parcel
    name: "\uBCF4\uB958\uB41C \uD0DD\uBC30"
    how: "\uD0DD\uBC30\uAC00 \uC138\uAD00\uC5D0 \uBB36\uC5EC \uC788\uC5B4 \uC218\uC218\uB8CC\uB97C
      \uB0B4\uC57C \uD480\uB9B0\uB2E4\uACE0 \uD55C\uB2E4."
    tell: "\uB0BC \uB3C8\uC774 \uC788\uB294\uC9C0\uB294 \uD0DD\uBC30\uC0AC\uC640
      \uC1FC\uD551\uBAB0\uC774 \uC9C1\uC811 \uBCF4\uB0B8 \uBA54\uC2DC\uC9C0\uAC00
      \uB9D0\uD574 \uC900\uB2E4."
  - id: leaked_list
    name: "\uC720\uCD9C\uB41C \uBA85\uB2E8"
    how: "\uB0B4 \uC774\uB984, \uC8FC\uBB38, \uC608\uC57D\uAE4C\uC9C0 \uC54C\uACE0
      \uC788\uC73C\uB2C8 \uC9C4\uC9DC\uB77C\uACE0 \uBBFF\uAC8C \uB9CC\uB4E0\uB2E4."
    tell: "\uBA85\uB2E8\uC740 \uC720\uCD9C\uB41C\uB2E4. \uB0B4 \uC815\uBCF4\uB97C
      \uC548\uB2E4\uB294 \uAC74 \uC99D\uAC70\uAC00 \uC544\uB2C8\uB2E4. \uC0C1\uB300\uC758
      \uB9D0\uC744 \uB0B4 \uBA54\uBAA8\uC640 \uB9DE\uCDB0 \uBCF4\uB77C."
  - id: deposit
    name: "\uC791\uC740 \uC608\uC57D\uAE08"
    how: "\uC790\uB9AC\uB97C \uC7A1\uC544 \uB450\uB824\uBA74 \uC9C0\uAE08 \uC18C\uC561\uC744
      \uB0B4\uB77C\uACE0 \uD55C\uB2E4. \uC9C4\uB8CC \uC608\uC57D, \uC811\uC218, \uBC30\uC1A1."
    tell: "\uC7A1\uC544 \uB458 \uAC8C \uC788\uAE30\uB294 \uD55C\uAC00? \uBA3C\uC800
      \uB0B4 \uB2EC\uB825\uC744 \uBCF4\uACE0, \uC608\uC57D\uD55C \uACF3\uC5D0\uB9CC
      \uC9C1\uC811 \uB0B4\uB77C."
  - id: borrowed_face
    name: "\uBE4C\uB9B0 \uC5BC\uAD74"
    how: "\uACF5\uAC1C\uB41C \uC601\uC0C1 \uBA87 \uCD08\uBA74 \uC601\uC0C1\uD1B5\uD654
      \uC18D \uC0C1\uB300\uC5D0\uAC8C \uADF8 \uC0AC\uB78C\uC758 \uC5BC\uAD74\uC744
      \uC2E4\uC2DC\uAC04\uC73C\uB85C \uC50C\uC6B8 \uC218 \uC788\uB2E4."
    tell: "\uC785 \uBAA8\uC591\uC774 \uBAA9\uC18C\uB9AC\uC640 \uB9DE\uB294\uC9C0
      \uBCF4\uACE0, \uC5BC\uAD74 \uC55E\uC5D0\uC11C \uCC9C\uCC9C\uD788 \uC190\uC744
      \uD754\uB4E4\uC5B4 \uB2EC\uB77C\uACE0 \uD558\uB77C. \uC50C\uC6B4 \uC5BC\uAD74\uC740
      \uC190 \uC704\uC5D0 \uADF8\uB300\uB85C \uB5A0 \uC788\uB2E4."
  - id: stranded
    name: "\uD574\uC678\uC5D0\uC11C \uBC1C \uBB36\uC784"
    how: "\uCE5C\uAD6C\uAC00 \uD574\uC678\uC5D0\uC11C \uBC1C\uC774 \uBB36\uC600\uB2E4\uACE0
      \uD55C\uB2E4. \uAC00\uBC29\uC744 \uB3C4\uB451\uB9DE\uACE0 \uCE74\uB4DC\uB3C4
      \uC5C6\uC5B4 \uB9C8\uAC10 \uC804\uC5D0 \uD638\uD154\uBE44\uB098 \uD45C\uAC12\uC744
      \uB0B4\uC57C \uD55C\uB2E4\uACE0."
    tell: "\uC5EC\uD589 \uC911\uC774\uB77C\uB294 \uB9D0\uC740 \uBBFF\uAE30 \uC27D\uACE0
      \uD655\uC778\uD558\uAE30 \uC5B4\uB835\uB2E4. \uC624\uB298 \uBCF8\uC778 \uD3F0\uC73C\uB85C
      \uC62C\uB9B0 \uAE00\uC744 \uBCF4\uB77C."
